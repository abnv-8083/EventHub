<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Browse Events' }) %>

<body>

    <!-- Header -->
    <%- include('../partials/header', { activePage: 'events', positionClass: 'navbar-fixed' }) %>

    <main>
        <!-- Hero Section -->
        <section class="section"
            style="padding: 6rem 0 3rem; background: radial-gradient(circle at top right, rgba(230, 57, 70, 0.05) 0%, transparent 50%);">
            <div class="container animate">
                <div style="max-width: 600px;">
                    <h1 style="font-size: 3.5rem; letter-spacing: -2px;" class="mb-3">Discover <span
                            class="text-gradient">Experiences</span></h1>
                    <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6;" class="mb-0">Browse a
                        curated selection
                        of the finest events happening around the globe. Filter by interest, location, or date to find
                        your next unforgettable moment.</p>
                </div>
            </div>
        </section>

        <!-- Filters & Tools Bar -->
        <section
            style="position: sticky; top: 0; z-index: 100; background: rgba(10, 10, 10, 0.8); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border);">
            <form action="/events" method="GET" class="container" style="padding: 1.25rem 0;">
                <input type="hidden" name="sort" value="<%= currentSort %>">
                <div style="display: flex; gap: 2rem; align-items: center; flex-wrap: wrap; justify-content: center;">
                    <!-- Search Field (Medium) -->
                    <div style="width: 400px; position: relative;">
                        <i class="fa fa-search"
                            style="position: absolute; left: 1.25rem; top: 50%; transform: translateY(-50%); color: var(--text-dim); pointer-events: none;"></i>
                        <input type="text" name="search" class="input glass-dark" placeholder="Search events..." value="<%= currentSearch %>"
                            style="padding-left: 3.25rem; border-radius: 50px; border-color: rgba(255,255,255,0.05); font-size: 0.95rem;">
                    </div>

                    <div class="d-flex align-center gap-2">
                        <span
                            style="font-size: 0.85rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Category</span>
                        <div style="position: relative;">
                            <select name="category" class="input glass-dark" onchange="this.form.submit()"
                                style="width: auto; padding: 0.6rem 3rem 0.6rem 1.25rem; border-radius: 50px; border-color: rgba(255,255,255,0.05); appearance: none; font-size: 0.9rem; font-weight: 500; cursor: pointer;">
                                <option value="All Types">All Types</option>
                                <% categories.forEach(cat => { %>
                                    <option value="<%= cat.name %>" <%= currentCategory === cat.name ? 'selected' : '' %>><%= cat.name %></option>
                                <% }) %>
                            </select>
                            <i class="fa fa-chevron-down"
                                style="position: absolute; right: 1.25rem; top: 50%; transform: translateY(-50%); font-size: 0.75rem; color: var(--text-dim); pointer-events: none;"></i>
                        </div>
                    </div>

                    <div class="d-flex align-center gap-2">
                        <span
                            style="font-size: 0.85rem; color: var(--text-dim); font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Date</span>
                        <div style="position: relative;">
                            <select name="date" class="input glass-dark" onchange="this.form.submit()"
                                style="width: auto; padding: 0.6rem 3rem 0.6rem 1.25rem; border-radius: 50px; border-color: rgba(255,255,255,0.05); appearance: none; font-size: 0.9rem; font-weight: 500; cursor: pointer;">
                                <option value="">Anytime</option>
                                <option value="Today" <%= currentDate === 'Today' ? 'selected' : '' %>>Today</option>
                                <option value="This Weekend" <%= currentDate === 'This Weekend' ? 'selected' : '' %>>This Weekend</option>
                                <option value="Next 30 Days" <%= currentDate === 'Next 30 Days' ? 'selected' : '' %>>Next 30 Days</option>
                            </select>
                            <i class="fa fa-chevron-down"
                                style="position: absolute; right: 1.25rem; top: 50%; transform: translateY(-50%); font-size: 0.75rem; color: var(--text-dim); pointer-events: none;"></i>
                        </div>
                    </div>

                    <button type="button" class="btn btn-outline glow-primary" id="toggleFiltersBtn"
                        style="border-radius: 50px; padding: 0.65rem 1.5rem; font-size: 0.9rem; border-color: var(--border-red); color: var(--primary);">
                        <i class="fa fa-sliders-h" style="margin-right: 0.6rem;"></i> More Filters
                    </button>
                    
                    <% if (currentSearch || (currentCategory && currentCategory !== 'All Types') || currentDate || currentMinPrice || currentMaxPrice || currentCity || isFeaturedOnly) { %>
                        <a href="/events" class="btn btn-primary" style="border-radius: 50px; height: 40px; width: 40px; padding: 0; display: flex; align-items: center; justify-content: center;">
                            <i class="fa fa-times"></i>
                        </a>
                    <% } %>
                </div>
            </form>
        </section>

        <!-- Advanced Filters Container (Collapsible) -->
        <section id="advancedFiltersSection" class="<%= (currentMinPrice || currentMaxPrice || currentCity || isFeaturedOnly) ? '' : 'd-none' %>" 
                 style="background: rgba(10, 10, 10, 0.4); border-bottom: 1px solid var(--border); transition: all 0.3s ease;">
            <div class="container" style="padding: 2rem 0;">
                <form action="/events" method="GET">
                    <!-- Preserve Quick Filters -->
                    <input type="hidden" name="search" value="<%= currentSearch %>">
                    <input type="hidden" name="category" value="<%= currentCategory %>">
                    <input type="hidden" name="date" value="<%= currentDate %>">
                    <input type="hidden" name="sort" value="<%= currentSort %>">

                    <div style="display: flex; gap: 3rem; align-items: flex-end; flex-wrap: wrap;">
                        <!-- City Filter -->
                        <div style="flex: 1.5; min-width: 250px;">
                            <label class="label-heading mb-3 d-block" style="font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700;">Location</label>
                            <div style="position: relative; display: flex; align-items: center;">
                                <select name="city" class="input glass-dark" style="border-radius: 12px; padding: 0.75rem 3rem 0.75rem 1.25rem; appearance: none; cursor: pointer; border-color: rgba(255,255,255,0.1); width: 100%;">
                                    <option value="">All Cities</option>
                                    <% sortedCities.forEach(city => { %>
                                        <option value="<%= city.name %>" <%= currentCity === city.name ? 'selected' : '' %>><%= city.name %></option>
                                    <% }) %>
                                </select>
                                <i class="fa fa-map-marker-alt" style="position: absolute; right: 1.25rem; font-size: 0.9rem; color: var(--primary); pointer-events: none;"></i>
                            </div>
                        </div>

                        <!-- Price Range -->
                        <div style="flex: 2; min-width: 280px;">
                            <label class="label-heading mb-3 d-block" style="font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700;">Price Range (₹)</label>
                            <div style="display: flex; gap: 1rem; align-items: center;">
                                <input type="number" name="minPrice" placeholder="Min" class="input glass-dark" value="<%= currentMinPrice %>" 
                                    style="border-radius: 12px; padding: 0.75rem; border-color: rgba(255,255,255,0.1); flex: 1;">
                                <span style="color: var(--border); font-weight: bold; font-size: 1.2rem;">-</span>
                                <input type="number" name="maxPrice" placeholder="Max" class="input glass-dark" value="<%= currentMaxPrice %>" 
                                    style="border-radius: 12px; padding: 0.75rem; border-color: rgba(255,255,255,0.1); flex: 1;">
                            </div>
                        </div>

                        <!-- Specials Toggle -->
                        <div style="flex: 1; min-width: 200px;">
                           <label class="label-heading mb-3 d-block" style="font-size: 0.75rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1.5px; font-weight: 700;">Specials</label>
                            <div style="display: flex; align-items: center; gap: 1rem; height: 45px;">
                                <div class="form-check form-switch custom-switch" style="padding-left: 0; margin-bottom: 0; display: flex; align-items: center; gap: 0.75rem;">
                                    <input class="form-check-input" type="checkbox" name="featured" value="true" id="featuredToggle" <%= isFeaturedOnly ? 'checked' : '' %> 
                                           style="width: 3rem; height: 1.5rem; cursor: pointer; background-color: rgba(255,255,255,0.1); border-color: var(--border); margin-left: 0; float: none;">
                                    <label class="form-check-label" for="featuredToggle" style="color: var(--text-white); font-weight: 500; cursor: pointer; font-size: 0.9rem; white-space: nowrap;">Featured Only</label>
                                </div>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div style="display: flex; gap: 1rem; flex: 1; min-width: 180px;">
                            <button type="submit" class="btn btn-primary" style="flex: 3; border-radius: 12px; padding: 0.75rem; font-weight: 700; box-shadow: 0 4px 15px rgba(230, 57, 70, 0.2); text-transform: uppercase; letter-spacing: 1px; font-size: 0.85rem;">
                                Apply
                            </button>
                            <button type="button" onclick="window.location.href='/events'" class="btn btn-outline" style="flex: 1; border-radius: 12px; padding: 0.75rem; aspect-ratio: 1; display: flex; align-items: center; justify-content: center; border-color: rgba(255,255,255,0.1);">
                                <i class="fa fa-undo" style="font-size: 0.9rem;"></i>
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </section>

        <script>
            document.getElementById('toggleFiltersBtn').addEventListener('click', function() {
                const section = document.getElementById('advancedFiltersSection');
                section.classList.toggle('d-none');
            });
        </script>

        <!-- Listing Grid -->
        <section class="section">
            <div class="container">
                <!-- Sorting & View Options -->
                <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; flex-wrap: wrap; gap: 1.5rem;">
                    <div>
                        <div style="display: flex; gap: 0.5rem; align-items: center; margin-bottom: 0.75rem;">
                            <div style="width: 8px; height: 8px; border-radius: 50%; background: var(--primary);"></div>
                            <span style="font-size: 0.8rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 2px; font-weight: 700;">Live Feed</span>
                        </div>
                        <h2 style="font-size: 2.25rem; letter-spacing: -1px; font-weight: 800;">Explore <span class="text-gradient">Experiences</span></h2>
                    </div>

                    <div style="display: flex; gap: 1.25rem; align-items: center;">
                        <div style="display: flex; align-items: center; gap: 1rem; background: rgba(255,255,255,0.03); padding: 0.65rem 1.5rem; border-radius: 50px; border: 1px solid var(--border);">
                            <span style="font-size: 0.85rem; color: var(--text-dim); white-space: nowrap;"><i class="fa fa-sort-amount-down-alt" style="margin-right: 0.5rem; color: var(--primary);"></i> Sort by:</span>
                            <select onchange="window.location.href='/events?page=1&sort=' + this.value + '<%= currentSearch ? '&search=' + currentSearch : '' %><%= currentCategory ? '&category=' + currentCategory : '' %><%= currentDate ? '&date=' + currentDate : '' %><%= currentCity ? '&city=' + currentCity : '' %><%= isFeaturedOnly ? '&featured=true' : '' %><%= currentMinPrice ? '&minPrice=' + currentMinPrice : '' %><%= currentMaxPrice ? '&maxPrice=' + currentMaxPrice : '' %>'" 
                                    style="background: transparent; border: none; color: white; font-size: 0.9rem; font-weight: 600; cursor: pointer; outline: none; padding-right: 1.5rem;">
                                <option value="NEWEST" style="background: #111;" <%= currentSort === 'NEWEST' ? 'selected' : '' %>>Newest First</option>
                                <option value="POPULAR" style="background: #111;" <%= currentSort === 'POPULAR' ? 'selected' : '' %>>Most Popular</option>
                                <option value="PRICE_LOW" style="background: #111;" <%= currentSort === 'PRICE_LOW' ? 'selected' : '' %>>Price: Low to High</option>
                                <option value="PRICE_HIGH" style="background: #111;" <%= currentSort === 'PRICE_HIGH' ? 'selected' : '' %>>Price: High to Low</option>
                                <option value="ALPHABETICAL" style="background: #111;" <%= currentSort === 'ALPHABETICAL' ? 'selected' : '' %>>Alphabetical (A-Z)</option>
                                <option value="OLDEST" style="background: #111;" <%= currentSort === 'OLDEST' ? 'selected' : '' %>>Oldest First</option>
                            </select>
                        </div>
                        <div style="background: var(--primary-gradient); padding: 0.65rem 1.50rem; border-radius: 50px; font-size: 0.8rem; font-weight: 800; box-shadow: 0 4px 15px rgba(230, 57, 70, 0.2); letter-spacing: 1px;">
                            <%= total %> EVENTS
                        </div>
                    </div>
                </div>

                <!-- Active Filters Bar -->
                <% if (currentSearch || (currentCategory && currentCategory !== 'All Types') || currentDate || currentMinPrice || currentMaxPrice || currentCity || isFeaturedOnly) { %>
                    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 3.5rem; align-items: center; background: rgba(255,255,255,0.02); padding: 1.25rem; border-radius: 16px; border: 1px dashed var(--border);">
                        <span style="font-size: 0.8rem; color: var(--text-dim); margin-right: 0.5rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;">Applied:</span>
                        
                        <% if (currentSearch) { %>
                            <div style="background: rgba(255,255,255,0.05); padding: 0.4rem 1rem; border-radius: 50px; border: 1px solid var(--border); font-size: 0.75rem; color: white;">
                                Search: <span style="color: var(--primary); font-weight: 600;">"<%= currentSearch %>"</span>
                            </div>
                        <% } %>

                        <% if (currentCategory && currentCategory !== 'All Types') { %>
                            <div style="background: rgba(255,255,255,0.05); padding: 0.4rem 1rem; border-radius: 50px; border: 1px solid var(--border); font-size: 0.75rem; color: white;">
                                Category: <span style="color: var(--primary); font-weight: 600;"><%= currentCategory %></span>
                            </div>
                        <% } %>

                        <% if (currentDate) { %>
                            <div style="background: rgba(255,255,255,0.05); padding: 0.4rem 1rem; border-radius: 50px; border: 1px solid var(--border); font-size: 0.75rem; color: white;">
                                Date: <span style="color: var(--primary); font-weight: 600;"><%= currentDate %></span>
                            </div>
                        <% } %>

                        <% if (currentCity) { %>
                            <div style="background: rgba(255,255,255,0.05); padding: 0.4rem 1rem; border-radius: 50px; border: 1px solid var(--border); font-size: 0.75rem; color: white;">
                                City: <span style="color: var(--primary); font-weight: 600;"><%= currentCity %></span>
                            </div>
                        <% } %>

                        <% if (isFeaturedOnly) { %>
                            <div style="background: rgba(230, 57, 70, 0.1); padding: 0.4rem 1rem; border-radius: 50px; border: 1px solid var(--primary); font-size: 0.75rem; color: var(--primary); font-weight: 600;">
                                <i class="fa fa-star" style="margin-right: 0.25rem;"></i> Featured
                            </div>
                        <% } %>

                        <a href="/events" style="font-size: 0.8rem; color: var(--primary); font-weight: 700; text-decoration: none; margin-left: 1rem; border-bottom: 2px solid var(--primary);">Clear All Filters</a>
                    </div>
                <% } %>

                <!-- Event Listing Grid -->
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 2rem;">
                    <% if (events && events.length > 0) { %>
                        <% events.forEach((event, index) => { %>
                            <div class="card animate" style="animation-delay: <%= index * 0.1 %>s; border-radius: 20px; overflow: hidden; border: 1px solid var(--border); display: flex; flex-direction: column;">
                                <!-- Square Image Container -->
                                <div class="card-img" style="padding-top: 100%; position: relative; height: 0; background-image: url('<%= event.bannerImage ? (event.bannerImage.startsWith('http') ? event.bannerImage : '/' + event.bannerImage.replace(/\\/g, '/')) : 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&q=80&w=800' %>');">
                                </div>
                                <div class="card-content" style="padding: 1.5rem; flex: 1; display: flex; flex-direction: column;">
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
                                        <span style="color: var(--primary); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 1px;"><%= event.category %></span>
                                        <span style="font-weight: 800; font-size: 1.25rem; color: var(--primary);">₹<%= event.ticketing && event.ticketing.length > 0 ? Math.min(...event.ticketing.map(t => t.price)) : 0 %></span>
                                    </div>
                                    <h3 style="font-size: 1.25rem; margin-bottom: 1rem; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; color: white;"><%= event.title %></h3>
                                    <div class="card-meta" style="margin-bottom: 1.5rem; color: rgba(255,255,255,0.7); font-size: 0.82rem; margin-top: auto; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <i class="fa fa-calendar-alt" style="color: var(--primary);"></i>
                                            <span><%= event.startDate ? new Date(event.startDate).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) : 'Date TBD' %></span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <i class="fa fa-map-marker-alt" style="color: var(--primary);"></i>
                                            <span><%= (event.venueLocation && event.venueLocation.address) ? event.venueLocation.address.split(',')[0] : 'Venue TBD' %></span>
                                        </div>
                                    </div>
                                    <a href="/events/<%= event._id %>" class="btn btn-primary" style="width: 100%; border-radius: 10px; font-weight: 600;">Book Now</a>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="grid-column: 1 / -1; text-align: center; padding: 6rem 0;">
                            <i class="fa fa-calendar-times mb-3" style="font-size: 4rem; color: var(--text-dim);"></i>
                            <h3 style="color: var(--text-dim); font-size: 1.5rem;">No events found matching your criteria.</h3>
                            <p style="color: var(--text-dim); margin-top: 1rem;">Try adjusting your filters or search terms.</p>
                        </div>
                    <% } %>
                </div>

                <!-- Modern Pagination -->
                <% if (totalPages > 1) { %>
                    <div style="display: flex; justify-content: center; align-items: center; gap: 1rem; margin-top: 6rem;">
                        <% if (currentPage > 1) { %>
                            <a href="?page=<%= currentPage - 1 %>" class="btn btn-outline"
                                style="width: 45px; height: 45px; padding: 0; border-radius: 50%; border-color: var(--border); color: var(--text-dim); display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-chevron-left"></i>
                            </a>
                        <% } %>

                        <div style="display: flex; gap: 0.75rem;">
                            <% for(let i = 1; i <= totalPages; i++) { %>
                                <% if (i === currentPage) { %>
                                    <button class="btn btn-primary" style="width: 45px; height: 45px; padding: 0; border-radius: 50%;"><%= i %></button>
                                <% } else if (i <= 3 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) { %>
                                    <a href="?page=<%= i %>" class="btn btn-outline"
                                        style="width: 45px; height: 45px; padding: 0; display: flex; align-items: center; justify-content: center; border-radius: 50%; border-color: var(--border); color: var(--text-dim);">
                                        <%= i %>
                                    </a>
                                <% } else if (i === 4 || i === totalPages - 1) { %>
                                    <span style="color: var(--text-dim); padding: 0 0.5rem; display: flex; align-items: center;">...</span>
                                <% } %>
                            <% } %>
                        </div>

                        <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %>" class="btn btn-outline"
                                style="width: 45px; height: 45px; padding: 0; border-radius: 50%; border-color: var(--border); color: var(--text-dim); display: flex; align-items: center; justify-content: center;">
                                <i class="fa fa-chevron-right"></i>
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-grid">
                <div>
                    <a href="/" class="logo" style="margin-bottom: 1.5rem;">EVENT<span>HUB</span></a>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">The leading platform for managing and
                        discovering world-class events.</p>
                </div>
                <div>
                    <h4 style="margin-bottom: 1.5rem;">Quick Links</h4>
                    <ul style="color: var(--text-muted); display: grid; gap: 0.8rem;">
                        <li><a href="events">Browse Events</a></li>
                        <li><a href="about">Our Story</a></li>
                        <li><a href="contact">Contact Us</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="margin-bottom: 1.5rem;">Legal</h4>
                    <ul style="color: var(--text-muted); display: grid; gap: 0.8rem;">
                        <li><a href="../terms">Terms</a></li>
                        <li><a href="../privacy">Privacy</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="margin-bottom: 1.5rem;">Social</h4>
                    <div style="display: flex; gap: 1rem; font-size: 1.5rem;">
                        <a href="#" style="color: var(--text-dim);"><i class="fab fa-twitter"></i></a>
                        <a href="#" style="color: var(--text-dim);"><i class="fab fa-instagram"></i></a>
                        <a href="#" style="color: var(--text-dim);"><i class="fab fa-linkedin"></i></a>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 EventHub Inc. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <%- include('../partials/footer-scripts') %>
</body>

</html>