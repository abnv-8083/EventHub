<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Discover & Book Amazing Events' }) %>

<body>
    <!-- Header / Nav -->
    <%- include('../partials/header', { activePage: 'home' }) %>

    <!-- Hero Section -->
    <main>
        <section class="section hero"
            style="padding-top: 4rem; text-align: center; background: radial-gradient(circle at center, rgba(230, 57, 70, 0.1) 0%, transparent 70%);">
            <div class="container animate">
                <h1 style="font-size: 4rem;" class="mb-3">Unforgettable <span class="text-gradient">Experiences</span>
                    Await</h1>
                <p style="color: var(--text-muted); font-size: 1.2rem; max-width: 600px; margin-inline: auto;"
                    class="mb-5">Discover
                    the best concerts, conferences, and festivals in your city. Book tickets effortlessly and join the
                    community.</p>

                <!-- Search Bar -->
                <form id="heroSearchForm" action="/events" method="GET"
                      style="max-width: 780px; margin: 0 auto; background: var(--bg-surface);
                             padding: 0.45rem 0.45rem 0.45rem 1.5rem;
                             border-radius: 100px; border: 1px solid var(--border);
                             display: flex; gap: 0; align-items: center;
                             transition: border-color 0.3s, box-shadow 0.3s;"
                      id="heroForm">

                    <!-- Event keyword -->
                    <div style="flex: 2; display: flex; align-items: center; gap: 0.75rem; min-width: 0;">
                        <i class="fa fa-search" style="color: var(--text-dim); font-size: 0.9rem; flex-shrink: 0;"></i>
                        <input id="heroSearch" type="text" name="search"
                               placeholder="Search events, artists, venues…"
                               autocomplete="off"
                               style="background: transparent; border: none; outline: none;
                                      color: #fff; font-size: 0.95rem; width: 100%;
                                      padding: 0.55rem 0;">
                    </div>

                    <!-- Divider -->
                    <div style="width: 1px; height: 28px; background: var(--border); margin: 0 1rem; flex-shrink: 0;"></div>

                    <!-- City / Location -->
                    <div style="flex: 1; display: flex; align-items: center; gap: 0.6rem; min-width: 0;">
                        <i class="fa fa-map-marker-alt" style="color: var(--primary); font-size: 0.85rem; flex-shrink: 0;"></i>
                        <input id="heroCity" type="text" name="city"
                               placeholder="Location"
                               autocomplete="off"
                               style="background: transparent; border: none; outline: none;
                                      color: #fff; font-size: 0.9rem; width: 100%;
                                      padding: 0.55rem 0;">
                    </div>

                    <!-- Search button -->
                    <button type="submit" class="btn btn-primary"
                            style="border-radius: 100px; padding: 0.7rem 1.8rem;
                                   font-weight: 700; flex-shrink: 0; margin-left: 0.5rem;
                                   display: flex; align-items: center; gap: 0.5rem;">
                        <i class="fa fa-search"></i> Search
                    </button>
                </form>

                <script>
                    // Focus glow
                    const heroForm = document.getElementById('heroForm');
                    [document.getElementById('heroSearch'), document.getElementById('heroCity')].forEach(el => {
                        el.addEventListener('focus', () => {
                            heroForm.style.borderColor = 'rgba(230,57,70,0.5)';
                            heroForm.style.boxShadow  = '0 0 0 4px rgba(230,57,70,0.08)';
                        });
                        el.addEventListener('blur', () => {
                            heroForm.style.borderColor = '';
                            heroForm.style.boxShadow   = '';
                        });
                    });
                </script>
            </div>
        </section>

        <!-- Featured Events -->
        <section class="section">
            <div class="container">
                <div class="d-flex justify-between align-center mb-5">
                    <div>
                        <h2 style="font-size: 2rem;">Featured <span class="text-gradient">Events</span></h2>
                        <p style="color: var(--text-muted);">Handpicked experiences you don't want to miss.</p>
                    </div>
                    <a href="/events" style="color: var(--primary); font-weight: 600;">View All <i
                            class="fa fa-arrow-right"></i></a>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 2.5rem;">
                    <% if (events && events.length > 0) { %>
                        <% events.forEach((event, index) => { %>
                            <div class="card animate" style="animation-delay: <%= index * 0.2 %>s; border-radius: 24px; overflow: hidden; display: flex; flex-direction: column;">
                                <div class="card-img"
                                    style="padding-top: 100%; position: relative; height: 0; background-image: url('<%= event.bannerImage || 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&q=80&w=800' %>');">
                                    <span class="card-badge" style="border-radius: 8px;"><%= event.category || 'EVENT' %></span>
                                </div>
                                <div class="card-content" style="padding: 1.75rem; flex: 1; display: flex; flex-direction: column; background: rgba(255, 255, 255, 0.02);">
                                    <h3 class="card-title text-truncate" style="font-size: 1.4rem; margin-bottom: 0.75rem; color: white;"><%= event.title %></h3>
                                    <div class="card-meta" style="margin-bottom: 1.5rem; color: rgba(255,255,255,0.7); font-size: 0.82rem; margin-top: auto; display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <i class="fa fa-calendar-alt" style="color: var(--primary);"></i>
                                            <span><%= event.startDate ? new Date(event.startDate).toLocaleDateString('en-IN', { month: 'short', day: 'numeric' }) : 'Date TBD' %></span>
                                        </div>
                                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                                            <i class="fa fa-map-marker-alt" style="color: var(--primary);"></i>
                                            <span><%= (event.venueLocation && event.venueLocation.address) ? event.venueLocation.address.split(',')[0] : 'Location TBD' %></span>
                                        </div>
                                    </div>
                                    <div style="display: flex; justify-content: space-between; align-items: center; margin-top: auto;">
                                        <% let minPrice = event.ticketing && event.ticketing.length > 0 ? Math.min(...event.ticketing.map(t => t.price)) : 0; %>
                                        <span style="font-weight: 800; font-size: 1.4rem; color: var(--primary);">
                                            <%= minPrice === 0 ? 'FREE' : '₹' + minPrice.toFixed(0) %>
                                        </span>
                                        <a href="/events/<%= event._id %>" class="btn btn-primary"
                                            style="padding: 0.6rem 1.5rem; border-radius: 12px; font-weight: 700;">Book Now</a>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div style="grid-column: 1/-1; text-align: center; padding: 4rem; background: var(--bg-surface); border-radius: var(--radius-lg); border: 1px dashed var(--border);">
                            <i class="fa fa-calendar-times" style="font-size: 3rem; color: var(--text-dim); margin-bottom: 1rem;"></i>
                            <h3>No Events Found</h3>
                            <p style="color: var(--text-muted);">Check back later for exciting new experiences.</p>
                        </div>
                    <% } %>
                </div>
            </div>
        </section>

        <!-- Become Organizer CTA -->
        <section class="section" style="background: var(--bg-surface);">
            <div class="container"
                style="display: flex; align-items: center; justify-content: space-between; gap: 4rem;">
                <div style="flex: 1;">
                    <h2 style="font-size: 2.5rem;" class="mb-4">Make Your <span class="text-gradient">Event</span>
                        Happen</h2>
                    <p style="color: var(--text-muted); font-size: 1.1rem;" class="mb-5">Powerful tools for
                        creators to manage tickets, analyze sales, and grow their community. Join thousands of
                        successful organizers.</p>
                    <div class="d-flex gap-3">
                        <a href="/register-organizer" class="btn btn-primary">Start Organizing</a>
                        <a href="learn-more" class="btn btn-outline">Learn More</a>
                    </div>
                </div>
                <div
                    style="flex: 1; height: 400px; background: url('https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&q=80&w=800') center/cover; border-radius: var(--radius-lg);">
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-grid">
                <div>
                    <a href="/" class="logo" style="margin-bottom: 1.5rem;">EVENT<span>HUB</span></a>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">The leading platform for managing and
                        discovering world-class events. Redefining how we gather.</p>
                </div>
                <div>
                    <h4 style="margin-bottom: 1.5rem;">Quick Links</h4>
                    <ul style="color: var(--text-muted); display: grid; gap: 0.8rem;">
                        <li><a href="/events">Browse Events</a></li>
                        <li><a href="/about">Our Story</a></li>
                        <li><a href="/pricing">Pricing</a></li>
                        <li><a href="/contact">Contact Us</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="margin-bottom: 1.5rem;">Legal</h4>
                    <ul style="color: var(--text-muted); display: grid; gap: 0.8rem;">
                        <li><a href="terms">Terms of Service</a></li>
                        <li><a href="privacy">Privacy Policy</a></li>
                        <li><a href="refund">Refund Policy</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="margin-bottom: 1.5rem;">Newsletter</h4>
                    <div style="display: flex; gap: 0.5rem;">
                        <input type="email" class="input" placeholder="Your email" style="padding: 0.6rem;">
                        <button class="btn btn-primary" style="padding: 0 1rem;">Join</button>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 EventHub Inc. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <%- include('../partials/footer-scripts') %>
</body>

</html>
