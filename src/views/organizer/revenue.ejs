<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Organizer Revenue' }) %>

<body>

    <%- include('../partials/header') %>

    <div class="dashboard-layout">
                <%- include('../partials/sidebar-organizer') %>

        <main class="dashboard-main animate">
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem;">
                <div>
                    <h1 style="font-size: 1.8rem;">Revenue & <span class="text-gradient">Payouts</span></h1>
                    <p style="color: var(--text-muted);">Track your earnings and manage your bank details.</p>
                </div>
                <button class="btn btn-primary"><i class="fa fa-hand-holding-usd"></i> Request Payout</button>
            </div>

            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem; margin-bottom: 2.5rem;">
                <!-- Revenue Chart -->
                <div class="card" style="padding: 2rem;">
                    <h3 style="margin-bottom: 2rem; font-size: 1.1rem;">Monthly Earnings</h3>
                    <div
                        style="height: 250px; background: rgba(255,255,255,0.02); border: 1px dashed var(--border); border-radius: 8px; display: flex; align-items: center; justify-content: center;">
                        <span style="color: var(--text-dim);">[Performance Chart]</span>
                    </div>
                </div>

                <!-- Balance Summary -->
                <div class="card"
                    style="padding: 2rem; background: linear-gradient(135deg, var(--bg-card) 0%, rgba(230, 57, 70, 0.05) 100%);">
                    <h3 style="margin-bottom: 1.5rem; font-size: 1.1rem;">Current Balance</h3>
                    <div style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem;" class="text-gradient">
                        $4,280.50</div>
                    <div style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 2.5rem;">Available for
                        immediate payout</div>

                    <div class="form-group">
                        <label class="label">Payout Method</label>
                        <div
                            style="display: flex; align-items: center; gap: 1rem; background: var(--bg-surface); padding: 1rem; border-radius: 8px; border: 1px solid var(--border);">
                            <i class="fa fa-university" style="color: var(--primary);"></i>
                            <div>
                                <div style="font-size: 0.9rem; font-weight: 600;">Chase Bank ....4928</div>
                                <div style="font-size: 0.75rem; color: var(--text-muted);">Verified</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <h3 style="margin-bottom: 1.5rem; font-size: 1.2rem;">Payout History</h3>
            <div class="card" style="padding: 0; overflow: hidden;">
                <table style="width: 100%; border-collapse: collapse; text-align: left;">
                    <thead>
                        <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border);">
                            <th style="padding: 1.5rem;">Date</th>
                            <th style="padding: 1.5rem;">Reference ID</th>
                            <th style="padding: 1.5rem;">Amount</th>
                            <th style="padding: 1.5rem;">Status</th>
                        </tr>
                    </thead>
                    <tbody style="color: var(--text-muted); font-size: 0.9rem;">
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 1.5rem;">Oct 01, 2026</td>
                            <td style="padding: 1.5rem;">#PAY-008124</td>
                            <td style="padding: 1.5rem; font-weight: 600; color: white;">$2,450.00</td>
                            <td style="padding: 1.5rem;"><span style="color: #2ECC71;">Completed</span></td>
                        </tr>
                        <tr>
                            <td style="padding: 1.5rem;">Sep 01, 2026</td>
                            <td style="padding: 1.5rem;">#PAY-007952</td>
                            <td style="padding: 1.5rem; font-weight: 600; color: white;">$3,120.00</td>
                            <td style="padding: 1.5rem;"><span style="color: #2ECC71;">Completed</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </main>
    </div>

</body>

</html>



