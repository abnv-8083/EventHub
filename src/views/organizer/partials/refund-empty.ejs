<div class="card glass" style="padding: 4rem 2rem; text-align: center; border-radius: 20px; border: 1px solid var(--border);">
    <div style="width: 72px; height: 72px; background: rgba(255,255,255,0.03); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
        <i class="fa <%= icon %>" style="font-size: 2rem; color: var(--text-dim); opacity: 0.5;"></i>
    </div>
    <p style="color: var(--text-dim); font-size: 0.95rem;"><%= message %></p>
</div>
