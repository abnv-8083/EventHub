<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Payments | ' + event.title }) %>

<style>
    .stat-pill {
        display: flex;
        flex-direction: column;
        gap: 0.4rem;
        padding: 1.5rem 2rem;
        background: rgba(255,255,255,0.03);
        border: 1px solid var(--border);
        border-radius: 16px;
        flex: 1;
        min-width: 0;
    }
    .stat-pill .label-sm {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 1.2px;
        color: var(--text-dim);
        font-weight: 600;
    }
    .stat-pill .value-lg {
        font-size: 1.8rem;
        font-weight: 800;
        line-height: 1;
        color: #fff;
    }
    .stat-pill .sub {
        font-size: 0.78rem;
        color: var(--text-muted);
    }

    .payout-card {
        background: linear-gradient(135deg, #0d2b1a 0%, #0a1f13 100%);
        border: 1px solid rgba(46, 204, 113, 0.3);
        border-radius: 20px;
        padding: 2rem;
        position: relative;
        overflow: hidden;
    }
    .payout-card::before {
        content: '';
        position: absolute;
        top: -60px; right: -60px;
        width: 200px; height: 200px;
        background: radial-gradient(circle, rgba(46,204,113,0.15) 0%, transparent 70%);
        pointer-events: none;
    }

    .ticket-row:hover {
        background: rgba(255,255,255,0.02);
    }

    /* Modal overlay */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.75);
        backdrop-filter: blur(6px);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }
    .modal-overlay.open { display: flex; opacity: 1; }
    .modal-box {
        background: #111;
        border: 1px solid var(--border);
        border-radius: 20px;
        padding: 2.5rem;
        width: 100%;
        max-width: 520px;
        animation: slideUp 0.25s ease;
    }
    @keyframes slideUp {
        from { opacity: 0; transform: translateY(24px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>

<body>

    <%- include('../partials/header') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar-organizer') %>

        <main class="dashboard-main animate">

            <!-- ── Top navigation ── -->
            <div style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
                <a href="/organizer/event/<%= event._id %>/view"
                    style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">
                    <i class="fa fa-arrow-left" style="margin-right: 0.5rem;"></i> Back to Event
                </a>
                <span style="font-size: 0.8rem; background: rgba(46,204,113,0.1); border: 1px solid rgba(46,204,113,0.3); color: #2ecc71; padding: 0.3rem 0.9rem; border-radius: 999px;">
                    <i class="fa fa-shield-alt" style="margin-right: 0.35rem;"></i> Admin Approved
                </span>
            </div>

            <!-- ── Page header ── -->
            <div style="margin-bottom: 2.5rem;">
                <h1 style="font-size: 1.9rem; margin-bottom: 0.3rem;">
                    Event <span class="text-gradient">Payments</span>
                </h1>
                <p style="color: var(--text-muted); font-size: 0.93rem;">
                    Financial overview for <strong style="color: var(--text-primary);"><%= event.title %></strong>
                </p>
            </div>

            <%
                const grossRevenue  = event.totalRevenue || 0;
                const platformFee   = Math.round(grossRevenue * 0.05);
                const netPayout     = grossRevenue - platformFee;
                const totalSold     = event.ticketing.reduce((s,t) => s + (t.bookedSeats||0), 0);
                const totalSeats    = event.ticketing.reduce((s,t) => s + (t.availableSeats||0), 0);
                const occupancy     = totalSeats > 0 ? Math.round((totalSold/totalSeats)*100) : 0;
            %>

            <!-- ── Stat pills ── -->
            <div style="display: flex; gap: 1.25rem; margin-bottom: 2.5rem; flex-wrap: wrap;">
                <div class="stat-pill">
                    <span class="label-sm">Gross Revenue</span>
                    <span class="value-lg">₹<%= grossRevenue.toLocaleString('en-IN') %></span>
                    <span class="sub">Total ticket sales</span>
                </div>
                <div class="stat-pill">
                    <span class="label-sm">Platform Fee</span>
                    <span class="value-lg" style="color: #e74c3c;">₹<%= platformFee.toLocaleString('en-IN') %></span>
                    <span class="sub">5% of gross revenue</span>
                </div>
                <div class="stat-pill" style="border-color: rgba(46,204,113,0.3); background: rgba(46,204,113,0.04);">
                    <span class="label-sm" style="color: #2ecc71;">Net Payout</span>
                    <span class="value-lg" style="color: #2ecc71;">₹<%= netPayout.toLocaleString('en-IN') %></span>
                    <span class="sub">Ready to request</span>
                </div>
                <div class="stat-pill">
                    <span class="label-sm">Tickets Sold</span>
                    <span class="value-lg" style="color: var(--primary);"><%= totalSold %></span>
                    <span class="sub"><%= occupancy %>% occupancy</span>
                </div>
            </div>

            <!-- ── Main grid ── -->
            <div style="display: grid; grid-template-columns: 1fr 380px; gap: 2rem; align-items: start;">

                <!-- LEFT: Ticket sales table -->
                <div>
                    <div class="card" style="padding: 0; overflow: hidden;">
                        <div style="padding: 1.75rem 2rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                            <h3 style="font-size: 1.05rem; font-weight: 700;">
                                <i class="fa fa-ticket-alt text-gradient" style="margin-right: 0.6rem;"></i>Ticket Sales
                            </h3>
                            <span style="font-size: 0.8rem; color: var(--text-dim);"><%= event.ticketing.length %> tier<%= event.ticketing.length !== 1 ? 's' : '' %></span>
                        </div>
                        <table style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="background: rgba(255,255,255,0.02);">
                                    <th style="padding: 1rem 2rem; font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Tier</th>
                                    <th style="padding: 1rem; font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; text-align: center;">Price</th>
                                    <th style="padding: 1rem; font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; text-align: center;">Sold / Total</th>
                                    <th style="padding: 1rem; font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; text-align: center;">Fill Rate</th>
                                    <th style="padding: 1rem 2rem; font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; text-align: right;">Revenue</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% event.ticketing.forEach(ticket => { %>
                                    <% const sub = (ticket.price||0) * (ticket.bookedSeats||0); %>
                                    <% const fill = ticket.availableSeats > 0 ? Math.round(((ticket.bookedSeats||0)/ticket.availableSeats)*100) : 0; %>
                                    <tr class="ticket-row" style="border-top: 1px solid rgba(255,255,255,0.04); transition: background 0.15s;">
                                        <td style="padding: 1.25rem 2rem; font-weight: 600; color: #fff;"><%= ticket.name %></td>
                                        <td style="padding: 1.25rem; text-align: center; color: var(--text-muted);">₹<%= (ticket.price||0).toLocaleString('en-IN') %></td>
                                        <td style="padding: 1.25rem; text-align: center;">
                                            <span style="color: var(--primary); font-weight: 700;"><%= ticket.bookedSeats||0 %></span>
                                            <span style="color: var(--text-dim);"> / <%= ticket.availableSeats||0 %></span>
                                        </td>
                                        <td style="padding: 1.25rem; text-align: center;">
                                            <div style="display: flex; flex-direction: column; align-items: center; gap: 0.4rem;">
                                                <span style="font-size: 0.82rem; color: #fff;"><%= fill %>%</span>
                                                <div style="width: 80px; height: 4px; background: rgba(255,255,255,0.06); border-radius: 2px; overflow: hidden;">
                                                    <div style="width: <%= fill %>%; height: 100%; background: var(--primary); border-radius: 2px;"></div>
                                                </div>
                                            </div>
                                        </td>
                                        <td style="padding: 1.25rem 2rem; text-align: right; font-weight: 700; color: #fff;">₹<%= sub.toLocaleString('en-IN') %></td>
                                    </tr>
                                <% }) %>
                                <!-- Total row -->
                                <tr style="background: rgba(255,255,255,0.02); border-top: 2px solid var(--border);">
                                    <td colspan="4" style="padding: 1.2rem 2rem; font-weight: 700; color: var(--text-muted);">Total Gross Revenue</td>
                                    <td style="padding: 1.2rem 2rem; text-align: right; font-weight: 800; font-size: 1.05rem; color: #fff;">₹<%= grossRevenue.toLocaleString('en-IN') %></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                
<!-- ── Recent Transactions ── -->
            <div class="card" style="margin-top: 2rem; padding: 0; overflow: hidden;">
                <div style="padding: 1.75rem 2rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                    <h3 style="font-size: 1.05rem; font-weight: 700;">
                        <i class="fa fa-receipt text-gradient" style="margin-right: 0.6rem;"></i>Recent Transactions
                    </h3>
                    <span style="font-size: 0.8rem; color: var(--text-dim);"><%= transactions.length %> transaction<%= transactions.length !== 1 ? 's' : '' %></span>
                </div>
                
                <% if (transactions && transactions.length > 0) { %>
                    <div style="overflow-x: auto;">
                        <table style="width: 100%; border-collapse: collapse; text-align: left;">
                            <thead>
                                <tr style="background: rgba(255,255,255,0.02);">
                                    <th style="padding: 1rem 2rem; font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Date</th>
                                    <th style="padding: 1rem; font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 600;">Customer</th>
                                    <th style="padding: 1rem; font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; text-align: center;">Tickets</th>
                                    <th style="padding: 1rem; font-size: 0.72rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; font-weight: 600; text-align: right;">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% transactions.forEach(tx => { %>
                                    <tr style="border-top: 1px solid rgba(255,255,255,0.04); transition: background 0.15s;">
                                        <td style="padding: 1.25rem 2rem; color: var(--text-muted); font-size: 0.85rem;">
                                            <%= new Date(tx.createdAt).toLocaleDateString('en-IN', {day:'numeric',month:'short',year:'numeric', hour:'2-digit', minute:'2-digit'}) %>
                                        </td>
                                        <td style="padding: 1.25rem;">
                                            <div style="font-weight: 600; color: #fff; font-size: 0.9rem;"><%= tx.userId?.name || 'Unknown' %></div>
                                            <div style="font-size: 0.75rem; color: var(--text-dim);"><%= tx.userId?.email || '' %></div>
                                        </td>
                                        <td style="padding: 1.25rem; text-align: center;">
                                            <div style="display: flex; flex-direction: column; gap: 0.2rem; align-items: center;">
                                                <% tx.tickets.forEach(t => { %>
                                                    <span style="font-size: 0.8rem; background: rgba(255,255,255,0.05); padding: 0.2rem 0.5rem; border-radius: 4px; color: var(--text-muted);"><%= t.quantity %>x <%= t.ticketName %></span>
                                                <% }) %>
                                            </div>
                                        </td>
                                        <td style="padding: 1.25rem 2rem; text-align: right; font-weight: 700; color: #2ecc71;">
                                            +₹<%= tx.subtotal.toLocaleString('en-IN') %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div style="padding: 3rem; text-align: center; color: var(--text-dim); font-size: 0.9rem; font-style: italic;">
                        No transactions found for this event yet.
                    </div>
                <% } %>
            </div>
                </div>

                <!-- RIGHT: Payout card -->
                <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                    <!-- Payout card -->
                    <div class="payout-card">
                        <div style="display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.75rem;">
                            <div style="width: 38px; height: 38px; border-radius: 10px; background: rgba(46,204,113,0.15); display: flex; align-items: center; justify-content: center; color: #2ecc71; font-size: 1rem;">
                                <i class="fa fa-hand-holding-usd"></i>
                            </div>
                            <div>
                                <div style="font-weight: 700; font-size: 1rem; color: #fff;">Request Payout</div>
                                <div style="font-size: 0.75rem; color: rgba(46,204,113,0.7);">Funds available</div>
                            </div>
                        </div>

                        <!-- Amounts -->
                        <div style="display: flex; flex-direction: column; gap: 0.85rem; margin-bottom: 2rem;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-size: 0.83rem; color: rgba(255,255,255,0.5);">Total Net Earnings</span>
                                <span style="font-size: 0.9rem; color: #fff; font-weight: 600;">₹<%= netPayout.toLocaleString('en-IN') %></span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-size: 0.83rem; color: rgba(255,255,255,0.5);">Payouts Requested</span>
                                <span style="font-size: 0.9rem; color: #e74c3c; font-weight: 600;">− ₹<%= totalPayoutDone.toLocaleString('en-IN') %></span>
                            </div>
                            <div style="height: 1px; background: rgba(46,204,113,0.15);"></div>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-size: 0.95rem; font-weight: 700; color: #2ecc71;">Available to Payout</span>
                                <span style="font-size: 1.6rem; font-weight: 900; color: #2ecc71;">₹<%= availablePayout.toLocaleString('en-IN') %></span>
                            </div>
                        </div>

                        <!-- CTA -->
                        <button id="openPayoutModal"
                            <% if (availablePayout <= 0) { %> disabled <% } %>
                            style="width: 100%; padding: 0.9rem; background: <%= availablePayout > 0 ? 'linear-gradient(135deg, #27ae60, #2ecc71)' : 'rgba(255,255,255,0.1)' %>; color: <%= availablePayout > 0 ? '#fff' : 'rgba(255,255,255,0.3)' %>; border: none; border-radius: 12px; font-size: 0.95rem; font-weight: 700; cursor: <%= availablePayout > 0 ? 'pointer' : 'not-allowed' %>; letter-spacing: 0.4px; display: flex; align-items: center; justify-content: center; gap: 0.6rem; transition: opacity 0.2s;"
                            <% if (availablePayout > 0) { %>onmouseover="this.style.opacity='0.88'" onmouseout="this.style.opacity='1'"<% } %>>
                            <i class="fa fa-paper-plane"></i> Request Payout
                        </button>

                        <p style="font-size: 0.73rem; color: rgba(255,255,255,0.3); text-align: center; margin-top: 1rem; line-height: 1.6;">
                            Processed within 3–5 business days after verification.
                        </p>
                    </div>

                    <!-- Occupancy card -->
                    <div class="card" style="padding: 1.75rem;">
                        <div style="font-size: 0.72rem; text-transform: uppercase; letter-spacing: 1px; color: var(--text-dim); margin-bottom: 1.25rem; font-weight: 600;">Seat Occupancy</div>
                        <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 0.75rem;">
                            <div>
                                <span style="font-size: 2rem; font-weight: 800; color: var(--primary);"><%= totalSold %></span>
                                <span style="font-size: 0.85rem; color: var(--text-dim);"> / <%= totalSeats %> seats</span>
                            </div>
                            <span style="font-size: 1.1rem; font-weight: 700; color: #fff;"><%= occupancy %>%</span>
                        </div>
                        <div style="height: 8px; background: rgba(255,255,255,0.05); border-radius: 4px; overflow: hidden;">
                            <div style="width: <%= occupancy %>%; height: 100%; background: linear-gradient(90deg, var(--primary), #ff6b8a); border-radius: 4px; transition: width 0.6s ease;"></div>
                        </div>
                    </div>

                </div>

            </div>

            <!-- ── Payout History ── -->
            <% if (payoutHistory && payoutHistory.length > 0) { %>
                <div style="margin-bottom: 2rem;">
                    <h3 style="font-size: 1.05rem; font-weight: 700; margin-bottom: 1rem;">
                        <i class="fa fa-history text-gradient" style="margin-right: 0.5rem;"></i>Payout History
                    </h3>
                    <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                        <% payoutHistory.forEach(request => { %>
                            <% const c = { Pending:{bg:'rgba(243,156,18,.1)',border:'rgba(243,156,18,.3)',text:'#F39C12',icon:'fa-clock'}, Approved:{bg:'rgba(46,204,113,.1)',border:'rgba(46,204,113,.3)',text:'#2ecc71',icon:'fa-check-circle'}, Rejected:{bg:'rgba(231,76,60,.1)',border:'rgba(231,76,60,.3)',text:'#e74c3c',icon:'fa-times-circle'} }[request.status]; %>
                            <div style="padding:1.25rem 1.5rem; background:<%= c.bg %>; border:1px solid <%= c.border %>; border-radius:12px; display:flex; gap:1rem; align-items:center;">
                                <i class="fa <%= c.icon %>" style="color:<%= c.text %>; font-size:1.4rem;"></i>
                                <div style="flex: 1;">
                                    <div style="display: flex; justify-content: space-between; align-items: center;">
                                        <div style="font-weight:700; color:<%= c.text %>;">Payout Request — <%= request.status %></div>
                                        <div style="font-size: 0.95rem; font-weight: 800; color: #fff;">₹<%= request.netAmount.toLocaleString('en-IN') %></div>
                                    </div>
                                    <div style="font-size:0.82rem; color:var(--text-muted); margin-top:0.3rem;">
                                        Requested on <%= new Date(request.createdAt).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %>
                                        <% if (request.status==='Approved' && request.utr) { %> • UTR: <strong style="color:#fff"><%= request.utr %></strong><% } %>
                                        <% if (request.status==='Rejected') { %> • <strong style="color:#e74c3c"><%= request.rejectionReason %></strong><% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>
            <% } %>

            
            </main>
    </div>

    <!-- ── Payout Request Modal ── -->
    <div class="modal-overlay" id="payoutModal">
        <div class="modal-box">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem;">
                <div>
                    <h2 style="font-size: 1.25rem; font-weight: 800; margin-bottom: 0.2rem;">Payout Details</h2>
                    <p style="font-size: 0.82rem; color: var(--text-muted);">Enter your bank info to receive <strong style="color: #2ecc71;">₹<%= availablePayout.toLocaleString('en-IN') %></strong></p>
                </div>
                <button id="closePayoutModal"
                    style="background: rgba(255,255,255,0.06); border: none; color: var(--text-muted); width: 34px; height: 34px; border-radius: 8px; cursor: pointer; font-size: 1rem;">
                    <i class="fa fa-times"></i>
                </button>
            </div>

            <form id="payoutForm" class="needs-validation ajax-form" action="/organizer/event/<%= event._id %>/payment/payout" method="POST" novalidate style="display: flex; flex-direction: column; gap: 1.1rem;">
                <input type="hidden" name="branchName" id="hiddenBranchName">
                <input type="hidden" name="branchCity" id="hiddenBranchCity">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="label">Account Holder</label>
                        <input type="text" name="accountHolder" id="accountHolder" class="input" placeholder="Full name" required minlength="3" />
                    </div>
                    <div class="form-group">
                        <label class="label">Bank Name</label>
                        <select name="bankName" id="bankName" class="input" required>
                            <option value="" disabled selected>Select your bank</option>
                            <option>Axis Bank</option>
                            <option>Bank of Baroda</option>
                            <option>Bank of India</option>
                            <option>Canara Bank</option>
                            <option>Central Bank of India</option>
                            <option>Federal Bank</option>
                            <option>HDFC Bank</option>
                            <option>ICICI Bank</option>
                            <option>IDBI Bank</option>
                            <option>Indian Bank</option>
                            <option>Indian Overseas Bank</option>
                            <option>IndusInd Bank</option>
                            <option>Kotak Mahindra Bank</option>
                            <option>Punjab National Bank</option>
                            <option>State Bank of India</option>
                            <option>UCO Bank</option>
                            <option>Union Bank of India</option>
                            <option>Yes Bank</option>
                        </select>
                    </div>
                </div>
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label class="label">Account Number</label>
                        <input type="text" name="accountNumber" id="accountNumber" class="input" placeholder="Account number" required pattern="^\d{9,18}$" title="9-18 digits required" />
                    </div>
                    <div class="form-group">
                        <label class="label">IFSC Code</label>
                        <div style="position: relative;">
                            <input type="text" name="ifscCode" id="ifscCode" class="input" placeholder="e.g. HDFC0001234"
                                maxlength="11" style="text-transform: uppercase; padding-right: 2.5rem;" required pattern="^[A-Z]{4}0[A-Z0-9]{6}$" title="Invalid IFSC format" />
                            <span id="ifscSpinner" style="display:none; position:absolute; right:0.8rem; top:50%; transform:translateY(-50%); color:var(--text-dim); font-size:0.85rem;">
                                <i class="fa fa-spinner fa-spin"></i>
                            </span>
                        </div>
                        <div id="branchInfo" style="display:none; margin-top:0.5rem; padding:0.6rem 0.85rem; background:rgba(46,204,113,0.06); border:1px solid rgba(46,204,113,0.2); border-radius:8px; font-size:0.78rem;">
                            <i class="fa fa-map-marker-alt" style="color:#2ecc71; margin-right:0.4rem;"></i>
                            <span id="branchText" style="color:#fff; font-weight:600;"></span>
                        </div>
                        <div id="ifscError" style="display:none; margin-top:0.4rem; font-size:0.78rem; color:#e74c3c;">
                            Invalid IFSC code.
                        </div>
                    </div>
                </div>
                <div class="form-group">
                    <label class="label">Notes</label>
                    <textarea name="notes" id="payoutNotes" class="input" rows="2" placeholder="Any special instructions..." style="resize: none;"></textarea>
                </div>

                <button type="submit" id="submitPayoutBtn"
                    style="padding: 0.85rem; background: linear-gradient(135deg, #27ae60, #2ecc71); color: #fff; border: none; border-radius: 12px; font-size: 0.95rem; font-weight: 700; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 0.5rem; margin-top: 0.25rem;">
                    <i class="fa fa-check-circle"></i> Confirm Payout Request
                </button>
            </form>
        </div>
    </div>

    <%- include('../partials/footer-scripts') %>

    <script>
        // ── IFSC Auto-fetch (free public API) ──────────────────────────────
        document.getElementById('ifscCode').addEventListener('input', async function () {
            const ifsc    = this.value.toUpperCase().trim();
            const info    = document.getElementById('branchInfo');
            const errDiv  = document.getElementById('ifscError');
            const spinner = document.getElementById('ifscSpinner');
            info.style.display   = 'none';
            errDiv.style.display = 'none';
            if (ifsc.length !== 11) return;
            spinner.style.display = 'block';
            try {
                const res  = await fetch(`https://ifsc.razorpay.com/${ifsc}`);
                if (!res.ok) throw new Error();
                const data = await res.json();
                document.getElementById('branchText').textContent =
                    `${data.BRANCH}, ${data.CITY}, ${data.STATE}`;
                info.style.display = 'block';
                
                // Update hidden fields
                document.getElementById('hiddenBranchName').value = data.BRANCH;
                document.getElementById('hiddenBranchCity').value = data.CITY;

                // Auto-select matching bank
                const sel = document.getElementById('bankName');
                for (let o of sel.options) {
                    if (data.BANK.toLowerCase().includes(o.value.toLowerCase())) {
                        sel.value = o.value; break;
                    }
                }
            } catch { errDiv.style.display = 'block'; }
            finally  { spinner.style.display = 'none'; }
        });
        // ──────────────────────────────────────────────────────────────────
        const modal    = document.getElementById('payoutModal');
        const openBtn  = document.getElementById('openPayoutModal');
        const closeBtn = document.getElementById('closePayoutModal');

        openBtn.addEventListener('click',  () => modal.classList.add('open'));
        closeBtn.addEventListener('click', () => modal.classList.remove('open'));
        modal.addEventListener('click', e => { if (e.target === modal) modal.classList.remove('open'); });

        // AJAX Handler will take over from here because of .needs-validation and .ajax-form classes
        document.getElementById('payoutForm').addEventListener('ajax:success', (e) => {
            modal.classList.remove('open');
        });
    </script>

</body>
</html>
