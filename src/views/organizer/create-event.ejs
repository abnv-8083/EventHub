<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Create Event' }) %>

    <body>

        <%- include('../partials/header') %>

            <div class="dashboard-layout">
                <%- include('../partials/sidebar-organizer') %>

                    <main class="dashboard-main animate">
                        <h1 style="font-size: 1.8rem; margin-bottom: 2.5rem;">Launch a New <span
                                class="text-gradient">Experience</span></h1>

                        <form action="create-event" method="post">
                            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2.5rem;">

                                <!-- Form Main Body -->
                                <div style="display: grid; gap: 2rem;">
                                    <div class="card" style="padding: 2.5rem;">
                                        <h3
                                            style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
                                            Basic Information</h3>
                                        <div class="form-group">
                                            <label class="label">Event Title</label>
                                            <input type="text" class="input" placeholder="e.g. Summer Jazz Night">
                                        </div>
                                        <div class="form-group">
                                            <label class="label">Event Description</label>
                                            <textarea class="input" rows="6"
                                                placeholder="Describe your event to atttract attendees..."></textarea>
                                        </div>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                                            <div class="form-group">
                                                <label class="label">Category</label>
                                                <select class="input">
                                                    <option>Music</option>
                                                    <option>Technology</option>
                                                    <option>Art</option>
                                                    <option>Business</option>
                                                </select>
                                            </div>
                                            <div class="form-group">
                                                <label class="label" style="color: #f0f0f0;">Venue Location</label>
                                                <input type="text" id="locationInput" class="input"
                                                    placeholder="Click 'Select Venue' to choose location..." readonly style="color: #000000;">
                                                <input type="hidden" name="latitude" id="latitude">
                                                <input type="hidden" name="longitude" id="longitude">
                                                <input type="hidden" name="address" id="address">
                                                <button type="button" id="selectVenueBtn" class="btn btn-primary"
                                                    style="margin-top: 0.5rem; width: 100%;">
                                                    <i class="fa fa-map-marker-alt"></i> Select Venue
                                                </button>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Modal for Map -->
                                    <div id="venueModal"
                                        style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 9999; align-items: center; justify-content: center;">
                                        <div
                                            style="background: white; border-radius: var(--radius-md); width: 90%; max-width: 800px; height: 80vh; display: flex; flex-direction: column;">
                                            <!-- Modal Header -->
                                            <div
                                                style="padding: 1.5rem; border-bottom: 1px solid var(--border); display: flex; justify-content: space-between; align-items: center;">
                                                <h3 style="margin: 0;">Select Venue Location</h3>
                                                <button type="button" id="closeModalBtn"
                                                    style="background: none; border: none; font-size: 1.5rem; cursor: pointer;">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            </div>

                                            <!-- Map Container -->
                                            <div id="modalMapContainer" style="flex: 1; overflow: hidden;">
                                            </div>

                                            <!-- Modal Footer -->
                                            <div
                                                style="padding: 1.5rem; border-top: 1px solid var(--border); display: flex; gap: 1rem; justify-content: flex-end;">
                                                <button type="button" id="cancelVenueBtn"
                                                    class="btn btn-outline">Cancel</button>
                                                <button type="button" id="confirmVenueBtn"
                                                    class="btn btn-primary">Confirm Location</button>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card" style="padding: 2.5rem;">
                                        <h3
                                            style="margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
                                            Date & Time</h3>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                                            <div class="form-group">
                                                <label class="label">Start Date</label>
                                                <input type="date" class="input">
                                            </div>
                                            <div class="form-group">
                                                <label class="label">Start Time</label>
                                                <input type="time" class="input">
                                            </div>
                                        </div>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                                            <div class="form-group">
                                                <label class="label">End Date</label>
                                                <input type="date" class="input">
                                            </div>
                                            <div class="form-group">
                                                <label class="label">End Time</label>
                                                <input type="time" class="input">
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card" style="padding: 2.5rem;">
                                        <div
                                            style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
                                            <h3 style="margin-bottom: 0;">Ticketing</h3>
                                            <button type="button" class="btn btn-primary"
                                                style="padding: 0.5rem; width: 32px; height: 32px; border-radius: 50%;"
                                                title="Add Ticket Type">
                                                <i class="fa fa-plus" style="font-size: 0.8rem;"></i>
                                            </button>
                                        </div>
                                        <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 1.5rem;">
                                            <div class="form-group">
                                                <label class="label">Ticket Price ($)</label>
                                                <input type="number" class="input" placeholder="0.00">
                                            </div>
                                            <div class="form-group">
                                                <label class="label">Available Seats</label>
                                                <input type="number" class="input" placeholder="100">
                                            </div>
                                            <div class="form-group">
                                                <label class="label">Max per User</label>
                                                <input type="number" class="input" value="5">
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Media & Settings Sidebar -->
                                <div style="display: grid; gap: 2rem; align-content: flex-start;">
                                    <div class="card" style="padding: 2rem;">
                                        <h4 style="margin-bottom: 1.5rem;">Event Banner</h4>
                                        <div
                                            style="height: 180px; background: var(--bg-surface); border: 2px dashed var(--border); border-radius: var(--radius-md); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; cursor: pointer; transition: var(--transition);">
                                            <i class="fa fa-cloud-upload-alt"
                                                style="font-size: 2rem; color: var(--primary);"></i>
                                            <span style="font-size: 0.85rem; color: var(--text-muted);">Upload Image
                                                (1200x600)</span>
                                        </div>
                                        <p style="font-size: 0.75rem; color: var(--text-dim); margin-top: 1rem;">
                                            JPG,
                                            PNG up to 5MB
                                        </p>
                                    </div>

                                    <div class="card" style="padding: 2rem;">
                                        <h4 style="margin-bottom: 1.5rem;">Tags</h4>
                                        <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
                                            <input type="text" id="tagInput" class="input" placeholder="e.g. trending, outdoor..." style="flex: 1;">
                                            <button type="button" id="addTagBtn" class="btn btn-primary" style="padding: 0.5rem 1rem;">
                                                <i class="fa fa-plus"></i>
                                            </button>
                                        </div>
                                        <div id="tagsContainer" style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
                                        </div>
                                        <input type="hidden" name="tags" id="tagsInput">
                                    </div>

                                    <div class="card" style="padding: 2rem;">
                                        <h4 style="margin-bottom: 1.5rem;">Visibility</h4>
                                        <div style="display: flex; flex-direction: column; gap: 1rem;">
                                            <label
                                                style="display: flex; align-items: center; gap: 1rem; cursor: pointer; color: #000000;">
                                                <input type="radio" name="visibility" checked
                                                    style="accent-color: var(--primary); width: 18px; height: 18px;">
                                                <span style="font-size: 0.9rem;">Public</span>
                                            </label>
                                            <label
                                                style="display: flex; align-items: center; gap: 1rem; cursor: pointer; color: #000000;">
                                                <input type="radio" name="visibility"
                                                    style="accent-color: var(--primary); width: 18px; height: 18px;">
                                                <span style="font-size: 0.9rem;">Private (Link only)</span>
                                            </label>
                                        </div>
                                    </div>

                                    <div style="display: grid; gap: 1rem; margin-top: 2rem;">
                                        <button type="submit" class="btn btn-primary" style="padding: 1rem;"><i
                                                class="fa fa-paper-plane"></i> Submit for Approval</button>
                                        <button type="button" class="btn btn-outline" style="padding: 1rem;">Save
                                            Draft</button>
                                    </div>
                                </div>

                            </div>
                        </form>
                    </main>
            </div>

            <!-- Leaflet CSS -->
            <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

            <!-- Leaflet Geocoding CSS -->
            <link rel="stylesheet" href="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.css" />

            <!-- Leaflet JS -->
            <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

            <!-- Leaflet Geocoding (for search) -->
            <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

            <script src="https://unpkg.com/leaflet-control-geocoder/dist/Control.Geocoder.js"></script>

            <script>
                let map;
                let marker;
                let selectedLocation = null;
                const defaultLocation = [40.7128, -74.0060]; // [lat, lng]

                // Open Modal
                document.getElementById('selectVenueBtn').addEventListener('click', function () {
                    document.getElementById('venueModal').style.display = 'flex';

                    // Initialize map when modal opens
                    if (!map) {
                        initMap(selectedLocation || defaultLocation);
                    }
                });

                // Close Modal
                function closeModal() {
                    document.getElementById('venueModal').style.display = 'none';
                }

                document.getElementById('closeModalBtn').addEventListener('click', closeModal);
                document.getElementById('cancelVenueBtn').addEventListener('click', closeModal);

                // Confirm Location
                document.getElementById('confirmVenueBtn').addEventListener('click', function () {
                    if (selectedLocation) {
                        // Use address if available, otherwise use coordinates
                        const displayAddress = selectedLocation.address || `Location (${selectedLocation.lat.toFixed(4)}, ${selectedLocation.lng.toFixed(4)})`;
                        
                        document.getElementById('locationInput').value = displayAddress;
                        document.getElementById('latitude').value = selectedLocation.lat;
                        document.getElementById('longitude').value = selectedLocation.lng;
                        document.getElementById('address').value = displayAddress;
                        console.log('Location Set:', selectedLocation);
                        closeModal();
                    } else {
                        alert('Please click on the map to select a location');
                    }
                });

                function initMap(userLocation) {
                    const location = userLocation ? [userLocation.lat || userLocation[0], userLocation.lng || userLocation[1]] : defaultLocation;

                    // Create map
                    map = L.map('modalMapContainer').setView(location, 12);

                    // Add OpenStreetMap tiles
                    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                        maxZoom: 19,
                        attribution: '© OpenStreetMap contributors'
                    }).addTo(map);

                    // Add marker
                    marker = L.marker(location, { draggable: true }).addTo(map);

                    // Add search control
                    L.Control.geocoder().addTo(map);

                    // Reverse geocode function with better error handling
                    function reverseGeocode(lat, lng) {
                        const url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`;

                        fetch(url)
                            .then(response => {
                                if (!response.ok) throw new Error('Network response was not ok');
                                return response.json();
                            })
                            .then(data => {
                                console.log('Geocoding Response:', data);
                                selectedLocation = {
                                    lat: lat,
                                    lng: lng,
                                    address: data.address?.name || data.name || data.display_name || `${lat.toFixed(4)}, ${lng.toFixed(4)}`
                                };
                                console.log('Updated selectedLocation:', selectedLocation);
                            })
                            .catch(error => {
                                console.error('Geocoding Error:', error);
                                selectedLocation = {
                                    lat: lat,
                                    lng: lng,
                                    address: `Location (${lat.toFixed(4)}, ${lng.toFixed(4)})`
                                };
                            });
                    }

                    // Reverse geocode initial location immediately
                    reverseGeocode(location[0], location[1]);

                    // Handle marker drag
                    marker.on('dragend', function () {
                        const pos = marker.getLatLng();
                        console.log('Marker dragged to:', pos.lat, pos.lng);
                        reverseGeocode(pos.lat, pos.lng);
                    });

                    // Handle map click
                    map.on('click', function (e) {
                        marker.setLatLng(e.latlng);
                        console.log('Map clicked at:', e.latlng.lat, e.latlng.lng);
                        reverseGeocode(e.latlng.lat, e.latlng.lng);
                    });
                }

                // Get user location on page load
                function getUserLocation() {
                    if (navigator.geolocation) {
                        navigator.geolocation.getCurrentPosition(
                            (position) => {
                                selectedLocation = {
                                    lat: position.coords.latitude,
                                    lng: position.coords.longitude,
                                    address: ''
                                };
                                console.log('User location:', selectedLocation);
                            },
                            (error) => {
                                console.log('Geolocation error:', error);
                                selectedLocation = {
                                    lat: defaultLocation[0],
                                    lng: defaultLocation[1],
                                    address: ''
                                };
                            }
                        );
                    }
                }

                document.addEventListener('DOMContentLoaded', getUserLocation);

                // Tags functionality
                let tagsArray = [];
                const addTagBtn = document.getElementById('addTagBtn');
                const tagInput = document.getElementById('tagInput');
                const tagsContainer = document.getElementById('tagsContainer');
                const tagsInputHidden = document.getElementById('tagsInput');

                function addTag() {
                    const tagValue = tagInput.value.trim();
                    
                    if (!tagValue) {
                        alert('Please enter a tag');
                        return;
                    }

                    if (tagsArray.includes(tagValue.toLowerCase())) {
                        alert('This tag already exists');
                        return;
                    }

                    tagsArray.push(tagValue.toLowerCase());
                    tagInput.value = '';
                    renderTags();
                }

                function removeTag(tag) {
                    tagsArray = tagsArray.filter(t => t !== tag);
                    renderTags();
                }

                function renderTags() {
                    tagsContainer.innerHTML = '';
                    tagsArray.forEach(tag => {
                        const tagElement = document.createElement('span');
                        tagElement.style.cssText = 'display: flex; align-items: center; gap: 0.5rem; background: var(--primary); color: white; padding: 0.5rem 1rem; border-radius: 20px; font-size: 0.85rem;';
                        tagElement.innerHTML = `
                            ${tag}
                            <button type="button" style="background: none; border: none; color: white; cursor: pointer; font-size: 1rem; padding: 0;" onclick="this.parentElement.remove()">
                                <i class="fa fa-times"></i>
                            </button>
                        `;
                        tagElement.querySelector('button').addEventListener('click', (e) => {
                            e.preventDefault();
                            removeTag(tag);
                        });
                        tagsContainer.appendChild(tagElement);
                    });
                    tagsInputHidden.value = JSON.stringify(tagsArray);
                }

                addTagBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    addTag();
                });

                tagInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter') {
                        e.preventDefault();
                        addTag();
                    }
                });
            
            </script>
            <%- include('../partials/footer-scripts') %>
    </body>

</html>