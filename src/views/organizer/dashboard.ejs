<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Organizer Portal | ' + organizer.organizationName }) %>

<body>

    <!-- Unified User Navbar -->
    <%- include('../partials/header') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar-organizer') %>

        <main class="dashboard-main animate">
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem;">
                <div>
                    <h1 style="font-size: 1.8rem;">Welcome back, <span class="text-gradient"><%= user.name %></span></h1>
                    <p style="color: var(--text-muted);">Managing: <%= organizer.organizationName %> (ID: <%= organizer.registrationNumber %>)</p>
                </div>
                <!-- <div style="display: flex; gap: 1rem;">
                    <a href="create-event" class="btn btn-primary" style="padding: 0.8rem 1.5rem;">
                        <i class="fa fa-plus"></i> Create Event
                    </a>
                </div> -->
            </div>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-bottom: 3rem;">
                <!-- Quick Stats -->
                <div class="card" style="padding: 1.5rem; display: flex; align-items: center; gap: 1.5rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border);">
                    <div style="width: 50px; height: 50px; border-radius: 12px; background: rgba(230, 57, 70, 0.1); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="fa fa-calendar-check"></i>
                    </div>
                    <div>
                        <h4 style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.25rem;">Live Events</h4>
                        <div style="font-size: 1.5rem; font-weight: 600;"><%= stats.liveEvents %></div>
                    </div>
                </div>
                
                <div class="card" style="padding: 1.5rem; display: flex; align-items: center; gap: 1.5rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border);">
                    <div style="width: 50px; height: 50px; border-radius: 12px; background: rgba(46, 204, 113, 0.1); color: #2ECC71; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="fa fa-ticket-alt"></i>
                    </div>
                    <div>
                        <h4 style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.25rem;">Tickets Sold</h4>
                        <div style="font-size: 1.5rem; font-weight: 600;"><%= stats.ticketsSold %></div>
                    </div>
                </div>
                
                <div class="card" style="padding: 1.5rem; display: flex; align-items: center; gap: 1.5rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border);">
                    <div style="width: 50px; height: 50px; border-radius: 12px; background: rgba(52, 152, 219, 0.1); color: #3498DB; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="fa fa-indian-rupee-sign"></i>
                    </div>
                    <div>
                        <h4 style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.25rem;">Total Revenue</h4>
                        <div style="font-size: 1.5rem; font-weight: 600;">₹<%= stats.totalRevenue.toLocaleString('en-IN') %></div>
                    </div>
                </div>
            </div>

            <!-- Dashboard Content -->
            <div class="card" style="padding: 2.5rem; background: rgba(255, 255, 255, 0.02); border: 1px solid var(--border);">
                <% if (stats.totalEvents === 0) { %>
                    <div style="text-align: center; padding: 2rem;">
                        <div style="width: 65px; height: 65px; border-radius: 50%; background: var(--bg-surface); display: flex; align-items: center; justify-content: center; color: var(--text-dim); font-size: 1.8rem; margin: 0 auto 1.5rem;">
                            <i class="fa fa-rocket"></i>
                        </div>
                        <h3 style="font-size: 1.3rem; font-weight: 600; margin-bottom: 0.75rem;">Ready to Launch?</h3>
                        <p style="color: var(--text-muted); max-width: 500px; margin: 0 auto 1.8rem;">
                            Start your journey as an organizer by creating your first event. Once live, you'll see ticket sales and engagement metrics right here.
                        </p>
                        <a href="/organizer/event/create" class="btn btn-primary" style="padding: 0.8rem 2.5rem;">Create Your First Event</a>
                    </div>
                <% } else { %>
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem;">
                        <h3 style="font-size: 1.1rem; margin: 0;">Quick Insights</h3>
                        <a href="/organizer/event" style="color: var(--primary); font-size: 0.9rem; font-weight: 500;">Manage Events <i class="fa fa-arrow-right" style="font-size: 0.75rem; margin-left: 0.4rem;"></i></a>
                    </div>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;">
                        <div style="background: rgba(255,255,255,0.02); padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--border);">
                            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">Total Events Created</p>
                            <div style="font-size: 2rem; font-weight: 700; color: var(--primary);"><%= stats.totalEvents %></div>
                        </div>
                        <div style="background: rgba(255,255,255,0.02); padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--border);">
                            <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 1rem;">Success Rate</p>
                            <div style="font-size: 2rem; font-weight: 700; color: #3498DB;">
                                <%= stats.totalEvents > 0 ? Math.round((stats.liveEvents / stats.totalEvents) * 100) : 0 %>%
                            </div>
                        </div>
                    </div>
                <% } %>
            </div>

        </main>
    </div>

    <%- include('../partials/footer-scripts') %>
</body>
</html>
