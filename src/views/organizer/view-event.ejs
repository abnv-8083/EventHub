<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Event Details | ' + event.title }) %>

    <body>

        <%- include('../partials/header') %>

            <div class="dashboard-layout">
                <%- include('../partials/sidebar-organizer') %>

                    <main class="dashboard-main animate">
                        <!-- Navigation & Header -->
                        <div
                            style="margin-bottom: 2rem; display: flex; justify-content: space-between; align-items: center;">
                            <a href="/organizer/event"
                                style="color: var(--text-muted); text-decoration: none; font-size: 0.9rem;">
                                <i class="fa fa-arrow-left" style="margin-right: 0.5rem;"></i> Back to Manage Events
                            </a>
                            <div style="display: flex; gap: 0.75rem;">
                                <a href="/organizer/event/<%= event._id %>/edit" class="btn btn-outline"
                                    style="padding: 0.6rem 1.2rem; font-size: 0.9rem;">
                                    <i class="fa fa-edit" style="margin-right: 0.4rem;"></i> Edit Event
                                </a>
                                <% if(['Approved', 'Published'].includes(event.status)) { %>
                                    <a href="/organizer/event/<%= event._id %>/payment" class="btn btn-primary"
                                        style="padding: 0.6rem 1.2rem; font-size: 0.9rem; background: linear-gradient(135deg, #27ae60, #2ecc71); border: none; display: flex; align-items: center; gap: 0.4rem;">
                                        <i class="fa fa-wallet"></i> Payments
                                    </a>
                                <% } %>
                                <% if(event.status==='Published') { %>
                                    <button class="btn btn-primary"
                                        style="padding: 0.6rem 1.2rem; font-size: 0.9rem; background: #e74c3c;">
                                        <i class="fa fa-ban" style="margin-right: 0.4rem;"></i> Cancel Event
                                    </button>
                                <% } %>
                            </div>
                        </div>

                        <!-- Hero Section -->
                        <div class="card"
                            style="padding: 0; overflow: hidden; margin-bottom: 2.5rem; position: relative;">
                            <div style="height: 300px; width: 100%; position: relative;">
                                <% let bannerSrc="/img/placeholder-event.jpg" ; if (event.bannerImage) {
                                    bannerSrc=event.bannerImage.startsWith('http') ? event.bannerImage : "/" +
                                    event.bannerImage.replace(/\\/g, '/' ); } %>
                                    <img src="<%= bannerSrc %>" alt="<%= event.title %>"
                                        style="width: 100%; height: 100%; object-fit: cover;">
                                    <div
                                        style="position: absolute; bottom: 0; left: 0; right: 0; background: linear-gradient(transparent, rgba(0,0,0,0.85)); padding: 2.5rem; display: flex; justify-content: space-between; align-items: flex-end;">
                                        <div>
                                            <div
                                                style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.75rem;">
                                                <% const statusColors={ Pending: { bg: '#F39C12' , dot: '#fff' },
                                                    Approved: { bg: '#2ECC71' , dot: '#fff' }, Published:{ bg: '#3498DB'
                                                    , dot: '#fff' }, Rejected: { bg: '#E74C3C' , dot: '#fff' },
                                                    Cancelled:{ bg: '#95A5A6' , dot: '#fff' }, Draft: { bg: '#9B59B6' ,
                                                    dot: '#fff' } }; const sc=statusColors[event.status] || {
                                                    bg: '#95A5A6' , dot: '#fff' }; %>
                                                    <span
                                                        style="padding: 0.35rem 1rem; border-radius: 999px; font-size: 0.75rem; font-weight: 700; background: <%= sc.bg %>; color: white; text-transform: uppercase; letter-spacing: 1px;">
                                                        <%= event.status %>
                                                    </span>
                                                    <span style="color: rgba(255,255,255,0.8); font-size: 0.9rem;"><i
                                                            class="fa fa-tag" style="margin-right: 0.5rem;"></i>
                                                        <%= event.category %>
                                                    </span>
                                            </div>
                                            <h1
                                                style="color: white; font-size: 2.2rem; margin: 0; text-shadow: 0 2px 10px rgba(0,0,0,0.3);">
                                                <%= event.title %>
                                            </h1>
                                        </div>
                                        <div style="text-align: right; color: white;">
                                            <div style="font-size: 1.1rem; font-weight: 600;"><i
                                                    class="fa fa-calendar-alt" style="margin-right: 0.6rem;"></i>
                                                <%= new Date(event.startDate).toLocaleDateString('en-IN', {
                                                    weekday: 'long' , day: 'numeric' , month: 'long' , year: 'numeric'
                                                    }) %>
                                            </div>
                                            <div style="font-size: 1rem; opacity: 0.8; margin-top: 0.3rem;">
                                                <%= event.startTime %> - <%= event.endTime %>
                                            </div>
                                        </div>
                                    </div>
                            </div>
                        </div>

                        <!-- Stats & Info Grid -->
                        <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2.5rem;">

                            <!-- Main Intel -->
                            <div>
                                <div class="card" style="padding: 2.5rem; margin-bottom: 2rem;">
                                    <h3
                                        style="margin-bottom: 1.5rem; font-size: 1.2rem; display: flex; align-items: center; gap: 0.75rem;">
                                        <i class="fa fa-align-left text-gradient"></i> Description
                                    </h3>
                                    <div
                                        style="line-height: 1.8; color: var(--text-muted); font-size: 1rem; white-space: pre-line;">
                                        <%= event.description %>
                                    </div>

                                    <% if(event.tags && event.tags.length> 0) { %>
                                        <div
                                            style="margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
                                            <h4
                                                style="margin-bottom: 1rem; font-size: 0.9rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px;">
                                                Tags</h4>
                                            <div style="display: flex; gap: 0.6rem; flex-wrap: wrap;">
                                                <% event.tags.forEach(tag=> { %>
                                                    <span
                                                        style="padding: 0.4rem 1rem; background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 999px; font-size: 0.8rem; color: var(--text-muted);">#
                                                        <%= tag %></span>
                                                    <% }) %>
                                            </div>
                                        </div>
                                        <% } %>
                                </div>

                                <div class="card" style="padding: 2.5rem;">
                                    <h3
                                        style="margin-bottom: 1.5rem; font-size: 1.2rem; display: flex; align-items: center; gap: 0.75rem;">
                                        <i class="fa fa-ticket-alt text-gradient"></i> Ticketing Performance
                                    </h3>
                                    <table style="width: 100%; border-collapse: collapse;">
                                        <thead>
                                            <tr style="text-align: left; border-bottom: 1px solid var(--border);">
                                                <th style="padding: 1rem 0; font-size: 0.8rem; color: var(--text-dim);">
                                                    TYPE</th>
                                                <th
                                                    style="padding: 1rem; font-size: 0.8rem; color: var(--text-dim); text-align: center;">
                                                    PRICE</th>
                                                <th
                                                    style="padding: 1rem; font-size: 0.8rem; color: var(--text-dim); text-align: center;">
                                                    SOLD</th>
                                                <th
                                                    style="padding: 1rem; font-size: 0.8rem; color: var(--text-dim); text-align: center;">
                                                    AVAILABILITY</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% event.ticketing.forEach(ticket=> { %>
                                                <tr style="border-bottom: 1px solid rgba(255,255,255,0.02);">
                                                    <td style="padding: 1.2rem 0; font-weight: 600; color: #fff;">
                                                        <%= ticket.name %>
                                                    </td>
                                                    <td
                                                        style="padding: 1.2rem; text-align: center; color: var(--text-muted);">
                                                        ₹<%= ticket.price %>
                                                    </td>
                                                    <td
                                                        style="padding: 1.2rem; text-align: center; color: var(--primary); font-weight: 600;">
                                                        <%= ticket.bookedSeats %>
                                                    </td>
                                                    <td
                                                        style="padding: 1.2rem; text-align: center; color: var(--text-muted);">
                                                        <div
                                                            style="font-size: 0.85rem; margin-bottom: 0.4rem; color: #fff;">
                                                            <%= Math.round(((ticket.availableSeats - ticket.bookedSeats)
                                                                / ticket.availableSeats) * 100) %>% Left
                                                        </div>
                                                        <div
                                                            style="width: 80px; height: 4px; background: rgba(255,255,255,0.05); border-radius: 2px; margin: 0 auto; overflow: hidden;">
                                                            <div
                                                                style="width: <%= (ticket.bookedSeats / ticket.availableSeats) * 100 %>%; height: 100%; background: var(--primary);">
                                                            </div>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- Sidebar Intel -->
                            <div>
                                <div class="card"
                                    style="padding: 2rem; margin-bottom: 2rem; background: linear-gradient(135deg, rgba(255,255,255,0.05), rgba(255,255,255,0.01)); border: 1px solid var(--border);">
                                    <h4
                                        style="margin-bottom: 1.5rem; font-size: 0.9rem; color: var(--text-dim); text-transform: uppercase;">
                                        Total Revenue</h4>
                                    <div
                                        style="font-size: 2.5rem; font-weight: 700; color: var(--primary); margin-bottom: 0.5rem;">
                                        ₹<%= (event.totalRevenue || 0).toLocaleString('en-IN') %>
                                    </div>
                                    <p style="color: var(--text-muted); font-size: 0.85rem;">Earned from ticket sales
                                    </p>
                                </div>

                                <div class="card" style="padding: 2rem; margin-bottom: 2rem;">
                                    <h4
                                        style="margin-bottom: 1.5rem; font-size: 0.9rem; color: var(--text-dim); text-transform: uppercase;">
                                        Venue & Location</h4>
                                    <div
                                        style="display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 1.5rem;">
                                        <div
                                            style="width: 40px; height: 40px; border-radius: 50%; background: rgba(255,255,255,0.03); display: flex; align-items: center; justify-content: center; font-size: 1.1rem; color: var(--primary);">
                                            <i class="fa fa-map-marker-alt"></i>
                                        </div>
                                        <div>
                                            <div
                                                style="font-weight: 600; color: var(--text-primary); margin-bottom: 0.25rem;">
                                                Address</div>
                                            <div style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5;">
                                                <%= event.venueLocation?.address || 'N/A' %>
                                            </div>
                                        </div>
                                    </div>

                                    <% if(event.venueLocation?.latitude && event.venueLocation?.longitude) { %>
                                        <div id="eventViewMap"
                                            style="height: 180px; width: 100%; border-radius: 12px; overflow: hidden; border: 1px solid var(--border);">
                                        </div>
                                        <div
                                            style="display: flex; justify-content: space-between; margin-top: 1rem; font-size: 0.75rem; color: var(--text-dim);">
                                            <span>Lat: <%= event.venueLocation.latitude.toFixed(4) %></span>
                                            <span>Lng: <%= event.venueLocation.longitude.toFixed(4) %></span>
                                        </div>
                                        <% } %>
                                </div>

                                <div class="card" style="padding: 2rem;">
                                    <h4
                                        style="margin-bottom: 1.5rem; font-size: 0.9rem; color: var(--text-dim); text-transform: uppercase;">
                                        Visibility Settings</h4>
                                    <div style="display: flex; align-items: center; gap: 1rem;">
                                        <% if(event.visibility==='Public' ) { %>
                                            <i class="fa fa-globe" style="color: #2ECC71;"></i>
                                            <div>
                                                <div style="font-weight: 600; font-size: 0.9rem; color: #fff;">Public
                                                    Event</div>
                                                <div style="font-size: 0.75rem; color: var(--text-muted);">Visible to
                                                    everyone on the platform</div>
                                            </div>
                                            <% } else { %>
                                                <i class="fa fa-lock" style="color: #F1C40F;"></i>
                                                <div>
                                                    <div style="font-weight: 600; font-size: 0.9rem;">Private Event
                                                    </div>
                                                    <div style="font-size: 0.75rem; color: var(--text-muted);">Only
                                                        accessible via invite link</div>
                                                </div>
                                                <% } %>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </main>
            </div>

            <%- include('../partials/footer-scripts') %>

                <% if(event.venueLocation?.latitude && event.venueLocation?.longitude) { %>
                    <!-- Leaflet JS -->
                    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            const lat = <%= event.venueLocation.latitude %>;
                            const lng = <%= event.venueLocation.longitude %>;
                            const address = "<%= event.venueLocation.address %>";

                            const map = L.map('eventViewMap').setView([lat, lng], 15);

                            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                            }).addTo(map);

                            L.marker([lat, lng]).addTo(map)
                                .bindPopup(`<b><%= event.title %></b><br>${address}`)
                                .openPopup();
                        });
                    </script>
                    <% } %>
    </body>

</html>