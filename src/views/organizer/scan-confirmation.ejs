<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Entry Confirmation  Scanner' }) %>

<body style="background: var(--bg-dark);">

    <%- include('../partials/header') %>

    <main class="section">
        <div class="container" style="max-width: 500px;">

            <div style="text-align: center; margin-bottom: 2.5rem;">
                <div
                    style="width: 80px; height: 80px; background: rgba(46, 204, 113, 0.1); border-radius: 50%; border: 3px solid #2ECC71; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; color: #2ECC71; font-size: 2rem;">
                    <i class="fa fa-check"></i>
                </div>
                <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Ticket <span
                        style="color: #2ECC71;">Verified</span></h1>
                <p style="color: var(--text-muted); font-size: 0.9rem;">Booking ID: <span
                        style="color: var(--primary); font-weight: 600;">#EH-992841</span></p>
            </div>

            <div class="card shadow-lg" style="padding: 0; overflow: hidden; border-radius: var(--radius-lg);">
                <div style="background: var(--bg-surface); padding: 1.5rem; border-bottom: 1px solid var(--border);">
                    <div style="font-weight: 700; font-size: 1.1rem;">Midnight Jazz Festival</div>
                    <div style="font-size: 0.85rem; color: var(--text-muted);">Venue: Blue Note Jazz Club â€¢ 2 Tickets
                    </div>
                </div>

                <!-- Attendee List -->
                <div style="padding: 2rem;">
                    <h3
                        style="font-size: 1rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
                        <i class="fa fa-users-crown" style="color: var(--primary);"></i> Registered Attendees
                    </h3>

                    <div style="display: grid; gap: 1rem;">
                        <!-- Attendee 1 -->
                        <div
                            style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--bg-dark); border-radius: 12px; border: 1px solid var(--border);">
                            <div>
                                <div style="font-weight: 600; color: var(--text-main);">Alice Johnson</div>
                                <div style="font-size: 0.8rem; color: var(--text-dim); margin-top: 0.2rem;">
                                    <i class="fa fa-phone" style="font-size: 0.7rem;"></i> +1 (555) 123-4567
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <span
                                    style="font-size: 0.7rem; padding: 0.2rem 0.6rem; background: rgba(46, 204, 113, 0.1); color: #2ECC71; border-radius: 20px; font-weight: 600;">ACTIVE</span>
                            </div>
                        </div>

                        <!-- Attendee 2 -->
                        <div
                            style="display: flex; justify-content: space-between; align-items: center; padding: 1rem; background: var(--bg-dark); border-radius: 12px; border: 1px solid var(--border);">
                            <div>
                                <div style="font-weight: 600; color: var(--text-main);">Bob Wilson</div>
                                <div style="font-size: 0.8rem; color: var(--text-dim); margin-top: 0.2rem;">
                                    <i class="fa fa-phone" style="font-size: 0.7rem;"></i> +1 (555) 987-6543
                                </div>
                            </div>
                            <div style="text-align: right;">
                                <span
                                    style="font-size: 0.7rem; padding: 0.2rem 0.6rem; background: rgba(46, 204, 113, 0.1); color: #2ECC71; border-radius: 20px; font-weight: 600;">ACTIVE</span>
                            </div>
                        </div>
                    </div>

                    <div style="margin-top: 2rem;">
                        <button class="btn btn-primary" style="width: 100%; padding: 1rem; font-size: 1rem;">
                            <i class="fa fa-user-check"></i> Complete Check-In
                        </button>
                    </div>
                </div>

                <div
                    style="background: var(--bg-surface); padding: 1.2rem; text-align: center; border-top: 1px solid var(--border);">
                    <a href="scanner" style="color: var(--primary); font-size: 0.9rem; font-weight: 600;">
                        <i class="fa fa-qrcode"></i> Scan Next Ticket
                    </a>
                </div>
            </div>

            <div style="margin-top: 2rem; text-align: center;">
                <p style="font-size: 0.8rem; color: var(--text-dim);">
                    Verification Timestamp: Oct 24, 2026 â€¢ 07:45 PM
                </p>
            </div>
        </div>
    </main>

</body>

</html>



