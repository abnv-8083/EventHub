<aside class="sidebar">
    <nav class="sidebar-nav" id="adminSidebar">
        <a href="/admin/dashboard"><i class="fa fa-tachometer-alt"></i> <span>Overview</span></a>
        <a href="/admin/users"><i class="fa fa-users"></i> <span>Users</span></a>
        <a href="/admin/organizer"><i class="fa fa-briefcase"></i> <span>Organizers</span></a>
        <a href="/admin/approvals" class="d-flex justify-content-between align-items-center">
            <span><i class="fa fa-calendar-check"></i> Event Approval</span>
            <% if (locals.pendingApprovalsCount > 0) { %>
                <span class="badge rounded-pill bg-danger" style="font-size: 0.7rem; padding: 0.3rem 0.6rem;"><%= pendingApprovalsCount %></span>
            <% } %>
        </a>
        <a href="/admin/payments"><i class="fa fa-hand-holding-usd"></i> <span>Payouts</span></a>
        <a href="/admin/wallet"><i class="fa fa-wallet"></i> <span>Wallet</span></a>
        <a href="/admin/coupons"><i class="fa fa-tags"></i> <span>Coupons</span></a>
        <a href="/admin/categories"><i class="fa fa-tags"></i> <span>Categories</span></a>
        <a href="/admin/refunds"><i class="fa fa-undo"></i> <span>Refunds</span></a>
        <a href="/admin/reports"><i class="fa fa-file-invoice-dollar"></i> <span>Reports</span></a>
        <a href="/admin/logs"><i class="fa fa-terminal"></i> <span>System Logs</span></a>
        <a href="/admin/admins"><i class="fa fa-user-shield"></i> <span>Administrators</span></a>
    </nav>
    <div style="padding-top: 1rem; border-top: 1px solid var(--border); margin-top: auto;">
        <a href="/admin/profile"><i class="fa fa-user-circle"></i> <span>Profile</span></a>
    </div>
</aside>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll('.sidebar-nav a, .sidebar div a');
        
        // Manual mappings for detail pages that should highlight a specific sidebar item
        const mappings = {
            '/admin/events/view': '/admin/approvals',
            '/admin/organizer/verify': '/admin/approvals'
        };

        let targetPath = currentPath;
        for (const [path, target] of Object.entries(mappings)) {
            if (currentPath.startsWith(path)) {
                targetPath = target;
                break;
            }
        }

        let bestMatch = null;
        let bestMatchLength = 0;

        navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (!href || href === '#') return;
            
            // Exact match or prefix match for mapped target
            if ((targetPath === href || targetPath.startsWith(href)) && href.length > bestMatchLength) {
                bestMatch = link;
                bestMatchLength = href.length;
            }
        });

        if (bestMatch) {
            bestMatch.classList.add('active');
        }
    });
</script>
