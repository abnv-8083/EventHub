<aside class="sidebar">
    <nav class="sidebar-nav" id="organizerSidebar">
        <a href="/organizer/dashboard"><i class="fa fa-chart-line"></i> <span>Dashboard</span></a>
        <a href="/organizer/event"><i class="fa fa-plus-circle"></i> <span>Create Event</span></a>
        <a href="/organizer/manage-events"><i class="fa fa-tasks"></i> <span>Manage Events</span></a>
        <a href="/organizer/refunds"><i class="fa fa-undo"></i> <span>Refund Requests</span></a>
        <a href="/organizer/revenue"><i class="fa fa-wallet"></i> <span>Revenue</span></a>
        <hr style="margin: 1.5rem 0; border: 0; border-top: 1px solid var(--border);">
        <a href="/organizer/profile"><i class="fa fa-building"></i> <span>Org Profile</span></a>
        <a href="/organizer/scanner"><i class="fa fa-qrcode"></i> <span>Ticket Scanner</span></a>
    </nav>
</aside>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        const currentPath = window.location.pathname;
        const navLinks = document.querySelectorAll('#organizerSidebar a');
        
        let bestMatch = null;
        let bestMatchLength = 0;

        navLinks.forEach(link => {
            const href = link.getAttribute('href');
            if (currentPath.startsWith(href) && href.length > bestMatchLength) {
                bestMatch = link;
                bestMatchLength = href.length;
            }
        });

        if (bestMatch) {
            bestMatch.classList.add('active');
        }
    });
</script>