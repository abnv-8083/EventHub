<!DOCTYPE html>
<html lang="en">

<%- include('../../partials/head', { title: 'Payment' }) %>

<body>

    <%- include('../../partials/header') %>

    <main class="section">
        <div class="container" style="max-width: 900px;">
            <div style="margin-bottom: 2.5rem; display: flex; align-items: center; gap: 1rem;">
                <a href="booking" style="color: var(--text-muted);"><i class="fa fa-arrow-left"></i> Back to
                    Review</a>
                <h1 style="font-size: 1.8rem;">Select <span class="text-gradient">Payment Method</span></h1>
            </div>

            <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem; align-items: start;">
                <div style="display: grid; gap: 1rem;">
                    <!-- Payment Options -->
                    <label class="card"
                        style="padding: 1.5rem; display: flex; align-items: center; gap: 1.5rem; cursor: pointer; border-color: var(--primary);">
                        <input type="radio" name="payment" checked
                            style="accent-color: var(--primary); width: 20px; height: 20px;">
                        <div style="width: 50px; text-align: center;"><i class="fa fa-credit-card"
                                style="font-size: 1.5rem;"></i></div>
                        <div style="flex: 1;">
                            <div style="font-weight: 600;">Credit / Debit Card</div>
                            <div style="font-size: 0.8rem; color: var(--text-muted);">Visa, Mastercard, Amex</div>
                        </div>
                    </label>

                    <label class="card"
                        style="padding: 1.5rem; display: flex; align-items: center; gap: 1.5rem; cursor: pointer;">
                        <input type="radio" name="payment"
                            style="accent-color: var(--primary); width: 20px; height: 20px;">
                        <div style="width: 50px; text-align: center;"><i class="fab fa-paypal"
                                style="font-size: 1.5rem; color: #003087;"></i></div>
                        <div style="flex: 1;">
                            <div style="font-weight: 600;">PayPal</div>
                            <div style="font-size: 0.8rem; color: var(--text-muted);">Pay with your PayPal account</div>
                        </div>
                    </label>

                    <label class="card"
                        style="padding: 1.5rem; display: flex; align-items: center; gap: 1.5rem; cursor: pointer;">
                        <input type="radio" name="payment"
                            style="accent-color: var(--primary); width: 20px; height: 20px;">
                        <div style="width: 50px; text-align: center;"><i class="fab fa-google-pay"
                                style="font-size: 2rem;"></i></div>
                        <div style="flex: 1;">
                            <div style="font-weight: 600;">Google Pay</div>
                            <div style="font-size: 0.8rem; color: var(--text-muted);">Fast checkout with Google</div>
                        </div>
                    </label>

                    <!-- Card Details Form (Simplified) -->
                    <div class="card animate" style="padding: 2rem; margin-top: 1rem;">
                        <div class="form-group">
                            <label class="label">Cardholder Name</label>
                            <input type="text" class="input" placeholder="John Doe">
                        </div>
                        <div class="form-group">
                            <label class="label">Card Number</label>
                            <input type="text" class="input" placeholder="0000 0000 0000 0000">
                        </div>
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                            <div class="form-group">
                                <label class="label">Expiry Date</label>
                                <input type="text" class="input" placeholder="MM/YY">
                            </div>
                            <div class="form-group">
                                <label class="label">CVV</label>
                                <input type="text" class="input" placeholder="123">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Small Summary -->
                <div class="card" style="padding: 2rem;">
                    <h3 style="margin-bottom: 1.5rem;">Summary</h3>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 1rem;">
                        <span style="color: var(--text-muted);">Amount to pay</span>
                        <span style="font-weight: 700; font-size: 1.3rem;">$83.50</span>
                    </div>
                    <a href="success" class="btn btn-primary"
                        style="width: 100%; padding: 1rem; margin-top: 1rem;">Pay Now</a>
                    <div
                        style="text-align: center; margin-top: 1.5rem; color: #2ECC71; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                        <i class="fa fa-lock"></i> SSL Secured Transaction
                    </div>
                </div>
            </div>
        </div>
    </main>

</body>

</html>




