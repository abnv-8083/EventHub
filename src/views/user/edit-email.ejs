<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Edit Email Address' }) %>

<body>

    <!-- Header same as dashboard -->
    <%- include('../partials/header') %>

    <div class="dashboard-layout">
        <!-- Sidebar -->
        <%- include('../partials/sidebar') %>
        <!-- Main Content -->
        <main class="dashboard-main animate">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2.5rem;">
                <h1 style="font-size: 1.8rem; margin: 0;">Edit <span class="text-gradient">Email</span></h1>
                <a href="/user/profile" class="btn btn-outline"><i class="fa fa-arrow-left"></i> Back to Profile</a>
            </div>

            <div class="card" style="padding: 2.5rem; max-width: 600px;">
                <h3 style="margin-bottom: 2rem; font-size: 1.2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
                    Update Email Address</h3>
                
                <form id="editEmailForm" action="/user/profile/edit/email" method="POST" class="ajax-form">
                    <input type="hidden" name="id" value="<%= user._id %>">
                    
                    <div class="form-group" style="margin-bottom: 2rem;">
                        <label class="label">Current Email</label>
                        <input type="email" class="input" value="<%= user.email %>" disabled>
                        <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.5rem;">This is your current email address used for login and notifications.</p>
                    </div>

                    <div class="form-group" style="margin-bottom: 2.5rem;">
                        <label class="label">New Email Address</label>
                        <input type="email" name="email" class="input" placeholder="Enter your new email address" required autofocus>
                    </div>

                    <div style="border-top: 1px solid var(--border); padding-top: 2rem; display: flex; justify-content: flex-end; gap: 1rem;">
                        <a href="/user/profile" class="btn btn-outline" style="text-decoration: none;">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> Save Email</button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const editEmailForm = document.getElementById('editEmailForm');
            
            // Handle successful form submission
            editEmailForm.addEventListener('ajax:success', (e) => {
                // Let the toast show, then redirect back to profile after a short delay
                setTimeout(() => {
                    window.location.href = '/user/profile';
                }, 1500);
            });
        });
    </script>
    <%- include('../partials/footer-scripts') %>

</body>

</html>
