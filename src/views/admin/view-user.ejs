<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'View User | Admin Hub' }) %>

<body>

    <%- include('../partials/header-admin') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar-admin') %>

        <main class="dashboard-main animate">
            <div class="d-flex align-items-center gap-3 mb-5">
                <a href="#" onclick="history.back(); return false;" class="btn btn-outline"
                    style="padding: 0.5rem; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                    <i class="fa fa-arrow-left"></i>
                </a>
                <div>
                    <h1 style="font-size: 1.8rem; margin-bottom: 0;">User <span class="text-gradient">Profile</span></h1>
                    <p style="color: var(--text-muted); margin-bottom: 0; margin-top: 0.2rem;">Viewing details for <%= userData.name %></p>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 320px; gap: 2rem; max-width: 1100px;">

                <!-- Main Profile Card -->
                <div class="card glass" style="padding: 2.5rem; border-radius: 20px;">
                    <div style="display: flex; align-items: center; gap: 2rem; margin-bottom: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 2rem;">
                        <div style="width: 90px; height: 90px; border-radius: 50%; overflow: hidden; background: var(--bg-surface); border: 2px solid var(--border); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <% if (userData.avatar_url && userData.avatar_url !== 'None') { %>
                                <img src="<%= userData.avatar_url %>" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" referrerpolicy="no-referrer">
                            <% } else { %>
                                <i class="fa fa-user" style="font-size: 2rem; color: var(--text-dim);"></i>
                            <% } %>
                        </div>
                        <div>
                            <h2 style="font-size: 1.5rem; font-weight: 600; margin-bottom: 0.3rem;"><%= userData.name %></h2>
                            <p style="color: var(--text-muted); margin: 0;"><%= userData.email %></p>
                            <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem; flex-wrap: wrap;">
                                <% if (userData.status === 'Active') { %>
                                    <span style="font-size: 0.78rem; background: rgba(46, 204, 113, 0.1); color: #2ECC71; padding: 0.3rem 0.7rem; border-radius: 2rem;">Active</span>
                                <% } else { %>
                                    <span style="font-size: 0.78rem; background: rgba(231, 76, 60, 0.1); color: #E74C3C; padding: 0.3rem 0.7rem; border-radius: 2rem;"><%= userData.status %></span>
                                <% } %>
                                <% if (userData.isOrganizer) { %>
                                    <span style="font-size: 0.78rem; background: rgba(52, 152, 219, 0.1); color: #3498DB; padding: 0.3rem 0.7rem; border-radius: 2rem;"><i class="fa fa-briefcase"></i> Verified Organizer</span>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;">
                        <div>
                            <p style="color: var(--text-dim); font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.3rem;">Phone</p>
                            <p style="color: #fff; margin: 0;"><%= userData.phone || '—' %></p>
                        </div>
                        <div>
                            <p style="color: var(--text-dim); font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.3rem;">Location</p>
                            <p style="color: #fff; margin: 0;"><%= userData.city || '—' %></p>
                        </div>
                        <div>
                            <p style="color: var(--text-dim); font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.3rem;">Gender</p>
                            <p style="color: #fff; margin: 0; text-transform: capitalize;"><%= userData.gender || '—' %></p>
                        </div>
                        <div>
                            <p style="color: var(--text-dim); font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.3rem;">Occupation</p>
                            <p style="color: #fff; margin: 0;"><%= userData.occupation || '—' %></p>
                        </div>
                        <div>
                            <p style="color: var(--text-dim); font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.3rem;">Date of Birth</p>
                            <p style="color: #fff; margin: 0;"><%= userData.dob ? new Date(userData.dob).toLocaleDateString() : '—' %></p>
                        </div>
                        <div>
                            <p style="color: var(--text-dim); font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.3rem;">Member Since</p>
                            <p style="color: #fff; margin: 0;"><%= new Date(userData.createdAt).toLocaleDateString() %></p>
                        </div>
                    </div>

                    <% if (userData.bio) { %>
                    <div style="margin-top: 1.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
                        <p style="color: var(--text-dim); font-size: 0.8rem; text-transform: uppercase; margin-bottom: 0.5rem;">Bio</p>
                        <p style="color: var(--text-muted); line-height: 1.6; margin: 0;"><%= userData.bio %></p>
                    </div>
                    <% } %>
                </div>

                <!-- Actions Sidebar -->
                <div style="display: flex; flex-direction: column; gap: 1.5rem;">
                    <div class="card" style="padding: 1.5rem; border-radius: 16px;">
                        <h4 style="font-size: 0.9rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-bottom: 1.5rem;">Admin Actions</h4>
                        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                            <form class="ajax-form" action="/admin/users/toggle-block/<%= userData._id %>" method="POST">
                                <button type="submit" class="btn btn-outline" style="width: 100%; padding: 0.8rem; text-align: center; color: <%= userData.status === 'Active' ? '#E67E22' : '#2ECC71' %>; border-color: <%= userData.status === 'Active' ? 'rgba(230,126,34,0.3)' : 'rgba(46,204,113,0.3)' %>;">
                                    <i class="fa fa-<%= userData.status === 'Active' ? 'ban' : 'check-circle' %>"></i>
                                    <%= userData.status === 'Active' ? 'Block Account' : 'Unblock Account' %>
                                </button>
                            </form>
                            <form class="ajax-form" action="/admin/users/delete/<%= userData._id %>" method="POST">
                                <button type="submit" class="btn btn-outline" style="width: 100%; padding: 0.8rem; text-align: center; color: #E63946; border-color: rgba(230,57,70,0.3);">
                                    <i class="fa fa-trash"></i> Delete Account
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="card" style="padding: 1.5rem; border-radius: 16px;">
                        <h4 style="font-size: 0.9rem; font-weight: 600; color: var(--text-muted); text-transform: uppercase; margin-bottom: 1rem;">Account Meta</h4>
                        <div style="font-size: 0.85rem; color: var(--text-dim);">
                            <p style="margin-bottom: 0.5rem;"><i class="fa fa-fingerprint" style="width: 18px; color: var(--primary);"></i> <code style="font-size: 0.75rem;"><%= userData._id %></code></p>
                            <p style="margin-bottom: 0;"><i class="fa fa-calendar-alt" style="width: 18px; color: var(--text-dim);"></i> <%= new Date(userData.createdAt).toLocaleString() %></p>
                        </div>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <%- include('partials/scripts') %>
</body>
</html>
