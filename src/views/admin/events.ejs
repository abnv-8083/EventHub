<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Manage Events | Admin' }) %>

<body>

    <%- include('../partials/header-admin') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar-admin') %>

        <main class="dashboard-main animate">
            <div style="margin-bottom: 2.5rem; display: flex; justify-content: space-between; align-items: flex-end;">
                <div>
                    <h1 style="font-size: 1.8rem; margin: 0;">Event <span class="text-gradient">Oversight</span></h1>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem;">Review and manage platform event submissions.</p>
                </div>
            </div>

            <!-- Filters -->
            <div class="card" style="margin-bottom: 2rem; padding: 1.2rem; background: rgba(255,255,255,0.02); border-color: var(--border);">
                <form action="/admin/events" method="GET" style="display: flex; gap: 1rem; align-items: center;">
                    <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <a href="/admin/events" class="btn <%= !currentStatus ? 'btn-primary' : 'btn-outline' %>" style="padding: 0.4rem 1.2rem; font-size: 0.8rem; border-radius: 20px;">All</a>
                        <a href="/admin/events?status=Pending" class="btn <%= currentStatus === 'Pending' ? 'btn-primary' : 'btn-outline' %>" style="padding: 0.4rem 1.2rem; font-size: 0.8rem; border-radius: 20px;">Pending</a>
                        <a href="/admin/events?status=Approved" class="btn <%= currentStatus === 'Approved' ? 'btn-primary' : 'btn-outline' %>" style="padding: 0.4rem 1.2rem; font-size: 0.8rem; border-radius: 20px;">Approved</a>
                        <a href="/admin/events?status=Rejected" class="btn <%= currentStatus === 'Rejected' ? 'btn-primary' : 'btn-outline' %>" style="padding: 0.4rem 1.2rem; font-size: 0.8rem; border-radius: 20px;">Rejected</a>
                    </div>
                </form>
            </div>

            <!-- Events List -->
            <div class="card" style="padding: 0; overflow: hidden; border-color: var(--border);">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Event Details</th>
                            <th>Organizer</th>
                            <th>Schedule</th>
                            <th>Capacity</th>
                            <th>Status</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (events && events.length > 0) { %>
                            <% events.forEach(event => { %>
                                <tr>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 1.2rem;">
                                            <div style="width: 54px; height: 36px; border-radius: 6px; overflow: hidden; background: var(--bg-surface); border: 1px solid var(--border);">
                                                <% let bannerSrc = event.bannerImage ? (event.bannerImage.startsWith('http') ? event.bannerImage : '/' + event.bannerImage.replace(/\\/g, '/')) : '/img/placeholder.png'; %>
                                                <img src="<%= bannerSrc %>" alt="" style="width: 100%; height: 100%; object-fit: cover;">
                                            </div>
                                            <div>
                                                <div style="font-weight: 600; font-size: 0.95rem; color: #fff;"><%= event.title %></div>
                                                <div class="secondary"><%= event.category %></div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="font-size: 0.95rem; color: #fff;"><%= event.organizerId ? event.organizerId.organizationName : 'Unknown' %></div>
                                        <div class="secondary"><%= event.organizerId ? event.organizerId.operatingRegion : 'N/A' %></div>
                                    </td>
                                    <td>
                                        <div style="font-size: 0.95rem; color: #fff;"><%= new Date(event.startDate).toLocaleDateString() %></div>
                                        <div class="secondary"><%= event.startTime %></div>
                                    </td>
                                    <td>
                                        <% let totalSeats = event.ticketing.reduce((sum, t) => sum + t.availableSeats, 0); %>
                                        <div style="font-size: 0.95rem; color: #fff;"><%= totalSeats %> Seats</div>
                                        <div class="secondary"><%= event.ticketing.length %> Type(s)</div>
                                    </td>
                                    <td>
                                        <% 
                                            let sClass = 'status-pending';
                                            if (event.status === 'Approved' || event.status === 'Published') sClass = 'status-approved';
                                            if (event.status === 'Rejected') sClass = 'status-rejected';
                                        %>
                                        <span class="status-badge <%= sClass %>">
                                            <i class="fa fa-circle"></i> <%= event.status %>
                                        </span>
                                    </td>
                                    <td style="text-align: right;">
                                        <div style="display: flex; gap: 0.6rem; justify-content: flex-end;">
                                            <a href="/admin/events/view/<%= event._id %>" class="btn btn-outline" style="padding: 0.5rem; width: 34px; height: 34px; border-radius: 8px;" title="View Details">
                                                <i class="fa fa-eye"></i>
                                            </a>
                                            <% if (event.status === 'Pending') { %>
                                                <button onclick="quickApprove('<%= event._id %>')" class="btn btn-primary" style="padding: 0.5rem; width: 34px; height: 34px; border-radius: 8px; background: #2ecc71; border-color: #2ecc71;" title="Quick Approve">
                                                    <i class="fa fa-check"></i>
                                                </button>
                                                <button onclick="openRejectModal('<%= event._id %>')" class="btn btn-outline" style="padding: 0.5rem; width: 34px; height: 34px; border-radius: 8px; color: #e74c3c; border-color: #e74c3c;" title="Quick Reject">
                                                    <i class="fa fa-times"></i>
                                                </button>
                                            <% } %>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 5rem; color: var(--text-dim);">
                                    <i class="fa fa-calendar-times" style="font-size: 3rem; opacity: 0.1; display: block; margin-bottom: 1.5rem;"></i>
                                    No events found in this category.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div style="margin-top: 3rem; display: flex; justify-content: center; gap: 0.8rem;">
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="/admin/events?page=<%= i %><%= currentStatus ? '&status=' + currentStatus : '' %>" 
                           class="btn <%= currentPage === i ? 'btn-primary' : 'btn-outline' %>"
                           style="padding: 0.5rem 1.2rem; min-width: 45px; border-radius: 10px;">
                            <%= i %>
                        </a>
                    <% } %>
                </div>
            <% } %>

            <!-- Reject Modal -->
            <div id="rejectModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.8); backdrop-filter: blur(5px); z-index: 9999; align-items: center; justify-content: center;">
                <div class="card animate" style="width: 100%; max-width: 500px; padding: 2.5rem; margin: 1rem; border-color: var(--primary);">
                    <h2 style="margin-top: 0; margin-bottom: 0.5rem;">Reject Submission</h2>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 2rem;">Please provide a reason for rejection. This will be sent to the organizer.</p>
                    
                    <form id="rejectForm">
                        <input type="hidden" id="rejectEventId">
                        <div class="form-group">
                            <label class="label">Rejection Reason</label>
                            <textarea class="input" id="rejectionReason" name="reason" rows="4" required placeholder="Outline why this event cannot be published..."></textarea>
                        </div>
                        <div style="display: flex; justify-content: flex-end; gap: 1rem; margin-top: 2rem;">
                            <button type="button" class="btn btn-outline" onclick="closeRejectModal()">Cancel</button>
                            <button type="submit" class="btn btn-primary" style="background: var(--primary);">Confirm Reject</button>
                        </div>
                    </form>
                </div>
            </div>
        </main>
    </div>

    <%- include('../partials/footer-scripts') %>
    <script src="/js/ajax-handler.js"></script>
    <script>
        function quickApprove(id) {
            if (confirm('Are you sure you want to approve this event?')) {
                window.submitFormAjax({
                    action: `/admin/events/approve/${id}`,
                    method: 'POST'
                });
            }
        }

        function openRejectModal(id) {
            document.getElementById('rejectEventId').value = id;
            document.getElementById('rejectModal').style.display = 'flex';
        }

        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
        }

        document.getElementById('rejectForm').addEventListener('submit', function(e) {
            e.preventDefault();
            const id = document.getElementById('rejectEventId').value;
            const reason = document.getElementById('rejectionReason').value;
            if (!reason) return;

            window.submitFormAjax({
                action: `/admin/events/reject/${id}`,
                method: 'POST',
                data: { reason }
            });
        });
    </script>
</body>
</html>
