<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Category Management | Admin Hub' }) %>

    <body>

        <%- include('../partials/header-admin') %>

            <div class="dashboard-layout">
                <%- include('../partials/sidebar-admin') %>

                    <main class="dashboard-main animate">
                        <div
                            style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;">
                            <div>
                                <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Event <span
                                        class="text-gradient">Categories</span></h1>
                                <p style="color: var(--text-muted); margin: 0;">Manage all event categories on the
                                    platform.</p>
                            </div>
                            <button class="btn btn-primary" id="createCategoryBtn"><i class="fa fa-plus"></i> Add
                                Category</button>
                        </div>

                        <form method="GET" action="/admin/categories"
                            style="margin-bottom: 2rem; display: flex; gap: 1rem; max-width: 500px;">
                            <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>"
                                placeholder="Search categories..." class="input"
                                style="flex: 1; background: var(--bg-surface);">
                            <button type="submit" class="btn btn-outline" style="padding: 0.8rem 1.5rem;"><i
                                    class="fa fa-search"></i></button>
                            <% if (typeof search !=='undefined' && search) { %>
                                <a href="/admin/categories" class="btn btn-outline"
                                    style="padding: 0.8rem 1rem; color: var(--text-muted);"><i
                                        class="fa fa-times"></i></a>
                                <% } %>
                        </form>

                        <div class="card" style="padding: 0; overflow: hidden; border-color: var(--border);">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th>Description</th>
                                        <th style="text-align: center;">Events</th>
                                        <th style="text-align: center;">Status</th>
                                        <th style="text-align: center;">Featured</th>
                                        <th style="text-align: right;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (categories && categories.length===0) { %>
                                        <tr>
                                            <td colspan="6" style="text-align: center; padding: 5rem; color: var(--text-dim);">
                                                <i class="fa fa-layer-group" style="font-size: 3rem; opacity: 0.1; display: block; margin-bottom: 1.5rem;"></i>
                                                No categories found.
                                            </td>
                                        </tr>
                                        <% } else if (categories) { %>
                                            <% categories.forEach(cat=> { %>
                                                <tr id="row-<%=cat._id%>" class="rowCount">
                                                    <td>
                                                        <div style="display: flex; align-items: center; gap: 1.25rem;">
                                                            <div style="width: 44px; height: 44px; border-radius: 10px; background: <%= cat.color %>; display: flex; align-items: center; justify-content: center; flex-shrink: 0; box-shadow: 0 4px 12px <%= cat.color %>40;">
                                                                <i class="fa <%= cat.icon %>" style="color: white; font-size: 1.1rem;"></i>
                                                            </div>
                                                            <div>
                                                                <div style="font-weight: 600; color: #fff; font-size: 0.95rem;"><%= cat.name %></div>
                                                                <div class="secondary">ID: <%= cat._id.toString().slice(-8).toUpperCase() %></div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <div class="secondary" style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                            <%= cat.description || 'No description provided' %>
                                                        </div>
                                                    </td>
                                                    <td style="text-align: center;">
                                                        <span style="background: rgba(255, 255, 255, 0.05); color: #fff; padding: 0.35rem 0.8rem; border-radius: 12px; font-weight: 600; font-size: 0.8rem; border: 1px solid var(--border);">
                                                            <%= cat.eventCount %>
                                                        </span>
                                                    </td>
                                                    <td style="text-align: center;">
                                                        <span class="status-badge <%= cat.status === 'Active' ? 'status-approved' : 'status-rejected' %>">
                                                            <i class="fa fa-circle"></i> <%= cat.status.toUpperCase() %>
                                                        </span>
                                                    </td>
                                                    <td style="text-align: center;">
                                                        <% if (cat.featured) { %>
                                                            <i class="fa fa-star" style="color: #f1c40f; font-size: 1.1rem; filter: drop-shadow(0 0 5px rgba(241, 196, 15, 0.5));"></i>
                                                        <% } else { %>
                                                            <i class="fa fa-star" style="color: var(--text-dim); font-size: 1.1rem; opacity: 0.2;"></i>
                                                        <% } %>
                                                    </td>
                                                    <td style="text-align: right;">
                                                        <div style="display: flex; gap: 0.6rem; justify-content: flex-end;">
                                                            <button type="button" class="btn btn-outline editCategoryBtn"
                                                                data-id="<%= cat._id %>"
                                                                data-name="<%= cat.name || '' %>"
                                                                data-description="<%= cat.description || '' %>"
                                                                data-status="<%= cat.status || 'Active' %>"
                                                                data-featured="<%= cat.featured || 'false' %>"
                                                                data-color="<%= cat.color || '#3498db' %>"
                                                                data-icon="<%= cat.icon || 'fa-hashtag' %>"
                                                                style="padding: 0.5rem; width: 34px; height: 34px; border-radius: 8px;"
                                                                title="Edit Category">
                                                                <i class="fa fa-edit"></i>
                                                            </button>
                                                            <button type="button" class="btn btn-outline deleteCategoryBtn"
                                                                data-id="<%= cat._id %>"
                                                                style="padding: 0.5rem; width: 34px; height: 34px; border-radius: 8px; color: var(--primary); border-color: rgba(230, 57, 70, 0.2);"
                                                                title="Delete">
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                    </main>
            </div>

            <div id="editModal" class="modal-overlay">
                <div class="modal-container animate" style="max-width: 450px; width: 95%;">
                    <div class="modal-header" style="padding: 1rem 1.5rem;">
                        <h3 style="font-size: 1.1rem; margin: 0;">Edit Category</h3>
                        <i class="fa fa-times modal-close" onclick="document.getElementById('editModal').classList.remove('active')"></i>
                    </div>
                    <form id="editCategoryForm" method="POST" class="needs-validation">
                        <div class="modal-body" style="padding: 1.5rem;">
                            <input type="hidden" id="editCategoryId" name="id">
                            <div class="form-group" style="margin-bottom: 0.8rem;">
                                <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Category Name <span style="color:red">*</span></label>
                                <input type="text" class="input" id="editCategoryName" name="name" required maxlength="50" style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-main);">
                            </div>
                            <div class="form-group" style="margin-bottom: 0.8rem;">
                                <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Description</label>
                                <textarea class="input" id="editCategoryDescription" name="description" rows="2" maxlength="200" style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-main);"></textarea>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 0.8rem;">
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Status</label>
                                    <select class="input" id="editCategoryStatus" name="status" style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-main);">
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                </div>
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Featured</label>
                                    <select class="input" id="editCategoryFeatured" name="featured" style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-main);">
                                        <option value="true">Yes</option>
                                        <option value="false">No</option>
                                    </select>
                                </div>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 0.5rem;">
                                 <div class="form-group" style="margin-bottom: 0;">
                                     <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Color</label>
                                     <input type="color" class="input" id="editCategoryColor" name="color" style="width: 40px; height: 40px; padding: 0; border: none; border-radius: 6px; cursor: pointer; background: transparent;">
                                 </div>
                                 <div class="form-group" style="margin-bottom: 0; position: relative;">
                                     <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Icon</label>
                                     <input type="hidden" id="editCategoryIcon" name="icon" value="fa-hashtag">
                                     <button type="button" id="editIconPickerBtn" style="width: 40px; height: 40px; padding: 0; border: 1px solid var(--border); border-radius: 6px; cursor: pointer; background: var(--bg-body); color: var(--text-main); font-size: 1.2rem; display: flex; align-items: center; justify-content: center;" onclick="document.getElementById('editIconGrid').style.display = document.getElementById('editIconGrid').style.display === 'none' ? 'grid' : 'none'">
                                         <i class="fa fa-hashtag" id="editIconPreview"></i>
                                     </button>
                                     <div id="editIconGrid" style="display: none; position: absolute; bottom: 100%; left: 0; margin-bottom: 0.5rem; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 8px; padding: 0.5rem; z-index: 1100; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.5); width: max-content;">
                                         <% const eIcons = ['fa-music', 'fa-camera', 'fa-laptop', 'fa-book', 'fa-utensils', 'fa-briefcase', 'fa-video', 'fa-gamepad', 'fa-paint-brush', 'fa-heart', 'fa-plane', 'fa-basketball-ball']; %>
                                         <% eIcons.forEach(ic => { %>
                                            <div onclick="document.getElementById('editCategoryIcon').value = '<%=ic%>'; document.getElementById('editIconPreview').className = 'fa <%=ic%>'; document.getElementById('editIconGrid').style.display = 'none';" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; border-radius: 4px; transition: background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='transparent'">
                                                <i class="fa <%=ic%>" style="font-size: 1rem; color: var(--text-main);"></i>
                                            </div>
                                         <% }) %>
                                     </div>
                                 </div>
                            </div>
                        </div>
                        <div class="modal-footer" style="padding: 1rem 1.5rem;">
                            <button type="button" class="btn btn-outline" onclick="document.getElementById('editModal').classList.remove('active')" style="border-color: var(--border); color: var(--text-main);">Cancel</button>
                            <button type="submit" class="btn btn-primary" id="saveCategoryBtn">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>

            <div id="createModal" class="modal-overlay">
                <div class="modal-container animate" style="max-width: 450px; width: 95%;">
                    <div class="modal-header" style="padding: 1rem 1.5rem;">
                        <h3 style="font-size: 1.1rem; margin: 0;">Create Category</h3>
                        <i class="fa fa-times modal-close" onclick="document.getElementById('createModal').classList.remove('active')"></i>
                    </div>
                    <form id="createCategoryForm" action="/admin/categories/create" method="POST" class="needs-validation">
                        <div class="modal-body" style="padding: 1.5rem;">
                            <div class="form-group" style="margin-bottom: 0.8rem;">
                                <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Category Name <span style="color:red">*</span></label>
                                <input type="text" class="input" id="createCategoryName" name="name" required maxlength="50" style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-main);" placeholder="e.g. Technology">
                            </div>
                            <div class="form-group" style="margin-bottom: 0.8rem;">
                                <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Description</label>
                                <textarea class="input" id="createCategoryDescription" name="description" rows="2" maxlength="200" style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-main);" placeholder="Brief description regarding this category type"></textarea>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 0.8rem;">
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Status</label>
                                    <select class="input" id="createCategoryStatus" name="status" style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-main);">
                                        <option value="Active">Active</option>
                                        <option value="Inactive">Inactive</option>
                                    </select>
                                </div>
                                <div class="form-group" style="margin-bottom: 0;">
                                    <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Featured</label>
                                    <select class="input" id="createCategoryFeatured" name="featured" style="width: 100%; padding: 0.6rem 0.8rem; border-radius: 6px; border: 1px solid var(--border); background: var(--bg-body); color: var(--text-main);">
                                        <option value="false">No</option>
                                        <option value="true">Yes</option>
                                    </select>
                                </div>
                            </div>
                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 0.5rem;">
                                 <div class="form-group" style="margin-bottom: 0;">
                                     <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Color</label>
                                     <input type="color" class="input" id="createCategoryColor" name="color" value="#3498db" style="width: 40px; height: 40px; padding: 0; border: none; border-radius: 6px; cursor: pointer; background: transparent;">
                                 </div>
                                 <div class="form-group" style="margin-bottom: 0; position: relative;">
                                     <label class="label" style="display: block; margin-bottom: 0.3rem; color: var(--text-dim); font-size: 0.85rem;">Icon</label>
                                     <input type="hidden" id="createCategoryIcon" name="icon" value="fa-music">
                                     <button type="button" id="createIconPickerBtn" style="width: 40px; height: 40px; padding: 0; border: 1px solid var(--border); border-radius: 6px; cursor: pointer; background: var(--bg-body); color: var(--text-main); font-size: 1.2rem; display: flex; align-items: center; justify-content: center;" onclick="document.getElementById('createIconGrid').style.display = document.getElementById('createIconGrid').style.display === 'none' ? 'grid' : 'none'">
                                         <i class="fa fa-music" id="createIconPreview"></i>
                                     </button>
                                     <div id="createIconGrid" style="display: none; position: absolute; bottom: 100%; left: 0; margin-bottom: 0.5rem; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 8px; padding: 0.5rem; z-index: 1100; grid-template-columns: repeat(4, 1fr); gap: 0.5rem; box-shadow: 0 10px 25px rgba(0,0,0,0.5); width: max-content;">
                                         <% const cIcons = ['fa-music', 'fa-camera', 'fa-laptop', 'fa-book', 'fa-utensils', 'fa-briefcase', 'fa-video', 'fa-gamepad', 'fa-paint-brush', 'fa-heart', 'fa-plane', 'fa-basketball-ball']; %>
                                         <% cIcons.forEach(ic => { %>
                                            <div onclick="document.getElementById('createCategoryIcon').value = '<%=ic%>'; document.getElementById('createIconPreview').className = 'fa <%=ic%>'; document.getElementById('createIconGrid').style.display = 'none';" style="width: 32px; height: 32px; display: flex; align-items: center; justify-content: center; cursor: pointer; border-radius: 4px; transition: background 0.15s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='transparent'">
                                                <i class="fa <%=ic%>" style="font-size: 1rem; color: var(--text-main);"></i>
                                            </div>
                                         <% }) %>
                                     </div>
                                 </div>
                            </div>
                        </div>
                        <div class="modal-footer" style="padding: 1rem 1.5rem;">
                            <button type="button" class="btn btn-outline" onclick="document.getElementById('createModal').classList.remove('active')" style="border-color: var(--border); color: var(--text-main);">Cancel</button>
                            <button type="submit" class="btn btn-primary" id="submitCreateCategoryBtn">Create</button>
                        </div>
                    </form>
                </div>
            </div>

            <%- include('partials/scripts') %>

                <script>
                    // --- CREATE CATEGORY LOGIC ---
                    document.getElementById('createCategoryBtn').addEventListener('click', () => {
                        const form = document.getElementById('createCategoryForm');
                        if (form) form.reset();
                        document.getElementById('createCategoryColor').value = '#3498db';
                        document.getElementById('createCategoryIcon').value = 'fa-music';
                        document.getElementById('createIconPreview').className = 'fa fa-music';
                        document.getElementById('createIconPreview').style.color = '#3498db';
                        document.getElementById('createModal').classList.add('active');
                    });
                    
                    document.getElementById('createCategoryColor').addEventListener('input', (e) => {
                        document.getElementById('createIconPreview').style.color = e.target.value;
                    });
                    
                    document.getElementById('createCategoryForm').addEventListener('ajax:success', () => {
                        document.getElementById('createModal').classList.remove('active');
                        setTimeout(() => window.location.reload(), 1000); 
                    });
                    
                    // --- EDIT CATEGORY LOGIC ---
                    document.getElementById('editCategoryColor').addEventListener('input', (e) => {
                        document.getElementById('editIconPreview').style.color = e.target.value;
                    });
                
                    // Use Event Delegation so it always finds the button
                    document.addEventListener('click', (e) => {
                        const btn = e.target.closest('.editCategoryBtn');
                        if (!btn) return; 
                        
                        e.preventDefault();
                        try {
                            const dataset = btn.dataset;
                            document.getElementById('editCategoryId').value = dataset.id || '';
                            document.getElementById('editCategoryName').value = dataset.name || '';
                            document.getElementById('editCategoryDescription').value = dataset.description || '';
                            document.getElementById('editCategoryStatus').value = dataset.status || 'Active';
                            document.getElementById('editCategoryFeatured').value = dataset.featured || 'false';
                            
                            const colorVal = dataset.color;
                            if (colorVal && /^#[0-9A-Fa-f]{6}$/.test(colorVal)) {
                                document.getElementById('editCategoryColor').value = colorVal;
                                document.getElementById('editIconPreview').style.color = colorVal;
                            } else {
                                document.getElementById('editCategoryColor').value = '#3498db';
                                document.getElementById('editIconPreview').style.color = '#3498db';
                            }
                            
                            document.getElementById('editCategoryIcon').value = dataset.icon || 'fa-hashtag';
                            document.getElementById('editIconPreview').className = `fa ${dataset.icon || 'fa-hashtag'}`;
                            
                            // Set action URL dynamically
                            document.getElementById('editCategoryForm').action = `/admin/categories/edit/${dataset.id}?_method=PATCH`;
                            document.getElementById('editModal').classList.add('active');
                
                        } catch (err) {
                            console.error('Error opening edit modal:', err);
                        }
                    });
                
                    // Handle Edit Form Success (Dynamic DOM Update Without Reload)
                    document.getElementById('editCategoryForm').addEventListener('ajax:success', () => {
                        const id = document.getElementById('editCategoryId').value;
                        const name = document.getElementById('editCategoryName').value;
                        const description = document.getElementById('editCategoryDescription').value;
                        const status = document.getElementById('editCategoryStatus').value;
                        const featured = document.getElementById('editCategoryFeatured').value === 'true';
                        const color = document.getElementById('editCategoryColor').value;
                        const icon = document.getElementById('editCategoryIcon').value;
                
                        const row = document.getElementById(`row-${id}`);
                        
                        if (row) {
                            const nameEl = row.querySelector('td:nth-child(1) div div:nth-child(2) div:nth-child(1)');
                            if (nameEl) nameEl.textContent = name;
                
                            const descDiv = row.querySelector('td:nth-child(2) div');
                            if (descDiv) descDiv.textContent = description || '—';
                
                            const iconContainer = row.querySelector('td:nth-child(1) div div:nth-child(1)');
                            if (iconContainer) {
                                iconContainer.style.background = color;
                                iconContainer.querySelector('i').className = `fa ${icon}`;
                            }
                
                            const statusTd = row.querySelector('td:nth-child(4)');
                            if (statusTd) {
                                if (status === 'Active') {
                                    statusTd.innerHTML = `<span style="background: rgba(46, 204, 113, 0.1); color: #2ECC71; padding: 0.3rem 0.7rem; border-radius: 2rem; font-weight: 500; font-size: 0.8rem;">ACTIVE</span>`;
                                } else {
                                    statusTd.innerHTML = `<span style="background: rgba(231, 76, 60, 0.1); color: #e74c3c; padding: 0.3rem 0.7rem; border-radius: 2rem; font-weight: 500; font-size: 0.8rem;">INACTIVE</span>`;
                                }
                            }
                
                            const featuredTd = row.querySelector('td:nth-child(5)');
                            if (featuredTd) {
                                featuredTd.innerHTML = featured 
                                    ? `<i class="fa fa-star" style="color: #f1c40f; font-size: 1.1rem;"></i>`
                                    : `<i class="fa fa-star" style="color: var(--text-dim); font-size: 1.1rem; opacity: 0.3;"></i>`;
                            }
                
                            // Update the dataset on the Edit Button
                            const editBtn = row.querySelector('.editCategoryBtn');
                            if (editBtn) {
                                editBtn.dataset.name = name;
                                editBtn.dataset.description = description;
                                editBtn.dataset.status = status;
                                editBtn.dataset.featured = featured.toString();
                                editBtn.dataset.color = color;
                                editBtn.dataset.icon = icon;
                            }
                        }
                
                        document.getElementById('editModal').classList.remove('active');
                        if(typeof showToast === 'function') showToast('Category updated successfully', 'success');
                    });
                
                    // --- DELETE CATEGORY LOGIC ---
                    // Also using Event Delegation for Delete buttons for safety and consistency
                    document.addEventListener('click', async (e) => {
                        const btn = e.target.closest('.deleteCategoryBtn');
                        if (!btn) return;

                        const id = btn.dataset.id;
                        const confirmed = await Confirmation.show({
                            title: 'Delete Category?',
                            message: 'Are you sure you want to delete this category? This action cannot be undone.',
                            confirmText: 'Yes, Delete',
                            cancelText: 'Keep it',
                            type: 'delete'
                        });

                        if (confirmed) {
                            try {
                                const response = await fetch(`/admin/categories/delete/${id}`, {
                                    method: 'DELETE',
                                    headers: {
                                        'Content-Type': 'application/json',
                                    }
                                });
                
                                const result = await response.json();
                
                                if (response.ok) {
                                    const rowCount = document.querySelectorAll('.rowCount').length;
                                    if (rowCount !== 1) {
                                        document.getElementById(`row-${id}`).remove();
                                        showToast(result.message, 'success');
                                    } else {
                                        showToast(result.message, 'success');
                                        setTimeout(() => {
                                            window.location.reload();
                                        }, 1000);
                                    }
                                } else {
                                    showToast('Failed to delete category.', 'error');
                                }
                            } catch (error) {
                                console.error('Error:', error);
                                showToast('An error occurred while connecting to the server.', 'error');
                            }
                        }
                    });
                </script>
    </body>
</html>