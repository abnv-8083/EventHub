<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Category Management | Admin Hub' }) %>

    <body>

        <%- include('../partials/header-admin') %>

            <div class="dashboard-layout">
                <%- include('../partials/sidebar-admin') %>

                    <main class="dashboard-main animate">
                        <!-- Header -->
                        <div
                            style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;">
                            <div>
                                <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Event <span
                                        class="text-gradient">Categories</span></h1>
                                <p style="color: var(--text-muted); margin: 0;">Manage all event categories on the
                                    platform.</p>
                            </div>
                            <button class="btn btn-primary" id="createCategoryBtn"><i class="fa fa-plus"></i> Add
                                Category</button>
                        </div>

                        <!-- Search Bar -->
                        <form method="GET" action="/admin/categories"
                            style="margin-bottom: 2rem; display: flex; gap: 1rem; max-width: 500px;">
                            <input type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>"
                                placeholder="Search categories..." class="input"
                                style="flex: 1; background: var(--bg-surface);">
                            <button type="submit" class="btn btn-outline" style="padding: 0.8rem 1.5rem;"><i
                                    class="fa fa-search"></i></button>
                            <% if (typeof search !=='undefined' && search) { %>
                                <a href="/admin/categories" class="btn btn-outline"
                                    style="padding: 0.8rem 1rem; color: var(--text-muted);"><i
                                        class="fa fa-times"></i></a>
                                <% } %>
                        </form>

                        <!-- Categories Table -->
                        <div class="card" style="overflow: hidden; padding: 0;">
                            <table style="width: 100%; border-collapse: collapse;">
                                <thead>
                                    <tr style="border-bottom: 1px solid var(--border); background: var(--bg-surface);">
                                        <th
                                            style="padding: 1rem 1.5rem; text-align: left; font-size: 0.8rem; font-weight: 600; color: var(--text-dim); text-transform: uppercase;">
                                            Category</th>
                                        <th
                                            style="padding: 1rem 1.5rem; text-align: left; font-size: 0.8rem; font-weight: 600; color: var(--text-dim); text-transform: uppercase;">
                                            Description</th>
                                        <th
                                            style="padding: 1rem 1.5rem; text-align: center; font-size: 0.8rem; font-weight: 600; color: var(--text-dim); text-transform: uppercase;">
                                            Events</th>
                                        <th
                                            style="padding: 1rem 1.5rem; text-align: center; font-size: 0.8rem; font-weight: 600; color: var(--text-dim); text-transform: uppercase;">
                                            Status</th>
                                        <th
                                            style="padding: 1rem 1.5rem; text-align: center; font-size: 0.8rem; font-weight: 600; color: var(--text-dim); text-transform: uppercase;">
                                            Featured</th>
                                        <th
                                            style="padding: 1rem 1.5rem; text-align: center; font-size: 0.8rem; font-weight: 600; color: var(--text-dim); text-transform: uppercase;">
                                            Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (categories && categories.length===0) { %>
                                        <tr>
                                            <td colspan="6"
                                                style="text-align: center; padding: 4rem; color: var(--text-dim);">
                                                <i class="fa fa-list"
                                                    style="font-size: 2rem; display: block; margin-bottom: 0.5rem;"></i>
                                                No categories found
                                            </td>
                                        </tr>
                                        <% } else if (categories) { %>
                                            <% categories.forEach(cat=> { %>
                                                <tr id="row-<%=cat._id%>" class="rowCount"
                                                    style="border-bottom: 1px solid var(--border); transition: background 0.15s;"
                                                    onmouseover="this.style.background='rgba(255,255,255,0.02)'"
                                                    onmouseout="this.style.background='transparent'">
                                                    <td style="padding: 1rem 1.5rem;">
                                                        <div style="display: flex; align-items: center; gap: 1rem;">
                                                            <div
                                                                style="width: 40px; height: 40px; border-radius: 8px; background: <%= cat.color %>; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                                                <i class="fa <%= cat.icon %>"
                                                                    style="color: white; font-size: 1.1rem;"></i>
                                                            </div>
                                                            <div>
                                                                <div
                                                                    style="font-weight: 500; color: #fff; font-size: 0.95rem;">
                                                                    <%= cat.name %>
                                                                </div>
                                                                <div
                                                                    style="font-size: 0.78rem; color: var(--text-dim);">
                                                                    ID: <%= cat._id.toString().slice(-8) %>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td style="padding: 1rem 1.5rem;">
                                                        <div
                                                            style="font-size: 0.9rem; color: var(--text-muted); max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                            <%= cat.description || '—' %>
                                                        </div>
                                                    </td>
                                                    <td style="padding: 1rem 1.5rem; text-align: center;">
                                                        <span
                                                            style="background: rgba(52, 152, 219, 0.1); color: #3498DB; padding: 0.3rem 0.8rem; border-radius: 2rem; font-weight: 500; font-size: 0.85rem;">
                                                            <%= cat.eventCount %>
                                                        </span>
                                                    </td>
                                                    <td style="padding: 1rem 1.5rem; text-align: center;">
                                                        <% if (cat.status==='Active' ) { %>
                                                            <span
                                                                style="background: rgba(46, 204, 113, 0.1); color: #2ECC71; padding: 0.3rem 0.7rem; border-radius: 2rem; font-weight: 500; font-size: 0.8rem;">ACTIVE</span>
                                                            <% } else { %>
                                                                <span
                                                                    style="background: rgba(231, 76, 60, 0.1); color: #e74c3c; padding: 0.3rem 0.7rem; border-radius: 2rem; font-weight: 500; font-size: 0.8rem;">INACTIVE</span>
                                                                <% } %>
                                                    </td>
                                                    <td style="padding: 1rem 1.5rem; text-align: center;">
                                                        <% if (cat.featured) { %>
                                                            <i class="fa fa-star"
                                                                style="color: #f1c40f; font-size: 1.1rem;"></i>
                                                            <% } else { %>
                                                                <i class="fa fa-star"
                                                                    style="color: var(--text-dim); font-size: 1.1rem; opacity: 0.3;"></i>
                                                                <% } %>
                                                    </td>
                                                    <td style="padding: 1rem 1.5rem; text-align: center;">
                                                        <div
                                                            style="display: flex; gap: 0.5rem; justify-content: center;">
                                                            <button class="btn btn-outline editCategoryBtn"
                                                                data-id="<%= cat._id %>"
                                                                style="padding: 0.5rem; width: 36px; height: 36px;"
                                                                title="Edit">
                                                                <i class="fa fa-edit"></i>
                                                            </button>
                                                            <button class="btn btn-outline deleteCategoryBtn"
                                                                data-id="<%= cat._id %>"
                                                                style="padding: 0.5rem; width: 36px; height: 36px; color: #e74c3c;"
                                                                title="Delete">
                                                                <i class="fa fa-trash"></i>
                                                            </button>
                                                        </div>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </main>
            </div>

            <%- include('partials/scripts') %>

                <script>
                    document.getElementById('createCategoryBtn').addEventListener('click', () => {
                        window.location.href = '/admin/categories/create';
                    });

                    document.querySelectorAll('.editCategoryBtn').forEach(btn => {
                        btn.addEventListener('click', (e) => {
                            const id = btn.dataset.id;
                            window.location.href = `/admin/categories/edit/${id}`;
                        });
                    });

                    document.querySelectorAll('.deleteCategoryBtn').forEach(btn => {
                        btn.addEventListener('click', async (e) => {
                            const id = btn.dataset.id;
                            const confirmed = await Confirmation.show({
                                title: 'Delete Category?',
                                message: 'Are you sure you want to delete this category? This action cannot be undone.',
                                confirmText: 'Yes, Delete',
                                cancelText: 'Keep it',
                                type: 'delete' // This triggers your red 'delete' theme
                            });
                            if (confirmed) {
                                try {
                                    const response = await fetch(`/admin/categories/delete/${id}`, {
                                        method: 'POST',
                                        headers: {
                                            'Content-Type': 'application/json',
                                        }
                                    });

                                    const result = await response.json();
                                    console.log(result, response)

                                    if (response.ok) {
                                        const rowCount = document.querySelectorAll('.rowCount').length
                                        console.log(rowCount);
                                        if (rowCount !== 1) {
                                            document.getElementById(`row-${id}`).remove();
                                            showToast(result.message, 'success');
                                        } else {
                                            
                                             showToast(result.message, 'success');
                                            setTimeout(() => {
                                               window.location.reload()
                                            }, 1000)
                                        }

                                    } else {
                                        showToast('Failed to delete category.', 'error')
                                    }
                                } catch (error) {
                                    console.error('Error:', error);
                                    showToast('An error occurred while connecting to the server.', 'error');
                                }
                            }
                        });
                    });
                </script>
    </body>

</html>