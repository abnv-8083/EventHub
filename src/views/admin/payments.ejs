<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Payout Requests | Admin' }) %>

<body>

    <%- include('../partials/header-admin') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar-admin') %>

        <main class="dashboard-main animate">

            <!-- ── Page Header ── -->
            <div style="margin-bottom: 2.5rem; display: flex; justify-content: space-between; align-items: flex-end;">
                <div>
                    <h1 style="font-size: 1.8rem; margin: 0;">Payout <span class="text-gradient">Requests</span></h1>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem;">
                        Review organizer payout requests and process manual bank transfers.
                    </p>
                </div>
                <div style="display: flex; gap: 0.75rem;">
                    <div class="stat-mini">
                        <span class="label">Showing</span>
                        <span class="value"><%= payments.length %></span>
                    </div>
                </div>
            </div>

            <!-- ── Status Filter Tabs ── -->
            <div style="margin-bottom: 2rem;">
                <div style="display: flex; gap: 1rem; border-bottom: 1px solid var(--border); padding-bottom: 0;">
                    <% ['Pending','Approved','Rejected'].forEach(s => { %>
                        <a href="/admin/payments?status=<%= s %>"
                            style="padding: 0.75rem 0; font-size: 0.9rem; font-weight: 600; text-decoration: none; border-bottom: 2px solid <%= currentStatus === s ? 'var(--primary)' : 'transparent' %>; color: <%= currentStatus === s ? 'var(--primary)' : 'var(--text-muted)' %>; transition: all 0.2s; margin-bottom: -1px;">
                            <% const icons = { Pending: 'fa-clock', Approved: 'fa-check-circle', Rejected: 'fa-times-circle' }; %>
                            <i class="fa <%= icons[s] %>" style="margin-right: 0.4rem;"></i><%= s %>
                        </a>
                    <% }) %>
                </div>
            </div>

            <!-- ── Payments Table ── -->
            <div class="card" style="padding: 0; overflow: hidden; border-color: var(--border);">
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Event</th>
                            <th>Organizer</th>
                            <th>Bank Details</th>
                            <th style="text-align:center;">Net Amount</th>
                            <th style="text-align:center;">Requested</th>
                            <th style="text-align:right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (payments && payments.length > 0) { %>
                            <% payments.forEach(payment => { %>
                                <tr>
                                    <!-- Event -->
                                    <td>
                                        <div style="font-weight: 600; font-size: 0.95rem; color: #fff;">
                                            <%= payment.eventId ? payment.eventId.title : 'Unknown Event' %>
                                        </div>
                                        <div class="secondary">
                                            <%= payment.eventId ? new Date(payment.eventId.startDate).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) : '—' %>
                                        </div>
                                    </td>

                                    <!-- Organizer -->
                                    <td>
                                        <div style="font-size: 0.95rem; color: #fff;">
                                            <%= payment.organizerId ? payment.organizerId.organizationName : 'Unknown' %>
                                        </div>
                                    </td>

                                    <!-- Bank Details -->
                                    <td>
                                        <div style="font-weight: 600; font-size: 0.88rem; color: #fff;">
                                            <%= payment.bankDetails.accountHolder %>
                                        </div>
                                        <div class="secondary" style="font-size: 0.78rem;">
                                            <%= payment.bankDetails.bankName %> &nbsp;·&nbsp;
                                            <span style="font-family: monospace;"><%= payment.bankDetails.ifscCode %></span>
                                        </div>
                                        <div class="secondary" style="font-size: 0.78rem;">
                                            A/C: <span style="font-family: monospace;"><%= payment.bankDetails.accountNumber %></span>
                                            <% if (payment.bankDetails.branchName) { %>
                                                &nbsp;·&nbsp; <%= payment.bankDetails.branchName %>
                                            <% } %>
                                        </div>
                                    </td>

                                    <!-- Net Amount -->
                                    <td style="text-align: center;">
                                        <div style="font-size: 1rem; font-weight: 800; color: #2ecc71;">
                                            ₹<%= payment.netAmount.toLocaleString('en-IN') %>
                                        </div>
                                        <div class="secondary" style="font-size: 0.75rem;">
                                            of ₹<%= payment.grossRevenue.toLocaleString('en-IN') %> gross
                                        </div>
                                    </td>

                                    <!-- Requested On -->
                                    <td style="text-align: center;">
                                        <div style="font-size: 0.88rem; color: #fff;">
                                            <%= new Date(payment.createdAt).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %>
                                        </div>
                                        <div class="secondary" style="font-size: 0.75rem;">
                                            <%= new Date(payment.createdAt).toLocaleTimeString('en-IN', { hour:'2-digit', minute:'2-digit' }) %>
                                        </div>
                                    </td>

                                    <!-- Action -->
                                    <td style="text-align: right;">
                                        <div style="display: flex; gap: 0.5rem; justify-content: flex-end; align-items: center;">

                                            <% if (payment.status === 'Pending') { %>
                                                <!-- Approve -->
                                                <button onclick="openApproveModal('<%= payment._id %>')"
                                                    class="btn btn-primary"
                                                    style="padding: 0.4rem 0.85rem; background: #2ecc71; border-color: #2ecc71; border-radius: 8px; font-size: 0.82rem;">
                                                    <i class="fa fa-check"></i> Approve
                                                </button>
                                                <!-- Reject -->
                                                <button onclick="openRejectModal('<%= payment._id %>')"
                                                    class="btn btn-outline"
                                                    style="padding: 0.4rem 0.85rem; color: #e74c3c; border-color: #e74c3c; border-radius: 8px; font-size: 0.82rem;">
                                                    <i class="fa fa-times"></i> Reject
                                                </button>

                                            <% } else if (payment.status === 'Approved') { %>
                                                <div style="display: flex; flex-direction: column; align-items: flex-end; gap: 0.4rem;">
                                                    <span style="font-size: 0.8rem; padding: 0.3rem 0.85rem; background: rgba(46,204,113,0.1); border: 1px solid rgba(46,204,113,0.3); color: #2ecc71; border-radius: 20px;">
                                                        <i class="fa fa-check-circle" style="margin-right:0.3rem;"></i>Approved
                                                    </span>
                                                    <% if (payment.utr) { %>
                                                        <span style="font-family: monospace; font-size: 0.75rem; color: var(--text-dim);">UTR: <%= payment.utr %></span>
                                                    <% } %>
                                                </div>

                                            <% } else if (payment.status === 'Rejected') { %>
                                                <span style="font-size: 0.8rem; padding: 0.3rem 0.85rem; background: rgba(231,76,60,0.1); border: 1px solid rgba(231,76,60,0.3); color: #e74c3c; border-radius: 20px;"
                                                    title="<%= payment.rejectionReason %>">
                                                    <i class="fa fa-times-circle" style="margin-right:0.3rem;"></i>Rejected
                                                </span>
                                            <% } %>

                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        <% } else { %>
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 5rem; color: var(--text-dim);">
                                    <i class="fa fa-hand-holding-usd" style="font-size: 3rem; opacity: 0.1; display: block; margin-bottom: 1.5rem;"></i>
                                    No <%= currentStatus.toLowerCase() %> payout requests.
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

        </main>
    </div>

    <!-- ── Approve Modal ── -->
    <div id="approveModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); backdrop-filter:blur(6px); z-index:9999; align-items:center; justify-content:center;">
        <div class="card animate" style="width:100%; max-width:460px; padding:2.5rem; margin:1rem; border-color: rgba(46,204,113,0.3);">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.25rem;">
                <div style="width:38px; height:38px; border-radius:10px; background:rgba(46,204,113,0.12); display:flex; align-items:center; justify-content:center; color:#2ecc71;">
                    <i class="fa fa-check-circle"></i>
                </div>
                <div>
                    <h2 style="margin:0; font-size:1.15rem;">Approve Payout</h2>
                    <p style="margin:0; font-size:0.8rem; color:var(--text-muted);">Enter the UTR after completing the bank transfer.</p>
                </div>
            </div>

            <form id="approveForm" novalidate>
                <input type="hidden" id="approvePaymentId">
                <div class="form-group" style="margin-bottom:1.25rem;">
                    <label class="label" style="display:flex; justify-content:space-between; align-items:center;">
                        <span>UTR / Transaction Reference <span style="color:#e74c3c; font-size:0.78rem;">*required</span></span>
                        <span id="utrHint" style="font-size:0.75rem; color:var(--text-dim);">8–22 characters</span>
                    </label>
                    <div style="position:relative;">
                        <input type="text" id="utrInput" class="input v-field"
                            placeholder="e.g. 412345678901"
                            style="letter-spacing:0.5px; padding-right:2.5rem;"
                            autocomplete="off" />
                        <span id="utrIcon" style="position:absolute; right:0.9rem; top:50%; transform:translateY(-50%); font-size:0.9rem; transition:all 0.3s;"></span>
                    </div>
                    <span id="utrError" class="v-error" style="display:none;"></span>
                </div>
                <div style="display:flex; gap:0.75rem; justify-content:flex-end; margin-top:1.5rem;">
                    <button type="button" class="btn btn-outline" onclick="closeApproveModal()">Cancel</button>
                    <button type="submit" id="approveSubmitBtn" class="btn btn-primary"
                        style="background:#2ecc71; border-color:#2ecc71; padding:0.6rem 1.5rem;">
                        <i class="fa fa-check" style="margin-right:0.4rem;"></i>Approve & Send Refund
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ── Reject Modal ── -->
    <div id="rejectModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.75); backdrop-filter:blur(6px); z-index:9999; align-items:center; justify-content:center;">
        <div class="card animate" style="width:100%; max-width:460px; padding:2.5rem; margin:1rem; border-color: rgba(231,76,60,0.3);">
            <div style="display:flex; align-items:center; gap:0.75rem; margin-bottom:1.25rem;">
                <div style="width:38px; height:38px; border-radius:10px; background:rgba(231,76,60,0.1); display:flex; align-items:center; justify-content:center; color:#e74c3c;">
                    <i class="fa fa-times-circle"></i>
                </div>
                <div>
                    <h2 style="margin:0; font-size:1.15rem;">Reject Payout</h2>
                    <p style="margin:0; font-size:0.8rem; color:var(--text-muted);">Organizer will see this reason on their payment page.</p>
                </div>
            </div>

            <form id="rejectForm" novalidate>
                <input type="hidden" id="rejectPaymentId">
                <div class="form-group" style="margin-bottom:1.25rem;">
                    <label class="label" style="display:flex; justify-content:space-between; align-items:center;">
                        <span>Rejection Reason <span style="color:#e74c3c; font-size:0.78rem;">*required</span></span>
                        <span id="rejectCharCount" style="font-size:0.75rem; color:var(--text-dim);">0 / 300</span>
                    </label>
                    <textarea id="rejectReason" class="input v-field" rows="3"
                        placeholder="e.g. Bank account details are incorrect. Please resubmit with correct IFSC."
                        style="resize:none;" maxlength="300"></textarea>
                    <span id="rejectError" class="v-error" style="display:none;"></span>
                </div>
                <div style="display:flex; gap:0.75rem; justify-content:flex-end; margin-top:1.5rem;">
                    <button type="button" class="btn btn-outline" onclick="closeRejectModal()">Cancel</button>
                    <button type="submit" id="rejectSubmitBtn" class="btn btn-primary"
                        style="background:#e74c3c; border-color:#e74c3c; padding:0.6rem 1.5rem;">
                        <i class="fa fa-times" style="margin-right:0.4rem;"></i>Confirm Reject
                    </button>
                </div>
            </form>
        </div>
    </div>

    <style>
        .stat-mini {
            background: rgba(255,255,255,0.03);
            padding: 0.5rem 1rem;
            border-radius: 10px;
            border: 1px solid var(--border);
            text-align: right;
        }
        .stat-mini .label { display: block; font-size: 0.7rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; }
        .stat-mini .value { font-size: 1.2rem; font-weight: 700; color: #fff; }

        /* ── Inline Validation ── */
        .v-field { transition: border-color 0.25s, box-shadow 0.25s; }
        .v-field.v-invalid {
            border-color: #e74c3c !important;
            box-shadow: 0 0 0 3px rgba(231,76,60,0.15) !important;
        }
        .v-field.v-valid {
            border-color: #2ecc71 !important;
            box-shadow: 0 0 0 3px rgba(46,204,113,0.12) !important;
        }
        .v-error {
            display: block;
            margin-top: 0.4rem;
            font-size: 0.78rem;
            font-weight: 600;
            color: #e74c3c;
            animation: v-shake 0.3s ease;
        }
        @keyframes v-shake {
            0%,100% { transform: translateX(0); }
            25%      { transform: translateX(-4px); }
            75%      { transform: translateX(4px); }
        }
    </style>

    <%- include('../partials/footer-scripts') %>
    <script src="/js/ajax-handler.js"></script>
    <script>
        // ─── Validation helpers ────────────────────────────────────────
        function setValid(field, iconEl, errEl) {
            field.classList.remove('v-invalid');
            field.classList.add('v-valid');
            if (iconEl) { iconEl.innerHTML = '<i class="fa fa-check-circle" style="color:#2ecc71;"></i>'; }
            if (errEl)  { errEl.style.display = 'none'; }
        }
        function setInvalid(field, iconEl, errEl, msg) {
            field.classList.remove('v-valid');
            field.classList.add('v-invalid');
            if (iconEl) { iconEl.innerHTML = '<i class="fa fa-exclamation-circle" style="color:#e74c3c;"></i>'; }
            if (errEl)  {
                // Re-trigger animation
                errEl.style.display = 'none';
                void errEl.offsetWidth;
                errEl.textContent = msg;
                errEl.style.display = 'block';
            }
        }
        function clearState(field, iconEl, errEl) {
            field.classList.remove('v-valid','v-invalid');
            if (iconEl) iconEl.innerHTML = '';
            if (errEl)  errEl.style.display = 'none';
        }

        // ── Approve Modal ─────────────────────────────────────────────
        const utrInput  = document.getElementById('utrInput');
        const utrIcon   = document.getElementById('utrIcon');
        const utrError  = document.getElementById('utrError');
        const utrHint   = document.getElementById('utrHint');

        function validateUTR() {
            const val = utrInput.value.trim();
            if (!val) {
                setInvalid(utrInput, utrIcon, utrError, 'UTR / Transaction ID is required.');
                return false;
            }
            if (!/^[A-Za-z0-9]{8,22}$/.test(val)) {
                setInvalid(utrInput, utrIcon, utrError, 'Enter a valid UTR (8–22 alphanumeric characters).');
                return false;
            }
            setValid(utrInput, utrIcon, utrError);
            return true;
        }

        utrInput.addEventListener('input', () => {
            const len = utrInput.value.trim().length;
            utrHint.textContent = `${len} / 22 chars`;
            utrHint.style.color = len >= 8 && len <= 22 ? '#2ecc71' : (len > 0 ? '#e74c3c' : 'var(--text-dim)');
            if (utrInput.classList.contains('v-invalid') || utrInput.classList.contains('v-valid')) {
                validateUTR();
            }
        });
        utrInput.addEventListener('blur', validateUTR);

        function openApproveModal(id) {
            document.getElementById('approvePaymentId').value = id;
            utrInput.value = '';
            utrHint.textContent = '8–22 characters';
            utrHint.style.color = 'var(--text-dim)';
            clearState(utrInput, utrIcon, utrError);
            document.getElementById('approveModal').style.display = 'flex';
            setTimeout(() => utrInput.focus(), 150);
        }
        function closeApproveModal() {
            document.getElementById('approveModal').style.display = 'none';
        }
        document.getElementById('approveForm').addEventListener('submit', function (e) {
            e.preventDefault();
            if (!validateUTR()) { utrInput.focus(); return; }
            const id  = document.getElementById('approvePaymentId').value;
            const utr = utrInput.value.trim();
            const btn = document.getElementById('approveSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin" style="margin-right:0.4rem;"></i>Processing...';
            window.submitFormAjax({
                action: `/admin/payments/${id}/approve`,
                method: 'PATCH',
                data:   { utr }
            });
        });

        // ── Reject Modal ──────────────────────────────────────────────
        const rejectReason    = document.getElementById('rejectReason');
        const rejectError     = document.getElementById('rejectError');
        const rejectCharCount = document.getElementById('rejectCharCount');

        function validateReject() {
            const val = rejectReason.value.trim();
            if (!val) {
                setInvalid(rejectReason, null, rejectError, 'Rejection reason is required.');
                return false;
            }
            if (val.length < 10) {
                setInvalid(rejectReason, null, rejectError, 'Please provide a more descriptive reason (min 10 characters).');
                return false;
            }
            setValid(rejectReason, null, rejectError);
            return true;
        }

        rejectReason.addEventListener('input', () => {
            const len = rejectReason.value.length;
            rejectCharCount.textContent = `${len} / 300`;
            rejectCharCount.style.color = len >= 10 ? '#2ecc71' : (len > 0 ? '#e67e22' : 'var(--text-dim)');
            if (rejectReason.classList.contains('v-invalid') || rejectReason.classList.contains('v-valid')) {
                validateReject();
            }
        });
        rejectReason.addEventListener('blur', validateReject);

        function openRejectModal(id) {
            document.getElementById('rejectPaymentId').value = id;
            rejectReason.value = '';
            rejectCharCount.textContent = '0 / 300';
            rejectCharCount.style.color = 'var(--text-dim)';
            clearState(rejectReason, null, rejectError);
            document.getElementById('rejectModal').style.display = 'flex';
            setTimeout(() => rejectReason.focus(), 150);
        }
        function closeRejectModal() {
            document.getElementById('rejectModal').style.display = 'none';
        }
        document.getElementById('rejectForm').addEventListener('submit', function (e) {
            e.preventDefault();
            if (!validateReject()) { rejectReason.focus(); return; }
            const id     = document.getElementById('rejectPaymentId').value;
            const reason = rejectReason.value.trim();
            const btn    = document.getElementById('rejectSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fa fa-spinner fa-spin" style="margin-right:0.4rem;"></i>Processing...';
            window.submitFormAjax({
                action: `/admin/payments/${id}/reject`,
                method: 'PATCH',
                data:   { reason }
            });
        });

        // Close modals on backdrop click
        ['approveModal','rejectModal'].forEach(id => {
            document.getElementById(id).addEventListener('click', function(e) {
                if (e.target === this) this.style.display = 'none';
            });
        });
    </script>

</body>
</html>
