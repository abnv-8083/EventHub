<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Create Organizer | Admin Hub' }) %>

<body>

    <%- include('../partials/header-admin') %>

    <div class="dashboard-layout">
                <%- include('../partials/sidebar-admin') %>

        <main class="dashboard-main animate">
            <div class="d-flex align-center gap-3 mb-5">
                <a href="organizers" class="btn btn-outline"
                    style="padding: 0.5rem; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                    <i class="fa fa-arrow-left"></i>
                </a>
                <div>
                    <h1 style="font-size: 1.8rem;">Create New <span class="text-gradient">Organizer</span></h1>
                    <p style="color: var(--text-muted);">Set up a new organization or business profile.</p>
                </div>
            </div>

            <div class="card glass" style="padding: 3rem; max-width: 900px; margin: 0 auto; border-radius: 20px;">
                <form action="organizers">
                    <div style="display: grid; grid-template-columns: 200px 1fr; gap: 3rem;">
                        <!-- Logo Upload Section -->
                        <div style="text-align: center;">
                            <div style="width: 150px; height: 150px; background: var(--bg-surface); border: 2px dashed var(--border); border-radius: 12px; display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; transition: var(--transition);"
                                class="mb-3" onmouseover="this.style.borderColor='var(--primary)'"
                                onmouseout="this.style.borderColor='var(--border)'">
                                <i class="fa fa-camera" style="font-size: 2rem; color: var(--text-dim);"
                                    class="mb-1"></i>
                                <span style="font-size: 0.75rem; color: var(--text-muted);">Upload Logo</span>
                            </div>
                            <p style="font-size: 0.8rem; color: var(--text-dim);">Recommended: 500x500px<br>PNG or JPG
                            </p>
                        </div>

                        <!-- Form Details -->
                        <div>
                            <div
                                style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                                <div class="form-group">
                                    <label class="label">Organization Name</label>
                                    <input type="text" class="input glass-dark" placeholder="e.g. Skyline Productions"
                                        required>
                                </div>
                                <div class="form-group">
                                    <label class="label">Business Category</label>
                                    <select class="input glass-dark" style="appearance: none;">
                                        <option value="entertainment">Entertainment</option>
                                        <option value="corporate">Corporate</option>
                                        <option value="tech">Technology</option>
                                        <option value="sports">Sports</option>
                                        <option value="other">Other</option>
                                    </select>
                                </div>
                            </div>

                            <div
                                style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                                <div class="form-group">
                                    <label class="label">Primary Email</label>
                                    <input type="email" class="input glass-dark" placeholder="contact@example.com"
                                        required>
                                </div>
                                <div class="form-group">
                                    <label class="label">Password (System Generated)</label>
                                    <input type="text" class="input glass-dark" placeholder="Click to generate..."
                                        readonly>
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom: 1.5rem;">
                                <label class="label">Bio / Description</label>
                                <textarea class="input glass-dark" style="min-height: 120px; resize: vertical;"
                                    placeholder="Briefly describe the organization's mission and event focus..."></textarea>
                            </div>

                            <div
                                style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
                                <div class="form-group">
                                    <label class="label">Website (Optional)</label>
                                    <input type="url" class="input glass-dark" placeholder="https://example.com">
                                </div>
                                <div class="form-group">
                                    <label class="label">Location / HQ</label>
                                    <input type="text" class="input glass-dark" placeholder="e.g. New York, USA">
                                </div>
                            </div>

                            <div
                                style="display: flex; gap: 1rem; margin-top: 2rem; border-top: 1px solid var(--border); padding-top: 2rem;">
                                <button type="submit" class="btn btn-primary" style="padding: 1rem 3rem;">
                                    <i class="fa fa-user-plus"></i> Create Profile
                                </button>
                                <button type="reset" class="btn btn-outline" style="padding: 1rem 2rem;">
                                    Discard
                                </button>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <%- include('partials/scripts') %>
</body>

</html>



