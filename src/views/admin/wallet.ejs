<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Admin Wallet | Admin Hub' }) %>

<body>

    <%- include('../partials/header-admin') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar-admin') %>

        <main class="dashboard-main animate">
            <div style="margin-bottom: 2.5rem; display: flex; justify-content: space-between; align-items: flex-end;">
                <div>
                    <h1 style="font-size: 1.8rem; margin: 0;">Platform <span class="text-gradient">Wallet</span></h1>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem;">Manage platform revenue, transactions, and event statuses.</p>
                </div>
            </div>

            <!-- Wallet Overview -->
            <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; margin-bottom: 3rem;">
                <div class="card glass" style="padding: 2rem; border-radius: 20px; background: linear-gradient(135deg, rgba(230, 57, 70, 0.1) 0%, rgba(230, 57, 70, 0.02) 100%); border: 1px solid rgba(230, 57, 70, 0.2);">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                        <span style="color: var(--text-muted); font-size: 0.9rem; font-weight: 500; text-transform: uppercase; letter-spacing: 1px;">Current Balance</span>
                        <i class="fa fa-wallet" style="color: var(--primary); font-size: 1.2rem;"></i>
                    </div>
                    <div style="font-size: 2.5rem; font-weight: 800; color: #fff; margin-bottom: 0.5rem;">₹<%= wallet.balance.toLocaleString('en-IN') %></div>
                    <p style="color: var(--text-dim); font-size: 0.8rem;">Last updated: <%= new Date(wallet.lastUpdated).toLocaleString() %></p>
                </div>

                <div class="card" style="padding: 1.5rem; border-radius: 20px;">
                    <h3 style="font-size: 1.1rem; margin-bottom: 1.5rem;">Financial Overview</h3>
                    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;">
                        <div class="stat-item">
                            <span class="label">Total Fee Collected</span>
                            <span class="value" style="color: #2ecc71;">₹<%= wallet.balance.toLocaleString('en-IN') %></span>
                        </div>
                        <div class="stat-item">
                            <span class="label">Total Transactions</span>
                            <span class="value"><%= transactions.length %></span>
                        </div>
                        <div class="stat-item">
                            <span class="label">Pending Events</span>
                            <span class="value" style="color: #e67e22;"><%= pendingEvents.length %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Transactions Section -->
            <div style="margin-top: 2rem;">
                <h3 style="font-size: 1.1rem; margin-bottom: 1.5rem;">Recent Transactions</h3>
                <div class="card" style="padding: 0; overflow: hidden;">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Transaction Details</th>
                                <th>Source ID</th>
                                <th>Event</th>
                                <th style="text-align: right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (transactions && transactions.length > 0) { %>
                                <% transactions.forEach(tx => { %>
                                    <tr>
                                        <td>
                                            <div style="font-weight: 600;"><%= tx.description %></div>
                                            <div style="font-size: 0.75rem; color: var(--text-dim);"><%= new Date(tx.createdAt).toLocaleString() %></div>
                                        </td>
                                        <td>
                                            <span style="font-family: monospace; font-size: 0.85rem; background: rgba(255,255,255,0.05); padding: 0.2rem 0.5rem; border-radius: 4px;">
                                                <% if (tx.payoutId) { %>
                                                    PAY-<%= tx.payoutId._id.toString().slice(-6).toUpperCase() %>
                                                <% } else if (tx.bookingId) { %>
                                                    BOK-<%= tx.bookingId._id.toString().slice(-6).toUpperCase() %>
                                                <% } else { %>
                                                    N/A
                                                <% } %>
                                            </span>
                                        </td>
                                        <td>
                                            <div style="font-size: 0.9rem;">
                                                <% if (tx.payoutId && tx.payoutId.eventId) { %>
                                                    <%= tx.payoutId.eventId.title %>
                                                <% } else if (tx.bookingId && tx.bookingId.eventId) { %>
                                                    <%= tx.bookingId.eventId.title %>
                                                <% } else { %>
                                                    Deleted Event
                                                <% } %>
                                            </div>
                                        </td>
                                        <td style="text-align: right; font-weight: 700; color: #2ecc71;">
                                            + ₹<%= tx.amount.toLocaleString('en-IN') %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="4" style="text-align: center; padding: 4rem; color: var(--text-dim);">No transactions yet.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

    <style>
        .tab-btn {
            background: none;
            border: none;
            color: var(--text-muted);
            padding: 1rem 0;
            cursor: pointer;
            font-weight: 500;
            position: relative;
            display: flex;
            align-items: center;
            gap: 0.8rem;
            transition: all 0.3s ease;
        }
        .tab-btn:hover { color: #fff; }
        .tab-btn.active { color: var(--primary); }
        .tab-btn.active::after {
            content: '';
            position: absolute;
            bottom: -1px;
            left: 0;
            width: 100%;
            height: 2px;
            background: var(--primary);
        }
        .count-badge {
            background: rgba(255,255,255,0.05);
            padding: 0.1rem 0.5rem;
            border-radius: 10px;
            font-size: 0.75rem;
        }
        .tab-btn.active .count-badge {
            background: rgba(230, 57, 70, 0.1);
            color: var(--primary);
        }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        .stat-item {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }
        .stat-item .label {
            font-size: 0.75rem;
            color: var(--text-dim);
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        .stat-item .value {
            font-size: 1.5rem;
            font-weight: 700;
            color: #fff;
        }
    </style>

    <%- include('../partials/footer-scripts') %>
    <script>
        function switchTab(tabId) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            
            document.getElementById('tab-' + tabId).classList.add('active');
            document.getElementById('content-' + tabId).classList.add('active');
        }
    </script>
</body>

</html>
