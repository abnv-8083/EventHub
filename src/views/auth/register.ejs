<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Register' }) %>

    <body
        style="height: 100vh; overflow: hidden; margin: 0; padding: 0; display: flex; font-family: 'Outfit', sans-serif;">
<!-- Left Side: Typography and Imagery -->
        <div class="d-none d-lg-flex flex-column justify-content-between"
            style="width: 50%; background: linear-gradient(135deg, rgba(10, 10, 10, 0.8), rgba(230, 57, 70, 0.8)), url('https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&q=80&w=1600') center/cover; padding: 4rem; position: relative;">
            <!-- Logo -->
            <div>
                <a href="/" class="logo" style="font-size: 2rem; color: #ffffff;">EVENT<span>HUB</span></a>
            </div>

            <!-- Typography -->
            <div style="margin-bottom: 4rem;">
                <h1
                    style="font-size: 4rem; font-weight: 700; line-height: 1.1; margin-bottom: 1.5rem; color: #ffffff; letter-spacing: -1.5px;">
                    Start Your<br>Journey<br>With Us.
                </h1>
                <p style="font-size: 1.25rem; color: rgba(255, 255, 255, 0.85); max-width: 450px; line-height: 1.6;">
                    Create an account to unlock exclusive access, seamless ticketing, and unforgettable memories
                    tailored just for you.
                </p>
            </div>

            <!-- Footer Info -->
            <div style="color: rgba(255, 255, 255, 0.6); font-size: 0.9rem;">
                &copy; 2026 EventHub Inc. All rights reserved.
            </div>
        </div>

        <!-- Right Side: Plain Form Page (Dark Theme) -->
        <div style="flex: 1; background: var(--bg-surface); display: flex; padding: 2rem; overflow-y: auto;">
            <div style="width: 100%; max-width: 460px; margin: auto; padding-top: 2rem; padding-bottom: 2rem;">

                <!-- Mobile Logo -->
                <div class="d-block d-lg-none" style="text-align: center; margin-bottom: 2rem;">
                    <a href="/" class="logo"
                        style="justify-content: center; font-size: 2.5rem; color: #ffffff;">EVENT<span>HUB</span></a>
                </div>

                <div style="margin-bottom: 2rem;">
                    <h2
                        style="font-size: 2rem; letter-spacing: -1px; margin-bottom: 0.5rem; color: #ffffff; font-weight: 700;">
                        Join EventHub</h2>
                    <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 0;">Experience the most modern
                        event platform.</p>
                </div>

                <form class="needs-validation" action="/user/signup" method="POST">

                    <div style="margin-bottom: 1rem;">
                        <label
                            style="display: block; font-size: 0.9rem; margin-bottom: 0.4rem; color: var(--text-muted); font-weight: 500;">Full
                            Name</label>
                        <input type="text" name="name" required minlength="5" placeholder="John Doe"
                            style="width: 100%; padding: 0.9rem 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; color: #ffffff; font-size: 1rem; transition: all 0.2s; outline: none;"
                            onfocus="this.style.borderColor='var(--primary)'; this.style.boxShadow='0 0 0 4px rgba(230, 57, 70, 0.1)';"
                            onblur="this.style.borderColor='var(--border)'; this.style.boxShadow='none';">
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                        <div>
                            <label
                                style="display: block; font-size: 0.9rem; margin-bottom: 0.4rem; color: var(--text-muted); font-weight: 500;">Email
                                Address</label>
                            <input type="email" name="email" required placeholder="john@example.com"
                                style="width: 100%; padding: 0.9rem 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; color: #ffffff; font-size: 1rem; transition: all 0.2s; outline: none;"
                                onfocus="this.style.borderColor='var(--primary)'; this.style.boxShadow='0 0 0 4px rgba(230, 57, 70, 0.1)';"
                                onblur="this.style.borderColor='var(--border)'; this.style.boxShadow='none';">
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.9rem; margin-bottom: 0.4rem; color: var(--text-muted); font-weight: 500;">Phone
                                Number</label>
                            <input type="tel" name="phone" required pattern="^[\d\+\-\(\)\s]{10,}$"
                                placeholder="+1 (555) 000-0000"
                                style="width: 100%; padding: 0.9rem 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; color: #ffffff; font-size: 1rem; transition: all 0.2s; outline: none;"
                                onfocus="this.style.borderColor='var(--primary)'; this.style.boxShadow='0 0 0 4px rgba(230, 57, 70, 0.1)';"
                                onblur="this.style.borderColor='var(--border)'; this.style.boxShadow='none';">
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.5rem;">
                        <div>
                            <label
                                style="display: block; font-size: 0.9rem; margin-bottom: 0.4rem; color: var(--text-muted); font-weight: 500;">Password</label>
                            <div class="password-group">
                                <input type="password" name="password" required minlength="6" placeholder="••••••••"
                                    style="width: 100%; padding: 0.9rem 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; color: #ffffff; font-size: 1rem; transition: all 0.2s; outline: none;"
                                    onfocus="this.style.borderColor='var(--primary)'; this.style.boxShadow='0 0 0 4px rgba(230, 57, 70, 0.1)';"
                                    onblur="this.style.borderColor='var(--border)'; this.style.boxShadow='none';">
                                <button type="button" class="password-toggle" aria-label="Show Password">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                        <div>
                            <label
                                style="display: block; font-size: 0.9rem; margin-bottom: 0.4rem; color: var(--text-muted); font-weight: 500;">Confirm
                                Password</label>
                            <div class="password-group">
                                <input type="password" required minlength="6" placeholder="••••••••"
                                    style="width: 100%; padding: 0.9rem 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; color: #ffffff; font-size: 1rem; transition: all 0.2s; outline: none;"
                                    onfocus="this.style.borderColor='var(--primary)'; this.style.boxShadow='0 0 0 4px rgba(230, 57, 70, 0.1)';"
                                    onblur="this.style.borderColor='var(--border)'; this.style.boxShadow='none';">
                                <button type="button" class="password-toggle" aria-label="Show Password">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; align-items: flex-start; gap: 0.8rem; margin-bottom: 1.75rem;">
                        <input type="checkbox" id="terms" required style="margin-top: 0.25rem;">
                        <label for="terms"
                            style="font-size: 0.85rem; color: var(--text-muted); cursor: pointer; line-height: 1.4;">
                            I agree to the <a href="terms" style="color: var(--primary); font-weight: 500;">Terms of
                                Service</a> and <a href="privacy"
                                style="color: var(--primary); font-weight: 500;">Privacy Policy</a>.
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary"
                        style="width: 100%; padding: 0.9rem; border-radius: 12px; font-size: 1.05rem; font-weight: 600; box-shadow: 0 4px 14px rgba(230, 57, 70, 0.3);">
                        Create Account
                    </button>

                    <div style="display: flex; align-items: center; gap: 1rem; margin: 1.75rem 0;">
                        <hr style="flex: 1; border: 0; border-top: 1px solid var(--border);">
                        <span
                            style="color: var(--text-dim); font-size: 0.8rem; text-transform: uppercase; font-weight: 600;">OR</span>
                        <hr style="flex: 1; border: 0; border-top: 1px solid var(--border);">
                    </div>

                    <a href="/user/google"><button type="button"
                            style="width: 100%; padding: 0.9rem; border-radius: 12px; display: flex; align-items: center; justify-content: center; gap: 1rem; border: 1px solid var(--border); background: var(--bg-card); color: #ffffff; font-size: 1rem; font-weight: 500; cursor: pointer; transition: all 0.2s;"
                            onmouseover="this.style.background='rgba(255,255,255,0.05)';"
                            onmouseout="this.style.background='var(--bg-card)';">
                            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="20"
                                alt="Google">
                            Sign up with Google
                        </button></a>
                </form>

                <div style="text-align: center; margin-top: 2rem; padding-top: 1.5rem;">
                    <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 0;">Already have an account?
                        <a href="/user/login"
                            style="color: var(--primary); font-weight: 700; text-decoration: underline; text-underline-offset: 4px;">Sign
                            In</a>
                    </p>
                </div>

                <!-- Mobile Footer -->
                <div class="d-block d-lg-none"
                    style="text-align: center; margin-top: 2rem; color: var(--text-dim); font-size: 0.85rem;">
                    &copy; 2026 EventHub Inc.
                </div>

            </div>
        </div>

        <%- include('../partials/footer-scripts') %>
    </body>

</html>