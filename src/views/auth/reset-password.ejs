<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Reset Password' }) %>

<body class="bg-mesh"
    style="height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden;">
<div class="floating-blob" style="top: 10%; left: 30%; opacity: 0.1;"></div>

    <div class="container" style="max-width: 450px; position: relative; z-index: 1;">
        <div class="card glass animate" style="padding: 3.5rem; text-align: center; border-radius: 24px;">
            <div
                style="width: 80px; height: 80px; background: rgba(230, 57, 70, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; border: 1px solid var(--border-red);">
                <i class="fa fa-lock-open text-gradient glow-text" style="font-size: 1.8rem;"></i>
            </div>
            <h2 style="font-size: 1.8rem; margin-bottom: 1rem; letter-spacing: -1px;">Set New Password</h2>
            <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 2.5rem;">Secure your account with a new
                master password.</p>

            <form class="needs-validation" action="/user/reset-password" method="POST">
                <div class="form-group animate stagger-1" style="text-align: left;">
                    <div class="password-group">
                        <input type="password" name="password" class="input glass-dark" placeholder="••••••••" required 
                            data-error-msg="Password requires 8 characters with upper, lower, number and special char">
                        <button type="button" class="password-toggle" aria-label="Show Password">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="form-group animate stagger-2" style="text-align: left;">
                    <div class="password-group">
                        <input type="password" name="confirm-password" class="input glass-dark" placeholder="••••••••" required 
                            data-match="password" data-error-msg="Passwords do not match">
                        <button type="button" class="password-toggle" aria-label="Show Password">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary glow-primary animate stagger-3"
                    style="width: 100%; padding: 1.2rem; margin-top: 1.5rem; border-radius: 12px; font-size: 1.1rem;">Update
                    Password</button>
            </form>
        </div>
    </div>

    <%- include('../partials/footer-scripts') %>
</body>

</html>