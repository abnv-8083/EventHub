<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Organization Profile | Organizer Portal' }) %>

<body>

    <header class="header" style="position: relative; padding: 1rem 0; border-bottom: 1px solid var(--border);">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
            <a href="/organizer/dashboard" class="logo">EVENT<span>HUB</span> <span style="font-size: 0.7rem; color: #3498DB; font-weight: 700; letter-spacing: 2px; vertical-align: middle;">CREATOR</span></a>
            <div style="display: flex; align-items: center; gap: 1.5rem;">
                <span style="color: var(--text-muted); font-size: 0.9rem;"><i class="fa fa-building" style="color: #3498DB; margin-right: 0.4rem;"></i><%= organizer.organizationName %></span>
                <form class="ajax-form m-0" action="/organizer/logout" method="POST">
                    <button type="submit" class="btn btn-outline" style="padding: 0.5rem 1rem; font-size: 0.85rem;">
                        <i class="fa fa-sign-out-alt"></i> Logout
                    </button>
                </form>
            </div>
        </div>
    </header>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar-organizer') %>

        <main class="dashboard-main animate">

            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem; border-bottom: 1px solid var(--border); padding-bottom: 1.5rem;">
                <div>
                    <h1 style="font-size: 1.8rem; margin-bottom: 0.5rem;">Organization <span class="text-gradient">Profile</span></h1>
                    <p style="color: var(--text-muted); margin: 0;">Manage your organization's public details and account info.</p>
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 320px; gap: 2rem; max-width: 1100px;">

                <!-- Org Details Form -->
                <div class="card glass" style="padding: 2.5rem; border-radius: 20px;">
                    <h3 style="font-size: 0.85rem; font-weight: 600; margin-bottom: 2rem; color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px;">Organization Details</h3>
                    <form class="ajax-form" action="/organizer/profile" method="POST">
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                            <div class="form-group mb-0" style="grid-column: 1 / -1;">
                                <label class="label">Organization Name</label>
                                <input type="text" name="organizationName" class="input glass-dark" value="<%= organizer.organizationName %>" required>
                            </div>
                            <div class="form-group mb-0">
                                <label class="label">Industry Category</label>
                                <select name="industryCategory" class="input glass-dark" required style="appearance: none;">
                                    <% ['Entertainment / Music','Technology / Software','Education / Workshops','Business / Networking','Sports / Health','Other'].forEach(cat => { %>
                                        <option value="<%= cat %>" <%= organizer.industryCategory === cat ? 'selected' : '' %>><%= cat %></option>
                                    <% }) %>
                                </select>
                            </div>
                            <div class="form-group mb-0">
                                <label class="label">Operating Region (City)</label>
                                <select name="operatingRegion" class="input glass-dark" required style="appearance: none;">
                                    <% sortedCity.forEach(city => { %>
                                        <option value="<%= city.name %>" <%= organizer.operatingRegion === city.name ? 'selected' : '' %>><%= city.name %></option>
                                    <% }) %>
                                </select>
                            </div>
                        </div>

                        <div style="border-top: 1px solid var(--border); padding-top: 2rem;">
                            <button type="submit" class="btn btn-primary" style="padding: 1rem 3rem;">
                                <i class="fa fa-save"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Info Sidebar -->
                <div style="display: flex; flex-direction: column; gap: 1.5rem;">

                    <!-- Account Avatar -->
                    <div class="card" style="padding: 2rem; border-radius: 16px; text-align: center;">
                        <div style="width: 90px; height: 90px; border-radius: 50%; overflow: hidden; background: var(--bg-surface); border: 2px solid rgba(52,152,219,0.3); display: flex; align-items: center; justify-content: center; margin: 0 auto 1rem;">
                            <% if (user.avatar_url && user.avatar_url !== 'None') { %>
                                <img src="<%= user.avatar_url %>" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover;" referrerpolicy="no-referrer">
                            <% } else { %>
                                <i class="fa fa-user" style="font-size: 2rem; color: #3498DB;"></i>
                            <% } %>
                        </div>
                        <h4 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.2rem;"><%= user.name %></h4>
                        <p style="color: var(--text-muted); font-size: 0.85rem; margin-bottom: 0.75rem;"><%= user.email %></p>
                        <span style="font-size: 0.78rem; background: rgba(46,204,113,0.1); color: #2ECC71; padding: 0.3rem 0.8rem; border-radius: 2rem;"><i class="fa fa-check-circle"></i> Verified Organizer</span>
                    </div>

                    <!-- Read-only Org Meta -->
                    <div class="card" style="padding: 1.5rem; border-radius: 16px;">
                        <h4 style="font-size: 0.8rem; color: var(--text-dim); text-transform: uppercase; letter-spacing: 1px; margin-bottom: 1.25rem;">Account Info</h4>
                        <div style="display: flex; flex-direction: column; gap: 1rem;">
                            <div>
                                <p style="color: var(--text-dim); font-size: 0.78rem; margin-bottom: 0.2rem; text-transform: uppercase;">Reference ID</p>
                                <p style="font-family: monospace; color: #3498DB; font-size: 0.85rem; margin: 0;"><%= organizer.registrationNumber %></p>
                            </div>
                            <div>
                                <p style="color: var(--text-dim); font-size: 0.78rem; margin-bottom: 0.2rem; text-transform: uppercase;">Commission Rate</p>
                                <p style="color: #fff; margin: 0;"><%= organizer.commissionRate %>%</p>
                            </div>
                            <div>
                                <p style="color: var(--text-dim); font-size: 0.78rem; margin-bottom: 0.2rem; text-transform: uppercase;">Status</p>
                                <span style="font-size: 0.78rem; background: rgba(46,204,113,0.1); color: #2ECC71; padding: 0.3rem 0.7rem; border-radius: 2rem;"><%= organizer.status %></span>
                            </div>
                            <div>
                                <p style="color: var(--text-dim); font-size: 0.78rem; margin-bottom: 0.2rem; text-transform: uppercase;">Member Since</p>
                                <p style="color: #fff; margin: 0; font-size: 0.85rem;"><%= new Date(organizer.createdAt).toLocaleDateString() %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Personal Account Link -->
                    <a href="/profile" class="card" style="padding: 1.2rem 1.5rem; border-radius: 16px; display: flex; align-items: center; gap: 1rem; text-decoration: none; transition: all 0.2s;" onmouseover="this.style.background='rgba(52,152,219,0.05)'" onmouseout="this.style.background=''">
                        <i class="fa fa-user-circle" style="font-size: 1.5rem; color: #3498DB;"></i>
                        <div>
                            <p style="margin: 0; font-weight: 500; color: #fff; font-size: 0.9rem;">Personal Account</p>
                            <p style="margin: 0; color: var(--text-dim); font-size: 0.8rem;">Edit personal profile →</p>
                        </div>
                    </a>

                </div>
            </div>
        </main>
    </div>

    <%- include('partials/scripts') %>
</body>
</html>
