<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Manage Events' }) %>

<body>

    <%- include('../partials/header') %>

    <div class="dashboard-layout">
                <%- include('../partials/sidebar-organizer') %>

        <main class="dashboard-main animate">
            <div style="display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: 2.5rem;">
                <div>
                    <h1 style="font-size: 1.8rem;">My <span class="text-gradient">Events</span></h1>
                    <p style="color: var(--text-muted);">Manage your active, pending, and past events.</p>
                </div>
            </div>

            <!-- Event Table -->
            <div class="card" style="padding: 0; overflow: hidden;">
                <table style="width: 100%; border-collapse: collapse; text-align: left;">
                    <thead>
                        <tr style="background: var(--bg-surface); border-bottom: 1px solid var(--border);">
                            <th style="padding: 1.5rem;">Event Details</th>
                            <th style="padding: 1.5rem;">Status</th>
                            <th style="padding: 1.5rem;">Tickets Sold</th>
                            <th style="padding: 1.5rem;">Revenue</th>
                            <th style="padding: 1.5rem;">Actions</th>
                        </tr>
                    </thead>
                    <tbody style="color: var(--text-muted); font-size: 0.9rem;">
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 1.5rem;">
                                <div style="display: flex; gap: 1rem; align-items: center;">
                                    <div
                                        style="width: 50px; height: 50px; background: url('https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&q=80&w=100') center/cover; border-radius: 6px;">
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; color: white;">Midnight Jazz Festival</div>
                                        <div style="font-size: 0.75rem;">Oct 24, 2026</div>
                                    </div>
                                </div>
                            </td>
                            <td style="padding: 1.5rem;"><span style="color: #2ECC71;"><i
                                        class="fa fa-check-circle"></i> Approved</span></td>
                            <td style="padding: 1.5rem;">324 / 500</td>
                            <td style="padding: 1.5rem;">$14,580</td>
                            <td style="padding: 1.5rem;">
                                <div style="display: flex; gap: 0.8rem;">
                                    <a href="bookings" class="btn btn-outline"
                                        style="padding: 0.4rem 0.8rem; font-size: 0.75rem;"><i class="fa fa-users"></i>
                                        Bookings</a>
                                    <button class="btn btn-outline"
                                        style="padding: 0.4rem 0.8rem; font-size: 0.75rem;"><i
                                            class="fa fa-edit"></i></button>
                                </div>
                            </td>
                        </tr>
                        <tr style="border-bottom: 1px solid var(--border);">
                            <td style="padding: 1.5rem;">
                                <div style="display: flex; gap: 1rem; align-items: center;">
                                    <div
                                        style="width: 50px; height: 50px; background: url('https://images.unsplash.com/photo-1540575861501-7ad0582371f3?auto=format&fit=crop&q=80&w=100') center/cover; border-radius: 6px;">
                                    </div>
                                    <div>
                                        <div style="font-weight: 600; color: white;">Tech Summit 2026</div>
                                        <div style="font-size: 0.75rem;">Nov 12, 2026</div>
                                    </div>
                                </div>
                            </td>
                            <td style="padding: 1.5rem;"><span style="color: #E67E22;"><i class="fa fa-clock"></i>
                                    Pending Approval</span></td>
                            <td style="padding: 1.5rem;">0 / 1000</td>
                            <td style="padding: 1.5rem;">$0</td>
                            <td style="padding: 1.5rem;">
                                <div style="display: flex; gap: 0.8rem;">
                                    <button class="btn btn-outline" disabled style="opacity: 0.5;"><i
                                            class="fa fa-users"></i></button>
                                    <button class="btn btn-outline"
                                        style="padding: 0.4rem 0.8rem; font-size: 0.75rem;"><i
                                            class="fa fa-edit"></i></button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Mobile / Small Card View (Implicitly handled by table scroll or grid) -->
        </main>
    </div>

</body>

</html>



