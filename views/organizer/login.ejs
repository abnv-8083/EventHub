<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Organizer Portal Login' }) %>

<body style="height: 100vh; overflow: hidden; margin: 0; padding: 0; display: flex; font-family: 'Outfit', sans-serif;">
<!-- Left Side: Typography and Imagery -->
    <div class="d-none d-lg-flex flex-column justify-content-between" 
         style="width: 50%; background: linear-gradient(135deg, rgba(10, 10, 10, 0.9), rgba(52, 152, 219, 0.8)), url('https://images.unsplash.com/photo-1540575467063-178a50c2df87?auto=format&fit=crop&q=80&w=1600') center/cover; padding: 4rem; position: relative;">
        <!-- Logo -->
        <div>
            <a href="/" class="logo" style="font-size: 2rem; color: #ffffff;">EVENT<span>HUB</span></a>
            <span style="color: #3498DB; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; font-size: 0.8rem; display: block; margin-top: 0.5rem;">For Creators</span>
        </div>
        
        <!-- Typography -->
        <div style="margin-bottom: 4rem;">
            <h1 style="font-size: 4rem; font-weight: 700; line-height: 1.1; margin-bottom: 1.5rem; color: #ffffff; letter-spacing: -1.5px;">
                Manage the<br>Extraordinary.
            </h1>
            <p style="font-size: 1.25rem; color: rgba(255, 255, 255, 0.85); max-width: 450px; line-height: 1.6;">
                Access your world-class ticketing, marketing tools, and real-time event analytics from your dedicated Organizer Dashboard.
            </p>
        </div>
        
        <!-- Footer Info -->
        <div style="color: rgba(255, 255, 255, 0.6); font-size: 0.9rem;">
            &copy; 2026 EventHub Inc. All rights reserved.
        </div>
    </div>

    <!-- Right Side: Plain Form Page (Dark Theme) -->
    <div style="flex: 1; background: var(--bg-surface); display: flex; padding: 2rem; overflow-y: auto;">
        <div style="width: 100%; max-width: 440px; margin: auto; padding-top: 2rem; padding-bottom: 2rem;">
            
            <!-- Mobile Logo -->
            <div class="d-block d-lg-none" style="text-align: center; margin-bottom: 2.5rem;">
                <a href="/" class="logo" style="justify-content: center; font-size: 2.5rem; color: #ffffff;">EVENT<span>HUB</span></a>
                <span style="color: #3498DB; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; font-size: 0.8rem; display: block; margin-top: 0.5rem;">For Creators</span>
            </div>

            <div style="margin-bottom: 2.5rem;">
                <h2 style="font-size: 2rem; letter-spacing: -1px; margin-bottom: 0.5rem; color: #ffffff; font-weight: 700;">Organizer Login</h2>
                <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 0;">Enter your platform credentials to access your creator tools.</p>
            </div>

            <form class="needs-validation ajax-form" action="/organizer/login" method="POST">
                
                <div style="margin-bottom: 1.25rem;">
                    <label style="display: block; font-size: 0.9rem; margin-bottom: 0.5rem; color: var(--text-muted); font-weight: 500;">Email Address</label>
                    <input type="email" name="email" required placeholder="contact@organization.com"
                           style="width: 100%; padding: 0.9rem 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; color: #ffffff; font-size: 1rem; transition: all 0.2s; outline: none;"
                           onfocus="this.style.borderColor='#3498DB'; this.style.boxShadow='0 0 0 4px rgba(52, 152, 219, 0.1)';" 
                           onblur="this.style.borderColor='var(--border)'; this.style.boxShadow='none';">
                </div>

                <div style="margin-bottom: 2.5rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                        <label style="margin-bottom: 0; font-size: 0.9rem; color: var(--text-muted); font-weight: 500;">Password</label>
                    </div>
                    <input type="password" name="password" required placeholder="••••••••"
                           style="width: 100%; padding: 0.9rem 1rem; background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; color: #ffffff; font-size: 1rem; transition: all 0.2s; outline: none;"
                           onfocus="this.style.borderColor='#3498DB'; this.style.boxShadow='0 0 0 4px rgba(52, 152, 219, 0.1)';" 
                           onblur="this.style.borderColor='var(--border)'; this.style.boxShadow='none';">
                </div>

                <button type="submit" class="btn btn-primary"
                        style="width: 100%; padding: 1rem; border-radius: 12px; font-size: 1.05rem; font-weight: 600; background: #3498DB; border-color: #3498DB; box-shadow: 0 4px 14px rgba(52, 152, 219, 0.3);">
                    Access Portal
                </button>

            </form>

            <div style="text-align: center; margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border);">
                <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 0;">Don't have an Organizer account? 
                    <a href="/become-organizer" style="color: #3498DB; font-weight: 700; text-decoration: none;">Apply Now</a>
                </p>
                <div style="margin-top: 1rem;">
                    <a href="/user/login" style="color: var(--text-dim); font-size: 0.85rem; text-decoration: underline;">Return to Standard User Login</a>
                </div>
            </div>
            
            <!-- Mobile Footer -->
            <div class="d-block d-lg-none" style="text-align: center; margin-top: 2.5rem; color: var(--text-dim); font-size: 0.85rem;">
                &copy; 2026 EventHub Inc.
            </div>
        </div>
    </div>

    <%- include('../partials/footer-scripts') %>
</body>
</html>
