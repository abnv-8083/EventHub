<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Reset Admin Password' }) %>

<body class="bg-mesh"
    style="height: 100vh; display: flex; align-items: center; justify-content: center; overflow: hidden;">
<div class="floating-blob" style="top: 20%; right: 20%; opacity: 0.1;"></div>

    <div class="container" style="max-width: 450px; position: relative; z-index: 1;">
        <div class="card glass animate" style="padding: 3.5rem; text-align: center; border-radius: 24px;">
            <div
                style="width: 80px; height: 80px; background: rgba(230, 57, 70, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; border: 1px solid var(--border-red);">
                <i class="fa fa-lock text-gradient glow-text" style="font-size: 1.8rem;"></i>
            </div>
            <h2 style="font-size: 1.8rem; margin-bottom: 1rem; letter-spacing: -1px;">Set New Password</h2>
            <p style="color: var(--text-muted); font-size: 1rem; margin-bottom: 2.5rem;">Secure your admin account with a new password.</p>

            <form class="needs-validation ajax-form" action="/admin/reset-password" method="POST">
                <div class="form-group animate stagger-1" style="text-align: left;">
                    <label class="label">New Password</label>
                    <input type="password" name="password" class="input glass-dark" placeholder="••••••••" required minlength="6">
                </div>
                
                <div class="form-group animate stagger-2" style="text-align: left; margin-top: 1rem;">
                    <label class="label">Confirm New Password</label>
                    <input type="password" name="confirm_password" class="input glass-dark" placeholder="••••••••" required minlength="6">
                </div>

                <button type="submit" class="btn btn-primary glow-primary animate stagger-3"
                    style="width: 100%; padding: 1.2rem; margin-top: 2.5rem; border-radius: 12px; font-size: 1.1rem;">Reset Password</button>
            </form>
        </div>
    </div>

    <%- include('../partials/footer-scripts') %>
</body>

</html>
