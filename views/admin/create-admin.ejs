<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Create Admin | Admin Hub' }) %>

<body>

    <%- include('../partials/header-admin') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar-admin') %>

        <main class="dashboard-main animate">
            <div class="d-flex align-items-center gap-3 mb-5">
                <a href="users" class="btn btn-outline"
                    style="padding: 0.5rem; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                    <i class="fa fa-arrow-left"></i>
                </a>
                <div>
                    <h1 style="font-size: 1.8rem; margin-bottom: 0;">Add New <span class="text-gradient" style="color: #E63946;">Administrator</span></h1>
                    <p style="color: var(--text-muted); margin-bottom: 0; margin-top: 0.2rem;">Grant high-level system access to a new staff member.</p>
                </div>
            </div>

            <div class="card glass" style="padding: 3rem; max-width: 900px; margin: 0 auto; border-radius: 20px;">
                <form class="needs-validation" action="/admin/register" method="POST">
                    
                    <div style="display: grid; grid-template-columns: 200px 1fr; gap: 3rem;">
                        
                        <!-- Auto-generated Identity Icon -->
                        <div style="text-align: center;">
                            <div style="width: 150px; height: 150px; background: rgba(230, 57, 70, 0.05); border: 2px dashed rgba(230, 57, 70, 0.3); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 1rem;">
                                <i class="fa fa-user-shield" style="font-size: 3rem; color: #E63946; margin-bottom: 0.5rem;"></i>
                            </div>
                            <span style="font-size: 0.8rem; color: #E63946; font-weight: 500; padding: 0.3rem 0.8rem; background: rgba(230, 57, 70, 0.1); border-radius: 2rem;">Authorized Staff</span>
                        </div>

                        <!-- Form Details -->
                        <div>
                            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                                <div class="form-group mb-0">
                                    <label class="label" style="font-size: 0.85rem;">Authorized Name</label>
                                    <input type="text" name="name" class="input glass-dark" placeholder="e.g. Sarah Connor" required>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                                <div class="form-group mb-0">
                                    <label class="label" style="font-size: 0.85rem;">Internal Email Address</label>
                                    <input type="email" name="email" class="input glass-dark" placeholder="staff@eventhub.com" required>
                                </div>
                            </div>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 2rem;">
                                <div class="form-group mb-0">
                                    <label class="label" style="font-size: 0.85rem;">Access Key (Password)</label>
                                    <input type="password" name="password" class="input glass-dark" placeholder="••••••••" required>
                                </div>
                                <div class="form-group mb-0">
                                    <label class="label" style="font-size: 0.85rem;">Confirm Access Key</label>
                                    <input type="password" name="confirm_password" class="input glass-dark" placeholder="••••••••" required>
                                </div>
                            </div>

                            <div class="form-group" style="margin-bottom: 2rem;">
                                <label class="label" style="font-size: 0.85rem;">Administrator Notes (Optional)</label>
                                <textarea class="input glass-dark" name="notes" style="min-height: 80px; resize: vertical;"
                                    placeholder="Internal notes regarding this specific admin's jurisdiction..."></textarea>
                            </div>

                            <div style="display: flex; gap: 1rem; border-top: 1px solid var(--border); padding-top: 2rem;">
                                <button type="submit" class="btn btn-primary" style="padding: 1rem 3rem;">
                                    <i class="fa fa-shield-alt"></i> Grant Authority
                                </button>
                                <button type="reset" class="btn btn-outline" style="padding: 1rem 2rem;">
                                    Discard
                                </button>
                            </div>
                        </div>

                    </div>
                </form>
            </div>
        </main>
    </div>
    <%- include('partials/scripts') %>
</body>

</html>
