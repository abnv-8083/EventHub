<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'View Admin | Admin Hub' }) %>

<body>

    <%- include('../partials/header-admin') %>

    <div class="dashboard-layout">
        <%- include('../partials/sidebar-admin') %>

        <main class="dashboard-main animate">
            <div class="d-flex align-items-center gap-3 mb-5">
                <a href="/admin/admins" class="btn btn-outline"
                    style="padding: 0.5rem; border-radius: 50%; width: 40px; height: 40px; display: flex; align-items: center; justify-content: center;">
                    <i class="fa fa-arrow-left"></i>
                </a>
                <div>
                    <h1 style="font-size: 1.8rem; margin-bottom: 0;">Administrator <span class="text-gradient" style="color: #4facfe;">Profile</span></h1>
                    <p style="color: var(--text-muted); margin-bottom: 0; margin-top: 0.2rem;">Viewing details for <%= adminData.name %></p>
                </div>
            </div>

            <div class="card glass" style="padding: 3rem; max-width: 900px; margin: 0 auto; border-radius: 20px;">
                <div style="display: grid; grid-template-columns: 200px 1fr; gap: 3rem;">
                    
                    <!-- Auto-generated Identity Icon -->
                    <div style="text-align: center;">
                        <div style="width: 150px; height: 150px; background: rgba(79, 172, 254, 0.05); border: 2px dashed rgba(79, 172, 254, 0.3); border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; margin-bottom: 1rem;">
                            <i class="fa fa-user-shield" style="font-size: 3rem; color: #4facfe; margin-bottom: 0.5rem;"></i>
                        </div>
                        <span style="font-size: 0.8rem; color: #4facfe; font-weight: 500; padding: 0.3rem 0.8rem; background: rgba(79, 172, 254, 0.1); border-radius: 2rem;"><%= adminData.status || 'Active' %></span>
                    </div>

                    <!-- Read-only Details -->
                    <div>
                        <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                            <div class="form-group mb-0">
                                <label class="label" style="font-size: 0.85rem;">Authorized Name</label>
                                <div class="input glass-dark" style="color: white; opacity: 0.8; line-height: 1.5;"><%= adminData.name %></div>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 1.5rem;">
                            <div class="form-group mb-0">
                                <label class="label" style="font-size: 0.85rem;">Internal Email Address</label>
                                <div class="input glass-dark" style="color: white; opacity: 0.8; line-height: 1.5;"><%= adminData.email %></div>
                            </div>
                        </div>

                        <div style="display: grid; grid-template-columns: 1fr; gap: 1.5rem; margin-bottom: 2rem;">
                            <div class="form-group mb-0">
                                <label class="label" style="font-size: 0.85rem;">Joined Date</label>
                                <div class="input glass-dark" style="color: white; opacity: 0.8; line-height: 1.5;"><%= new Date(adminData.createdAt).toLocaleDateString() %></div>
                            </div>
                        </div>

                        <div class="form-group" style="margin-bottom: 2rem;">
                            <label class="label" style="font-size: 0.85rem;">Administrator Notes</label>
                            <div class="input glass-dark" style="min-height: 80px; color: white; opacity: 0.8; line-height: 1.5; white-space: pre-wrap;"><%= adminData.notes || 'No specific notes recorded.' %></div>
                        </div>

                        <div style="display: flex; gap: 1rem; border-top: 1px solid var(--border); padding-top: 2rem;">
                            <a href="/admin/admins/edit/<%= adminData._id %>" class="btn btn-primary" style="padding: 1rem 3rem;">
                                <i class="fa fa-edit"></i> Edit Admin
                            </a>
                        </div>
                    </div>

                </div>
            </div>
        </main>
    </div>
    <%- include('partials/scripts') %>
</body>
</html>
