<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Edit Password' }) %>

<body>

    <%- include('../partials/header') %>

    <div class="dashboard-layout">
        <!-- Sidebar -->
        <%- include('../partials/sidebar') %>
        <!-- Main Content -->
        <main class="dashboard-main animate">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 2.5rem;">
                <h1 style="font-size: 1.8rem; margin: 0;">Edit <span class="text-gradient">Password</span></h1>
                <a href="/profile" class="btn btn-outline"><i class="fa fa-arrow-left"></i> Back to Profile</a>
            </div>

            <div class="card" style="padding: 2.5rem; max-width: 600px;">
                <h3 style="margin-bottom: 2rem; font-size: 1.2rem; border-bottom: 1px solid var(--border); padding-bottom: 1rem;">
                    <% if(user.password){ %> Update Password <% } else { %> Create Password <% } %>
                </h3>
                
                <form id="editPasswordForm" action="/profile/edit/password" method="POST" class="ajax-form">
                    <input type="hidden" name="id" value="<%= user._id %>">
                    
                    <% if(user.password){ %>
                    <div class="form-group" style="margin-bottom: 2rem;">
                        <label class="label">Current Password</label>
                        <input type="password" name="currentPassword" class="input" placeholder="Enter your current password">
                    </div>
                    <% } %>

                    <div class="form-group" style="margin-bottom: 2rem;">
                        <label class="label">New Password</label>
                        <input type="password" name="newPassword" class="input" placeholder="Enter your new password" required autofocus>
                        <p style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.5rem;">Must contain an uppercase letter, lowercase letter, number, and a special character.</p>
                    </div>

                    <div class="form-group" style="margin-bottom: 2.5rem;">
                        <label class="label">Confirm New Password</label>
                        <input type="password" name="confirmPassword" class="input" placeholder="Confirm your new password" required>
                    </div>

                    <div style="border-top: 1px solid var(--border); padding-top: 2rem; display: flex; justify-content: flex-end; gap: 1rem;">
                        <a href="/profile" class="btn btn-outline" style="text-decoration: none;">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="fa fa-save"></i> <% if(user.password){ %> Save Password <% } else { %> Create Password <% } %></button>
                    </div>
                </form>
            </div>
        </main>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const editPasswordForm = document.getElementById('editPasswordForm');
            
            editPasswordForm.addEventListener('ajax:success', (e) => {
                setTimeout(() => {
                    window.location.href = '/profile';
                }, 1500);
            });
        });
    </script>
    <%- include('../partials/footer-scripts') %>

</body>

</html>
