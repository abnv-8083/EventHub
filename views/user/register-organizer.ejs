<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Register Organization' }) %>

<body>

    <%- include('../partials/header') %>

    <main style="padding: 6rem 0; min-height: 80vh; display: flex; align-items: center; justify-content: center;">
        <div class="container" style="max-width: 800px; width: 100%;">
            
            <div style="text-align: center; margin-bottom: 3rem;" class="animate">
                <div style="width: 80px; height: 80px; background: rgba(230, 57, 70, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
                    <i class="fa fa-briefcase" style="font-size: 2rem; color: var(--primary);"></i>
                </div>
                <h1 style="font-size: 2.5rem; margin-bottom: 0.5rem;">Create Your <span class="text-gradient">Organization</span></h1>
                <p style="color: var(--text-muted); font-size: 1.1rem;">Submit your corporate details to unlock creator tools.</p>
            </div>

            <!-- Registration Form -->
            <div class="card glass animate" style="padding: 3rem; border-radius: 24px;">
                <form action="/user/organizer/register" method="POST" class="needs-validation ajax-form">
                    
                    <div style="margin-bottom: 2rem;">
                        <div class="form-group mb-0">
                            <label class="label">Legal Entity Name</label>
                            <input type="text" name="organizationName" class="input glass-dark" placeholder="e.g. Acme Events LLC" required>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2.5rem;">
                        <div class="form-group mb-0">
                            <label class="label">Industry Category</label>
                            <select name="industryCategory" class="input glass-dark" required style="appearance: none;">
                                <option value="" disabled selected>Select Industry...</option>
                                <option value="Entertainment / Music">Entertainment / Music</option>
                                <option value="Technology / Software">Technology / Software</option>
                                <option value="Education / Workshops">Education / Workshops</option>
                                <option value="Business / Networking">Business / Networking</option>
                                <option value="Sports / Health">Sports / Health</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <div class="form-group mb-0">
                            <label class="label">Operating Region (City)</label>
                            <select name="operatingRegion" class="input glass-dark" required style="appearance: none;">
                                <option value="" disabled selected>Select City...</option>
                                <% sortedCity.forEach(city => { %>
                                    <option value="<%= city.name %>"><%= city.name %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>

                    <div style="background: rgba(230, 57, 70, 0.05); border-left: 4px solid var(--primary); padding: 1.5rem; border-radius: 0 12px 12px 0; margin-bottom: 3rem;">
                        <h4 style="font-size: 1rem; margin-bottom: 0.5rem; color: #fff;"><i class="fa fa-shield-alt" style="color: var(--primary); margin-right: 0.5rem;"></i> KYC Verification Process</h4>
                        <p style="color: var(--text-dim); font-size: 0.9rem; margin: 0; line-height: 1.6;">
                            By submitting this application, your profile will enter our manual review queue. The administration team will verify your business details to ensure platform integrity before granting active Organizer status.
                        </p>
                    </div>

                    <div style="text-align: center;">
                        <button type="submit" class="btn btn-primary btn-glow" style="padding: 1.2rem 4rem; font-size: 1.1rem; border-radius: 3rem; width: 100%;">
                            Submit Application for Review
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </main>

    <%- include('../partials/footer-scripts') %>
</body>
</html>
