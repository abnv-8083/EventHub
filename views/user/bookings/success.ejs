<!DOCTYPE html>
<html lang="en">

<%- include('../../partials/head', { title: 'Booking Success' }) %>

<body class="bg-mesh"
    style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 2rem;">

    <div class="floating-blob" style="top: 10%; left: 10%;"></div>
    <div class="floating-blob" style="bottom: 10%; right: 10%; background: #2ECC71; opacity: 0.05;"></div>

    <div class="success-card animate">
        <div class="success-checkmark">
            <div class="check-circle">
                <i class="fa fa-check"></i>
            </div>
        </div>

        <h1 style="font-size: 2.5rem; margin-bottom: 1rem;">Booking <span style="color: #2ECC71;">Confirmed!</span></h1>
        <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6;">Excellent! Your spot has been
            reserved. We've sent the booking confirmation and tickets to your registered email.</p>

        <div class="order-details">
            <div class="order-row">
                <span class="order-label">Booking ID</span>
                <span class="order-value" style="color: var(--primary);">#EH-992841</span>
            </div>
            <div class="order-row">
                <span class="order-label">Event</span>
                <span class="order-value">Midnight Jazz Festival</span>
            </div>
            <div class="order-row">
                <span class="order-label">Date & Time</span>
                <span class="order-value">Oct 24, 2026 â€¢ 08:00 PM</span>
            </div>
            <div class="order-row">
                <span class="order-label">Ticket Type</span>
                <span class="order-value">2 x General Admission</span>
            </div>
            <div class="order-row">
                <span class="order-label">Total Attendees</span>
                <span class="order-value">2 Persons</span>
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 3rem;">
            <a href="tickets" class="btn btn-primary" style="padding: 1.2rem;">
                <i class="fa fa-ticket-alt"></i> View My Tickets
            </a>
            <a href="/" class="btn btn-outline"
                style="padding: 1.2rem; border-color: var(--border); color: var(--text-main);">
                <i class="fa fa-home"></i> Back to Home
            </a>
        </div>

        <div
            style="margin-top: 2.5rem; padding-top: 2rem; border-top: 1px solid var(--border); display: flex; justify-content: center; gap: 2rem; font-size: 0.85rem;">
            <a href="#" style="color: var(--text-dim); transition: var(--transition);"><i class="fa fa-print"></i> Print
                Receipt</a>
            <a href="#" style="color: var(--text-dim); transition: var(--transition);"><i
                    class="fa fa-calendar-plus"></i> Add to Calendar</a>
            <a href="#" style="color: var(--text-dim); transition: var(--transition);"><i class="fa fa-share-alt"></i>
                Share Event</a>
        </div>
    </div>

</body>

</html>




