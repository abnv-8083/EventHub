<!DOCTYPE html>
<html lang="en">

<%- include('../../partials/head', { title: 'Add Attendees' }) %>

<body>

    <!-- Header -->
    <%- include('../../partials/header') %>

    <main class="section">
        <div class="container" style="max-width: 900px;">
            <div style="margin-bottom: 2.5rem; display: flex; align-items: center; gap: 1rem;">
                <a href="booking" style="color: var(--text-muted);"><i class="fa fa-arrow-left"></i> Back to
                    Selection</a>
                <h1 style="font-size: 1.8rem;">Attendee <span class="text-gradient">Information</span></h1>
            </div>

            <div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem; align-items: start;">
                <!-- Attendee Forms -->
                <div style="display: grid; gap: 1.5rem;">
                    <div class="card" style="padding: 2rem;">
                        <p style="color: var(--text-muted); margin-bottom: 2rem; font-size: 0.95rem;">
                            Please provide the names and contact details for each ticket holder. This information will
                            be used for entry verification.
                        </p>

                        <div id="attendee-inputs" style="display: grid; gap: 1.5rem;">
                            <!-- Person 1 -->
                            <div
                                style="padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-surface);">
                                <div
                                    style="font-weight: 600; font-size: 0.9rem; margin-bottom: 1.2rem; color: var(--primary); display: flex; align-items: center; gap: 0.5rem;">
                                    <i class="fa fa-user"></i> Attendee #1
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem;">
                                    <div style="display: grid; gap: 0.5rem;">
                                        <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-dim);">Full
                                            Name</label>
                                        <input type="text" class="input" placeholder="Enter attendee name">
                                    </div>
                                    <div style="display: grid; gap: 0.5rem;">
                                        <label
                                            style="font-size: 0.8rem; font-weight: 600; color: var(--text-dim);">Phone
                                            Number</label>
                                        <input type="tel" class="input" placeholder="+1 (555) 000-0000">
                                    </div>
                                </div>
                            </div>

                            <!-- Person 2 -->
                            <div
                                style="padding: 1.5rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-surface);">
                                <div
                                    style="font-weight: 600; font-size: 0.9rem; margin-bottom: 1.2rem; color: var(--primary); display: flex; align-items: center; gap: 0.5rem;">
                                    <i class="fa fa-user"></i> Attendee #2
                                </div>
                                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.2rem;">
                                    <div style="display: grid; gap: 0.5rem;">
                                        <label style="font-size: 0.8rem; font-weight: 600; color: var(--text-dim);">Full
                                            Name</label>
                                        <input type="text" class="input" placeholder="Enter attendee name">
                                    </div>
                                    <div style="display: grid; gap: 0.5rem;">
                                        <label
                                            style="font-size: 0.8rem; font-weight: 600; color: var(--text-dim);">Phone
                                            Number</label>
                                        <input type="tel" class="input" placeholder="+1 (555) 000-0000">
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div style="display: flex; justify-content: flex-end;">
                        <a href="payment" class="btn btn-primary"
                            style="padding: 1rem 3rem; font-size: 1rem;">Confirm & Continue <i class="fa fa-arrow-right"
                                style="margin-left: 0.5rem;"></i></a>
                    </div>
                </div>

                <!-- Summary Sidebar -->
                <div class="card shadow-lg"
                    style="padding: 2rem; position: sticky; top: 120px; border-top: 4px solid var(--primary);">
                    <h3 style="margin-bottom: 1.5rem;">Booking Summary</h3>

                    <div style="display: grid; gap: 1rem; margin-bottom: 1.5rem; font-size: 0.9rem;">
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: var(--text-muted);">Event:</span>
                            <span style="font-weight: 600;">Midnight Jazz Festival</span>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: var(--text-muted);">Tickets:</span>
                            <span style="font-weight: 600;">2 x General Admission</span>
                        </div>
                        <div style="display: flex; justify-content: space-between;">
                            <span style="color: var(--text-muted);">Total:</span>
                            <span style="font-weight: 700; color: var(--primary);">$83.50</span>
                        </div>
                    </div>

                    <div style="padding-top: 1.5rem; border-top: 1px solid var(--border);">
                        <p style="font-size: 0.8rem; color: var(--text-dim); line-height: 1.5;">
                            Note: Each attendee will receive a separate digital ticket with their unique QR code.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>

</body>

</html>




