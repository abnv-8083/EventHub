<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Discover & Book Amazing Events' }) %>

<body>
    <!-- Header / Nav -->
    <%- include('../partials/header', { activePage: 'home' }) %>

    <!-- Hero Section -->
    <main>
        <section class="section hero"
            style="padding-top: 4rem; text-align: center; background: radial-gradient(circle at center, rgba(230, 57, 70, 0.1) 0%, transparent 70%);">
            <div class="container animate">
                <h1 style="font-size: 4rem;" class="mb-3">Unforgettable <span class="text-gradient">Experiences</span>
                    Await</h1>
                <p style="color: var(--text-muted); font-size: 1.2rem; max-width: 600px; margin-inline: auto;"
                    class="mb-5">Discover
                    the best concerts, conferences, and festivals in your city. Book tickets effortlessly and join the
                    community.</p>

                <!-- Search Bar -->
                <div
                    style="max-width: 800px; margin: 0 auto; background: var(--bg-surface); padding: 0.5rem; border-radius: var(--radius-lg); border: 1px solid var(--border); display: flex; gap: 0.5rem;">
                    <input type="text" class="input" placeholder="Search events, artists, venues..."
                        style="border: none; background: transparent;">
                    <select class="input"
                        style="width: auto; border: none; background: transparent; color: var(--text-muted);">
                        <option>Location</option>
                        <option>New York</option>
                        <option>London</option>
                    </select>
                    <button class="btn btn-primary" style="padding: 0 2rem;"><i class="fa fa-search"></i>
                        Search</button>
                </div>
            </div>
        </section>

        <!-- Featured Events -->
        <section class="section">
            <div class="container">
                <div class="d-flex justify-between align-center mb-5">
                    <div>
                        <h2 style="font-size: 2rem;">Featured <span class="text-gradient">Events</span></h2>
                        <p style="color: var(--text-muted);">Handpicked experiences you don't want to miss.</p>
                    </div>
                    <a href="/events" style="color: var(--primary); font-weight: 600;">View All <i
                            class="fa fa-arrow-right"></i></a>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 2rem;">
                    <!-- Event Card 1 -->
                    <div class="card animate">
                        <div class="card-img"
                            style="background-image: url('https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&q=80&w=800');">
                            <span class="card-badge">LIVE</span>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Midnight Jazz Festival</h3>
                            <div class="card-meta">
                                <span><i class="fa fa-calendar-alt"></i> Oct 24, 2026</span>
                                <span><i class="fa fa-map-marker-alt"></i> New York, NY</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-weight: 700; font-size: 1.2rem; color: var(--primary);">$45.00</span>
                                <a href="/event-details" class="btn btn-outline"
                                    style="padding: 0.5rem 1rem;">View Details</a>
                            </div>
                        </div>
                    </div>

                    <!-- Event Card 2 -->
                    <div class="card animate" style="animation-delay: 0.2s;">
                        <div class="card-img"
                            style="background-image: url('https://images.unsplash.com/photo-1540575861501-7ad0582371f3?auto=format&fit=crop&q=80&w=800');">
                            <span class="card-badge" style="background: #2ECC71;">UPCOMING</span>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Tech Innovators Summit</h3>
                            <div class="card-meta">
                                <span><i class="fa fa-calendar-alt"></i> Nov 12, 2026</span>
                                <span><i class="fa fa-map-marker-alt"></i> SF, CA</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-weight: 700; font-size: 1.2rem; color: var(--primary);">$120.00</span>
                                <a href="/event-details" class="btn btn-outline"
                                    style="padding: 0.5rem 1rem;">View Details</a>
                            </div>
                        </div>
                    </div>

                    <!-- Event Card 3 -->
                    <div class="card animate" style="animation-delay: 0.4s;">
                        <div class="card-img"
                            style="background-image: url('https://images.unsplash.com/photo-1514525253361-bee8718a74a2?auto=format&fit=crop&q=80&w=800');">
                            <span class="card-badge">LIVE</span>
                        </div>
                        <div class="card-content">
                            <h3 class="card-title">Glow-in-the-Dark EDM</h3>
                            <div class="card-meta">
                                <span><i class="fa fa-calendar-alt"></i> Oct 31, 2026</span>
                                <span><i class="fa fa-map-marker-alt"></i> Miami, FL</span>
                            </div>
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <span style="font-weight: 700; font-size: 1.2rem; color: var(--primary);">$60.00</span>
                                <a href="/event-details" class="btn btn-outline"
                                    style="padding: 0.5rem 1rem;">View Details</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- Become Organizer CTA -->
        <section class="section" style="background: var(--bg-surface);">
            <div class="container"
                style="display: flex; align-items: center; justify-content: space-between; gap: 4rem;">
                <div style="flex: 1;">
                    <h2 style="font-size: 2.5rem;" class="mb-4">Make Your <span class="text-gradient">Event</span>
                        Happen</h2>
                    <p style="color: var(--text-muted); font-size: 1.1rem;" class="mb-5">Powerful tools for
                        creators to manage tickets, analyze sales, and grow their community. Join thousands of
                        successful organizers.</p>
                    <div class="d-flex gap-3">
                        <a href="/register-organizer" class="btn btn-primary">Start Organizing</a>
                        <a href="learn-more" class="btn btn-outline">Learn More</a>
                    </div>
                </div>
                <div
                    style="flex: 1; height: 400px; background: url('https://images.unsplash.com/photo-1511578314322-379afb476865?auto=format&fit=crop&q=80&w=800') center/cover; border-radius: var(--radius-lg);">
                </div>
            </div>
        </section>
    </main>

    <!-- Footer -->
    <footer>
        <div class="container">
            <div class="footer-grid">
                <div>
                    <a href="/" class="logo" style="margin-bottom: 1.5rem;">EVENT<span>HUB</span></a>
                    <p style="color: var(--text-muted); font-size: 0.9rem;">The leading platform for managing and
                        discovering world-class events. Redefining how we gather.</p>
                </div>
                <div>
                    <h4 style="margin-bottom: 1.5rem;">Quick Links</h4>
                    <ul style="color: var(--text-muted); display: grid; gap: 0.8rem;">
                        <li><a href="/events">Browse Events</a></li>
                        <li><a href="/about">Our Story</a></li>
                        <li><a href="/pricing">Pricing</a></li>
                        <li><a href="/contact">Contact Us</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="margin-bottom: 1.5rem;">Legal</h4>
                    <ul style="color: var(--text-muted); display: grid; gap: 0.8rem;">
                        <li><a href="terms">Terms of Service</a></li>
                        <li><a href="privacy">Privacy Policy</a></li>
                        <li><a href="refund">Refund Policy</a></li>
                    </ul>
                </div>
                <div>
                    <h4 style="margin-bottom: 1.5rem;">Newsletter</h4>
                    <div style="display: flex; gap: 0.5rem;">
                        <input type="email" class="input" placeholder="Your email" style="padding: 0.6rem;">
                        <button class="btn btn-primary" style="padding: 0 1rem;">Join</button>
                    </div>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 EventHub Inc. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <%- include('../partials/footer-scripts') %>
</body>

</html>
