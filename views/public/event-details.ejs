<!DOCTYPE html>
<html lang="en">

<%- include('../partials/head', { title: 'Midnight Jazz Festival' }) %>

<body>

    <!-- Header -->
    <%- include('../partials/header', { activePage: '' }) %>

    <main>
        <!-- Hero Banner -->
        <section
            style="height: 50vh; background: linear-gradient(to bottom, rgba(0,0,0,0.3), var(--bg-dark)), url('https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&q=80&w=1200') center/cover; display: flex; align-items: flex-end; padding-bottom: 3rem;">
            <div class="container">
                <span class="card-badge mb-2" style="position: static; display: inline-block;">LIVE</span>
                <h1 style="font-size: 3.5rem;" class="mb-2">Midnight Jazz Festival</h1>
                <div class="card-meta" style="font-size: 1.1rem;">
                    <span><i class="fa fa-calendar-alt text-gradient"></i> Oct 24, 2026</span>
                    <span><i class="fa fa-clock text-gradient"></i> 08:00 PM - 02:00 AM</span>
                    <span><i class="fa fa-map-marker-alt text-gradient"></i> Blue Note Jazz Club, NY</span>
                </div>
            </div>
        </section>

        <section class="section">
            <div class="container" style="display: grid; grid-template-columns: 2fr 1fr; gap: 4rem;">
                <!-- Main Content -->
                <div class="animate">
                    <h2 class="mb-3" style="border-left: 4px solid var(--primary); padding-left: 1rem;">About
                        the <span class="text-gradient">Event</span></h2>
                    <p style="color: var(--text-muted);" class="mb-4">Experience an enchanting evening of
                        soulful melodies and rhythmic beats at the Midnight Jazz Festival. This year featuring
                        world-renowned artists and emerging talents in an intimate setting that captures the true
                        essence of jazz.</p>

                    <h3 style="margin-bottom: 1rem;">What to Expect</h3>
                    <ul style="color: var(--text-muted); margin-bottom: 2rem; display: grid; gap: 0.5rem;">
                        <li><i class="fa fa-check text-gradient"></i> 5 Hours of Live Performances</li>
                        <li><i class="fa fa-check text-gradient"></i> Complimentary Hors d'oeuvres</li>
                        <li><i class="fa fa-check text-gradient"></i> Exclusive Artist Q&A Session</li>
                        <li><i class="fa fa-check text-gradient"></i> Professional Photo Booth</li>
                    </ul>

                    <h3 style="margin-bottom: 1rem;">Venue Location</h3>
                    <div
                        style="height: 300px; background: var(--bg-surface); border-radius: var(--radius-md); border: 1px solid var(--border); display: flex; align-items: center; justify-content: center;">
                        <span style="color: var(--text-dim);">[Map Integration Placeholder]</span>
                    </div>
                </div>

                <!-- Sidebar / Booking CTA -->
                <div class="animate" style="animation-delay: 0.2s;">
                    <div class="card" style="padding: 2rem; position: sticky; top: 120px;">
                        <h3 style="margin-bottom: 1.5rem;">Ticket Information</h3>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem;">
                            <span style="color: var(--text-muted);">Starting Price</span>
                            <span style="font-weight: 700; color: var(--primary); font-size: 1.5rem;">$45.00</span>
                        </div>
                        <div style="margin-bottom: 2rem; font-size: 0.9rem; color: var(--text-dim);">
                            <i class="fa fa-info-circle"></i> 124 seats remaining
                        </div>

                        <div style="display: grid; gap: 1rem;">
                            <a href="../user/booking" class="btn btn-primary" style="width: 100%;">Book
                                Ticket Now</a>
                            <button class="btn btn-outline" style="width: 100%;"><i class="fa fa-heart"></i> Add to
                                Wishlist</button>
                        </div>

                        <hr style="margin: 2rem 0; border: 0; border-top: 1px solid var(--border);">

                        <h4 style="margin-bottom: 1rem;">Organizer</h4>
                        <div style="display: flex; align-items: center; gap: 1rem;">
                            <div
                                style="width: 50px; height: 50px; background: var(--bg-surface); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--primary); border: 1px solid var(--border);">
                                <i class="fa fa-users"></i>
                            </div>
                            <div>
                                <div style="font-weight: 600;">Jazz Society NY</div>
                                <a href="../organizer/profile"
                                    style="font-size: 0.8rem; color: var(--primary);">View
                                    Profile</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Comments Section -->
            <div class="container animate" style="margin-top: 6rem;">
                <h2 style="margin-bottom: 2.5rem; text-align: center;">Attendee <span
                        class="text-gradient">Reviews</span></h2>

                <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 4rem;">
                    <!-- Comment Form -->
                    <div class="card glass" style="padding: 2.5rem; height: fit-content;">
                        <h3 style="margin-bottom: 1.5rem;">Leave a Review</h3>
                        <form action="#">
                            <div class="form-group">
                                <label class="label">Your Rating</label>
                                <div
                                    style="display: flex; gap: 0.5rem; color: #f1c40f; font-size: 1.25rem; margin-bottom: 1rem;">
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa fa-star"></i>
                                    <i class="fa-regular fa-star"></i>
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="label">Your Comment</label>
                                <textarea class="input glass-dark" style="min-height: 120px; resize: none;"
                                    placeholder="Share your experience..."></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary glow-primary"
                                style="width: 100%; margin-top: 1rem;">Post Review</button>
                        </form>
                    </div>

                    <!-- Comments List -->
                    <div style="display: grid; gap: 1.5rem;">
                        <!-- Comment 1 -->
                        <div class="card glass animate stagger-1" style="padding: 2rem;">
                            <div
                                style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                                <div style="display: flex; gap: 1rem; align-items: center;">
                                    <div
                                        style="width: 45px; height: 45px; background: #333; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-user" style="color: var(--primary);"></i>
                                    </div>
                                    <div>
                                        <div style="font-weight: 600;">Michael Chen</div>
                                        <div style="font-size: 0.8rem; color: var(--text-dim);">Verified Attendee • 2
                                            days ago</div>
                                    </div>
                                </div>
                                <div style="color: #f1c40f; font-size: 0.9rem;">
                                    <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i
                                        class="fa fa-star"></i><i class="fa fa-star"></i>
                                </div>
                            </div>
                            <p style="color: var(--text-muted); line-height: 1.6;">An incredible experience! The
                                acoustics at the club were perfect for jazz, and the lineup was world-class. Highly
                                recommend for any jazz enthusiasts.</p>
                        </div>

                        <!-- Comment 2 -->
                        <div class="card glass animate stagger-2" style="padding: 2rem;">
                            <div
                                style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                                <div style="display: flex; gap: 1rem; align-items: center;">
                                    <div
                                        style="width: 45px; height: 45px; background: #333; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                        <i class="fa fa-user" style="color: var(--primary);"></i>
                                    </div>
                                    <div>
                                        <div style="font-weight: 600;">Sarah Jenkins</div>
                                        <div style="font-size: 0.8rem; color: var(--text-dim);">Attendee • 1 week ago
                                        </div>
                                    </div>
                                </div>
                                <div style="color: #f1c40f; font-size: 0.9rem;">
                                    <i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i
                                        class="fa fa-star"></i><i class="fa-regular fa-star"></i>
                                </div>
                            </div>
                            <p style="color: var(--text-muted); line-height: 1.6;">Great atmosphere and the hors
                                d'oeuvres were delicious. Only wish it started slightly earlier, but otherwise a
                                fantastic night out.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- Footer same as index -->
    <%- include('../partials/footer-scripts') %>
</body>

</html>